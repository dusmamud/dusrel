---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import { dict, type Lang } from '../i18n';

const lang: Lang = 'en';
const t = dict[lang];
const p = t.termsPage;
---

<Base lang="en" title="Terms of Service — Dusrel" description="Dusrel terms of service in plain language: fair use, your content rights, and our promises." canonical="https://dusrel.com/terms">
  <SiteNav lang="en" altHref="/hi/terms" />
  <main>
    <section class="py-16 md:py-24">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-[#4d90fe]">{p.eyebrow}</p>
        <h1 class="font-display mt-3 text-4xl font-bold tracking-tight text-slate-900 md:text-5xl dark:text-[#e8eaed]">{p.title}</h1>
        <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">{p.updated}</p>
        <p class="mx-auto mt-6 max-w-2xl text-slate-600 dark:text-slate-400">{p.intro}</p>
      </div>
    </section>

    <section class="pb-20 md:pb-24">
      <div class="mx-auto max-w-3xl space-y-10 px-6">
        {p.sections.map((s) => (
          <div>
            <h2 class="font-display text-2xl font-bold text-slate-900 dark:text-[#e8eaed]">{s.title}</h2>
            <div class="mt-3 space-y-3 text-slate-600 dark:text-slate-400">
              {s.body.split('\n\n').map((para) => <p>{para}</p>)}
            </div>
          </div>
        ))}
        <div class="flex flex-wrap gap-4 pt-4">
          <a href="mailto:hello@dusrel.com" class="rounded-full bg-[#4d90fe] px-6 py-2.5 font-semibold text-white hover:opacity-90">{p.contactCta} hello@dusrel.com</a>
          <a href="/" class="rounded-full border border-slate-300 px-6 py-2.5 font-semibold text-slate-700 hover:border-[#4d90fe] hover:text-[#4d90fe] dark:border-white/20 dark:text-slate-300">{p.backHome}</a>
        </div>
      </div>
    </section>

  </main>
  <Footer lang="en" />
</Base>
