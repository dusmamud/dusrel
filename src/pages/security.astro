---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import { dict, type Lang } from '../i18n';

const lang: Lang = 'en';
const t = dict[lang];
const s = t.securityPage;
---

<Base
  lang="en"
  title="Security — Dusrel"
  description="How Dusrel keeps you secure: client-side processing, no accounts to hack, HTTPS everywhere, minimal data."
  canonical="https://dusrel.com/security"
  image="/og-security.png"
>
  <SiteNav lang="en" altHref="/hi/security" />
  <main>
    <section class="py-16 md:py-24">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-[#4d90fe]">{s.eyebrow}</p>
        <h1 class="font-display mt-3 text-4xl font-bold tracking-tight text-slate-900 md:text-5xl dark:text-[#e8eaed]">{s.title}</h1>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-400">{s.sub}</p>
      </div>
    </section>

    <section class="pb-16 md:pb-20">
      <div class="mx-auto max-w-6xl px-6">
        <div class="grid gap-6 md:grid-cols-2">
          {s.sections.map((sec, i) => (
            <div class={i === 0 ? "rounded-2xl border border-slate-200 bg-white p-6 md:col-span-2 dark:border-white/10 dark:bg-[#1e1e1e]" : "rounded-2xl border border-slate-200 bg-white p-6 dark:border-white/10 dark:bg-[#1e1e1e]"}>
              <h2 class="font-display text-xl font-bold text-slate-900 dark:text-[#e8eaed]">{sec.title}</h2>
              <div class="mt-2 space-y-2 text-sm text-slate-600 dark:text-slate-400">
                {sec.body.split('\n\n').map((para) => <p>{para}</p>)}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="pb-20 md:pb-24">
      <div class="mx-auto max-w-3xl px-6">
        <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center dark:border-white/10 dark:bg-[#1e1e1e]">
          <h2 class="font-display text-2xl font-bold text-slate-900 dark:text-[#e8eaed]">{s.reportTitle}</h2>
          <p class="mx-auto mt-3 max-w-xl text-slate-600 dark:text-slate-400">{s.reportBody}</p>
          <a href="mailto:hello@dusrel.com?subject=Security%20report" class="mt-6 inline-block rounded-full bg-[#4d90fe] px-8 py-3 font-semibold text-white hover:opacity-90">{s.reportButton}</a>
        </div>
      </div>
    </section>
  </main>
  <Footer lang="en" />
</Base>
