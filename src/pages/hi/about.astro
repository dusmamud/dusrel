---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import Footer from '../../components/Footer.astro';
import { dict, type Lang } from '../../i18n';

const lang: Lang = 'hi';
const t = dict[lang];
---

<Base
  lang="hi"
  title="हमारे बारे में — Dusrel"
  description="दुसरेल एक स्वतंत्र डेवलपर है जो मुफ्त, प्राइवेसी-फर्स्ट ऐप्स बनाता है। आपका डेटा आपका ही रहता है।"
  canonical="https://dusrel.com/hi/about"
>

  <SiteNav lang="hi" altHref="/about" />
  <main>
    <section class="py-16 md:py-24">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-[#4d90fe]">{t.about.eyebrow}</p>
        <h1 class="font-display mt-3 text-4xl font-bold tracking-tight text-slate-900 md:text-5xl dark:text-[#e8eaed]">{t.about.title}</h1>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-400">{t.about.sub}</p>
      </div>
    </section>

    <section class="pb-16 md:pb-20">
      <div class="mx-auto max-w-3xl px-6">
        <h2 class="font-display text-3xl font-bold text-slate-900 dark:text-[#e8eaed]">{t.about.storyTitle}</h2>
        <div class="mt-6 space-y-4 text-slate-600 dark:text-slate-400">
          {t.about.storyBody.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>
    <section class="pb-16 md:pb-20">
      <div class="mx-auto max-w-6xl px-6">
        <h2 class="font-display text-center text-3xl font-bold text-slate-900 dark:text-[#e8eaed]">{t.about.valuesTitle}</h2>
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {t.about.values.map((v) => (
            <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-white/10 dark:bg-[#1e1e1e]">
              <h3 class="font-display text-lg font-bold text-slate-900 dark:text-[#e8eaed]">{v.title}</h3>
              <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{v.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="pb-20 md:pb-24">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <h2 class="font-display text-3xl font-bold text-slate-900 dark:text-[#e8eaed]">{t.about.ctaTitle}</h2>
        <p class="mt-3 text-slate-600 dark:text-slate-400">{t.about.ctaSub}</p>
        <a href="/hi/#apps" class="mt-6 inline-block rounded-full bg-[#4d90fe] px-8 py-3 font-semibold text-white hover:opacity-90">{t.about.ctaButton}</a>
      </div>
    </section>

  </main>
  <Footer lang="hi" />

</Base>
