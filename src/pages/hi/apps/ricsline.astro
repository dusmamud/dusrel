---
import Base from '../../../layouts/Base.astro';
import SiteNav from '../../../components/SiteNav.astro';
import Footer from '../../../components/Footer.astro';
import { dict, type Lang } from '../../../i18n';
import { liveApps, appIcon, appDetailHref, appContentFor } from '../../../data/apps';

const lang: Lang = 'hi';
const t = dict[lang];
const p = t.appPages.ricsline;
const appUrl = 'https://dusmamud.github.io/ricsline/';

const content = (slug: string) => appContentFor(t.appContent, slug);
const others = liveApps
  .filter((a) => a.slug !== 'ricsline')
  .map((a) => ({ slug: a.slug, name: content(a.slug).name, desc: content(a.slug).desc ?? '' }));

const check = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>`;

const featureIcons = [
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><path d="M4 21V8l8-5 8 5v13"/><path d="M9 21v-6h6v6"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><path d="M12 3v12"/><path d="M7 10l5 5 5-5"/><path d="M4 21h16"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z"/></svg>`,
];
---

<Base
  lang={lang}
  title="Ricsline — LRC लिरिक्स फाइलें बनाएं | Dusrel"
  description="Ricsline एक मुफ्त LRC लिरिक्स मेकर है। टैप-टू-सिंक टाइमिंग, बिल्ट-इन लिरिक्स लाइब्रेरी और एक क्लिक में .lrc एक्सपोर्ट — सीधे आपके ब्राउज़र में।"
  canonical="https://dusrel.com/hi/apps/ricsline"
>
  <SiteNav lang={lang} altHref="/apps/ricsline" />
  <main>
    <!-- Hero -->
    <section class="py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid items-center gap-10 md:grid-cols-2 md:gap-14">
          <div>
            <div class="flex items-center gap-4">
              <img
                src="/icons/ricsline.svg"
                alt="Ricsline logo"
                class="w-16 h-16 rounded-2xl"
                width="64"
                height="64"
              />
              <span class="inline-block rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-700 dark:bg-green-900/40 dark:text-green-300">
                {t.ecosystem.liveLabel}
              </span>
            </div>
            <h1 class="font-display mt-6 text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-[#e8eaed]">
              {p.name}
            </h1>
            <p class="mt-2 text-xl text-[#4d90fe] font-medium">{p.tagline}</p>
            <p class="mt-4 text-lg text-slate-600 dark:text-slate-400 leading-relaxed">{p.heroSub}</p>
            <ul class="mt-6 space-y-2.5">
              {
                p.bullets.map((b) => (
                  <li class="flex items-start gap-2.5 text-sm text-slate-700 dark:text-slate-300">
                    <span class="mt-0.5 text-[#4d90fe]" set:html={check} />
                    {b}
                  </li>
                ))
              }
            </ul>
            <a
              href={appUrl}
              target="_blank"
              rel="noopener"
              class="mt-8 inline-block rounded-2xl bg-[#4d90fe] px-8 py-3.5 text-base font-semibold text-white shadow-sm transition-colors hover:bg-[#3b7de0]"
            >
              {p.openApp} &rarr;
            </a>
          </div>
          <div>
            <img
              src="/images/showcase-ricsline.jpg"
              alt={p.name}
              class="w-full rounded-3xl border border-slate-200 object-cover shadow-sm aspect-[4/3] dark:border-white/10"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="py-16 md:py-20">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="font-display text-3xl md:text-4xl font-bold text-center text-slate-900 dark:text-[#e8eaed]">
          {p.featuresTitle}
        </h2>
        <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            p.features.map((f, i) => (
              <div class="rounded-2xl border border-slate-200 dark:border-white/10 bg-white dark:bg-[#1e1e1e] p-6">
                <div class="w-11 h-11 rounded-xl bg-[#4d90fe]/10 text-[#4d90fe] flex items-center justify-center">
                  <span set:html={featureIcons[i % featureIcons.length]} />
                </div>
                <h3 class="mt-4 font-semibold text-slate-900 dark:text-[#e8eaed]">{f.title}</h3>
                <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{f.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Privacy strip -->
    <section class="py-16 md:py-20">
      <div class="max-w-4xl mx-auto px-6">
        <div class="rounded-3xl border border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-[#1e1e1e] px-8 py-12 text-center">
          <h2 class="font-display text-2xl md:text-3xl font-bold text-slate-900 dark:text-[#e8eaed]">
            {p.privacyTitle}
          </h2>
          <p class="mt-4 text-slate-600 dark:text-slate-400 leading-relaxed max-w-2xl mx-auto">
            {p.privacyBody}
          </p>
        </div>
      </div>
    </section>

    <!-- More from Dusrel -->
    <section class="py-16 md:py-20">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="font-display text-3xl md:text-4xl font-bold text-center text-slate-900 dark:text-[#e8eaed]">
          {p.moreTitle}
        </h2>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {
            others.map((o) => (
              <a
                href={appDetailHref(o.slug, lang)}
                class="group rounded-2xl border border-slate-200 dark:border-white/10 bg-white dark:bg-[#1e1e1e] p-6 transition-colors hover:border-[#4d90fe]/60"
              >
                <h3 class="font-semibold text-slate-900 dark:text-[#e8eaed] group-hover:text-[#4d90fe]">
                  {o.name}
                </h3>
                <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{o.desc}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="mx-auto max-w-6xl px-6 pb-20 md:pb-24">
      <div class="rounded-[2rem] bg-[#4d90fe] px-8 py-14 md:py-16 text-center">
        <h2 class="font-display text-3xl md:text-4xl font-bold text-white">{p.ctaTitle}</h2>
        <p class="mt-4 text-white/85 max-w-xl mx-auto">{p.ctaSub}</p>
        <a
          href={appUrl}
          target="_blank"
          rel="noopener"
          class="mt-8 inline-block rounded-2xl bg-white px-8 py-3.5 text-base font-semibold text-[#4d90fe] transition-colors hover:bg-slate-100"
        >
          {p.ctaButton} &rarr;
        </a>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Base>
