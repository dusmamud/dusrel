---
import Base from '../../../layouts/Base.astro';
import SiteNav from '../../../components/SiteNav.astro';
import Footer from '../../../components/Footer.astro';
import { dict, type Lang } from '../../../i18n';

const lang: Lang = 'hi';
const t = dict[lang].appPages.quill;
const lp = (enPath: string) => (lang === 'en' ? enPath : `/hi${enPath}`);
const home = '/hi/';
const appUrl = 'https://imagequill.dusrel.com';

const otherApps = [
  { name: dict[lang].ecosystem.apps[1].name, desc: dict[lang].ecosystem.apps[1].desc, href: lp('/apps/ricsline'), icon: '/icons/ricsline.svg' },
  { name: dict[lang].ecosystem.apps[2].name, desc: dict[lang].ecosystem.apps[2].desc, href: lp('/apps/resumeforge'), icon: '/icons/resumeforge.svg' },
  { name: dict[lang].ecosystem.apps[3].name, desc: dict[lang].ecosystem.apps[3].desc, href: lp('/apps/pdf-tools'), icon: '/icons/pdf-tools.svg' },
];

const check = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>`;

const featureIcons = [
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><path d="M16 5a3.5 3.5 0 0 1 0 6.8"/><path d="M17.5 14.5c2.3.7 4 2.7 4 5.5"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><path d="M20.6 13.4L11 3.8A2 2 0 0 0 9.6 3.2H4a1 1 0 0 0-1 1v5.6c0 .5.2 1 .6 1.4l9.6 9.6a2 2 0 0 0 2.8 0l4.6-4.6a2 2 0 0 0 0-2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18z"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><path d="M5 12.5a10 10 0 0 1 14 0"/><path d="M8.5 16a5 5 0 0 1 7 0"/><circle cx="12" cy="19.5" r="1" fill="currentColor"/><path d="M3 3l18 18"/></svg>`,
];
---

<Base
  lang="hi"
  title="Image Quill — मुफ्त ऑनलाइन इमेज टूल्स | Dusrel"
  description="Dusrel का Image Quill — मुफ्त ऑनलाइन इमेज टूल्स: कंप्रेस, रीसाइज़, क्रॉप, कन्वर्ट (HEIC सहित), रोटेट, वॉटरमार्क, मीम जनरेटर और फोटो एडिटर। 100% क्लाइंट-साइड — आपकी तस्वीरें डिवाइस से बाहर नहीं जातीं।"
  canonical="https://dusrel.com/hi/apps/image-quill"
>
  <SiteNav lang="hi" altHref="/apps/image-quill" />

  <main>
    {/* Hero */}
    <section class="py-16 md:py-24">
      <div class="max-w-6xl mx-auto px-6">
        <div class="flex flex-col items-center text-center">
          <img
            src="/icons/image-quill.svg"
            alt=""
            class="w-20 h-20 md:w-24 md:h-24"
            width="96"
            height="96"
            aria-hidden="true"
          />
          <h1 class="font-display mt-6 text-4xl md:text-5xl font-bold text-slate-900 dark:text-[#e8eaed]">
            {t.name}
          </h1>
          <p class="mt-3 text-xl md:text-2xl font-medium text-[#4d90fe]">{t.tagline}</p>
          <p class="mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-400">{t.heroSub}</p>

          <ul class="mt-6 flex flex-col sm:flex-row flex-wrap items-center justify-center gap-x-8 gap-y-2.5">
            {t.bullets.map((b) => (
              <li class="flex items-center gap-2.5 text-sm text-slate-700 dark:text-slate-300">
                <span class="text-[#4d90fe]" set:html={check} />
                {b}
              </li>
            ))}
          </ul>

          <div class="mt-8 flex flex-col sm:flex-row items-center gap-3">
            <a
              href={appUrl}
              target="_blank"
              rel="noopener"
              class="rounded-2xl bg-[#4d90fe] px-8 py-3.5 text-base font-semibold text-white transition-colors hover:bg-[#3b7de0]"
            >
              {t.openApp} &rarr;
            </a>
            <a
              href={home}
              class="rounded-2xl border border-slate-300 px-8 py-3.5 text-base font-semibold text-slate-900 transition-colors hover:border-[#4d90fe] hover:text-[#4d90fe] dark:border-white/20 dark:text-[#e8eaed]"
            >
              Dusrel
            </a>
          </div>
        </div>

        <div class="mt-14 md:mt-16">
          <img
            src="/images/showcase-image-quill.jpg"
            alt={t.name}
            loading="lazy"
            class="w-full rounded-3xl border border-slate-200 object-cover shadow-sm dark:border-white/10"
          />
        </div>
      </div>
    </section>

    {/* Features grid */}
    <section class="py-16 md:py-24 bg-slate-50 dark:bg-black/30">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="font-display text-3xl md:text-4xl font-bold text-center text-slate-900 dark:text-[#e8eaed]">
          {t.featuresTitle}
        </h2>
        <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {t.features.map((f, i) => (
            <div class="rounded-2xl border border-slate-200 dark:border-white/10 bg-white dark:bg-[#1e1e1e] p-6">
              <div class="w-11 h-11 rounded-xl bg-[#4d90fe]/10 text-[#4d90fe] flex items-center justify-center">
                <span set:html={featureIcons[i % featureIcons.length]} />
              </div>
              <h3 class="mt-4 font-semibold text-slate-900 dark:text-[#e8eaed]">{f.title}</h3>
              <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Privacy strip */}
    <section class="py-16 md:py-24">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-10 h-10 mx-auto text-[#4d90fe]" aria-hidden="true">
          <path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/>
        </svg>
        <h2 class="font-display mt-4 text-3xl md:text-4xl font-bold text-slate-900 dark:text-[#e8eaed]">
          {t.privacyTitle}
        </h2>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-400 leading-relaxed">{t.privacyBody}</p>
      </div>
    </section>

    {/* More from Dusrel */}
    <section class="py-16 md:py-24 bg-slate-50 dark:bg-black/30">
      <div class="max-w-6xl mx-auto px-6">
        <h2 class="font-display text-3xl md:text-4xl font-bold text-center text-slate-900 dark:text-[#e8eaed]">
          {t.moreTitle}
        </h2>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {otherApps.map((app) => (
            <a
              href={app.href}
              class="rounded-2xl border border-slate-200 dark:border-white/10 bg-white dark:bg-[#1e1e1e] p-6 transition-colors hover:border-[#4d90fe]/60"
            >
              <img src={app.icon} alt="" class="w-12 h-12" width="48" height="48" aria-hidden="true" />
              <h3 class="mt-4 font-semibold text-slate-900 dark:text-[#e8eaed]">{app.name}</h3>
              <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{app.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* Final CTA */}
    <section class="py-16 md:py-24">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <h2 class="font-display text-3xl md:text-4xl font-bold text-slate-900 dark:text-[#e8eaed]">
          {t.ctaTitle}
        </h2>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-400">{t.ctaSub}</p>
        <a
          href={appUrl}
          target="_blank"
          rel="noopener"
          class="mt-8 inline-block rounded-2xl bg-[#4d90fe] px-8 py-3.5 text-base font-semibold text-white transition-colors hover:bg-[#3b7de0]"
        >
          {t.ctaButton} &rarr;
        </a>
      </div>
    </section>
  </main>

  <Footer lang="hi" />
</Base>
