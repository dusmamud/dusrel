---
import Base from '../../../layouts/Base.astro';
import SiteNav from '../../../components/SiteNav.astro';
import Footer from '../../../components/Footer.astro';
import { dict, type Lang } from '../../../i18n';

const lang: Lang = 'hi';
const t = dict[lang];
const app = t.appPages.resumeforge;
const lp = (enPath: string) => `/hi${enPath}`;

const appUrl =
  t.ecosystem.apps.find((a) => a.name === app.name)?.url ??
  'https://dusmamud.github.io/resumeforge/';

const iconFor: Record<string, string> = {
  'Image Quill': '/icons/image-quill.svg',
  'Ricsline': '/icons/ricsline.svg',
  'PDF Tools': '/icons/pdf-tools.svg',
};
const others = t.ecosystem.apps.filter((a) => a.name !== app.name);

const check = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>`;

const featureIcons = [
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><path d="M12 3v12"/><path d="M7 10l5 5 5-5"/><path d="M4 21h16"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21v-8H7v8"/><path d="M7 3v5h8"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18z"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>`,
];

const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: app.name,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  url: appUrl,
};
---

<Base
  lang="hi"
  title="ResumeForge — Free resume builder | Dusrel"
  description={app.heroSub}
  canonical="https://dusrel.com/hi/apps/resumeforge"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(appJsonLd)} />
  </Fragment>

  <SiteNav lang="hi" altHref="/apps/resumeforge" />

  <main>
    {/* Hero */}
    <section class="pt-14 pb-10 md:pt-20 md:pb-14">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <img
          src="/icons/resumeforge.svg"
          alt=""
          aria-hidden="true"
          class="mx-auto h-20 w-20"
          width="80"
          height="80"
        />
        <h1 class="font-display mt-6 text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-[#e8eaed]">
          {app.name}
        </h1>
        <p class="mt-3 text-xl md:text-2xl font-medium text-slate-700 dark:text-slate-300">
          {app.tagline}
        </p>
        <p class="mt-4 text-base md:text-lg leading-relaxed text-slate-600 dark:text-slate-400">
          {app.heroSub}
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
          <a
            href={appUrl}
            target="_blank"
            rel="noopener"
            class="w-full rounded-2xl bg-[#4d90fe] px-8 py-3.5 text-base font-semibold text-white shadow-sm transition-colors hover:bg-[#3b7de0] sm:w-auto"
          >
            {app.openApp} &nearr;
          </a>
          <a
            href="#more"
            class="w-full rounded-2xl border border-slate-300 px-8 py-3.5 text-base font-semibold text-slate-900 transition-colors hover:border-[#4d90fe] hover:text-[#4d90fe] sm:w-auto dark:border-white/20 dark:text-[#e8eaed]"
          >
            {app.moreTitle}
          </a>
        </div>
        <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2.5">
          {
            app.bullets.map((b) => (
              <li class="flex items-center gap-2 text-sm font-medium text-slate-700 dark:text-slate-300">
                <span class="text-[#4d90fe]" set:html={check} />
                {b}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* Visual */}
    <section class="pb-16 md:pb-20">
      <div class="mx-auto max-w-5xl px-6">
        <img
          src="/images/showcase-resumeforge.jpg"
          alt={app.name}
          loading="lazy"
          class="aspect-[16/10] w-full rounded-3xl border border-slate-200 object-cover shadow-sm dark:border-white/10"
        />
      </div>
    </section>

    {/* Features */}
    <section class="py-16 md:py-20">
      <div class="mx-auto max-w-6xl px-6">
        <h2 class="font-display text-center text-3xl md:text-4xl font-bold text-slate-900 dark:text-[#e8eaed]">
          {app.featuresTitle}
        </h2>
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            app.features.map((f, i) => (
              <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-white/10 dark:bg-[#1e1e1e]">
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#4d90fe]/10 text-[#4d90fe]">
                  <span set:html={featureIcons[i % featureIcons.length]} />
                </div>
                <h3 class="mt-4 font-semibold text-slate-900 dark:text-[#e8eaed]">{f.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{f.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* Privacy strip */}
    <section class="py-16 md:py-20">
      <div class="mx-auto max-w-4xl px-6">
        <div class="rounded-3xl border border-slate-200 bg-slate-50 p-8 md:p-10 dark:border-white/10 dark:bg-white/5">
          <div class="flex flex-col items-start gap-5 sm:flex-row">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-[#4d90fe]/10 text-[#4d90fe]">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
                <path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3z" />
                <path d="M9 12l2 2 4-4" />
              </svg>
            </div>
            <div>
              <h2 class="font-display text-2xl md:text-3xl font-bold text-slate-900 dark:text-[#e8eaed]">
                {app.privacyTitle}
              </h2>
              <p class="mt-3 leading-relaxed text-slate-600 dark:text-slate-400">
                {app.privacyBody}
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* More from Dusrel */}
    <section id="more" class="py-16 md:py-20">
      <div class="mx-auto max-w-6xl px-6">
        <h2 class="font-display text-center text-3xl md:text-4xl font-bold text-slate-900 dark:text-[#e8eaed]">
          {app.moreTitle}
        </h2>
        <div class="mt-12 grid gap-6 md:grid-cols-3">
          {
            others.map((a) => (
              <a
                href={lp(`/apps/${a.name === 'Image Quill' ? 'image-quill' : a.name === 'Ricsline' ? 'ricsline' : 'pdf-tools'}`)}
                class="group rounded-2xl border border-slate-200 bg-white p-6 transition-colors hover:border-[#4d90fe]/60 dark:border-white/10 dark:bg-[#1e1e1e]"
              >
                <img
                  src={iconFor[a.name] ?? '/logo.svg'}
                  alt=""
                  aria-hidden="true"
                  class="h-12 w-12"
                  width="48"
                  height="48"
                  loading="lazy"
                />
                <h3 class="font-display mt-4 text-xl font-bold text-slate-900 dark:text-[#e8eaed]">
                  {a.name}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{a.desc}</p>
                <span class="mt-4 inline-block text-sm font-medium text-[#4d90fe]">
                  <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* Final CTA */}
    <section class="py-16 md:py-24">
      <div class="mx-auto max-w-2xl px-6 text-center">
        <h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight text-slate-900 dark:text-[#e8eaed]">
          {app.ctaTitle}
        </h2>
        <p class="mt-4 text-base md:text-lg text-slate-600 dark:text-slate-400">
          {app.ctaSub}
        </p>
        <a
          href={appUrl}
          target="_blank"
          rel="noopener"
          class="mt-8 inline-block rounded-2xl bg-[#4d90fe] px-10 py-4 text-base font-semibold text-white shadow-sm transition-colors hover:bg-[#3b7de0]"
        >
          {app.ctaButton} &nearr;
        </a>
      </div>
    </section>
  </main>

  <Footer lang="hi" />
</Base>
