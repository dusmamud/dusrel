---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import Footer from '../../components/Footer.astro';
import { dict, type Lang } from '../../i18n';

const lang: Lang = 'hi';
const t = dict[lang];
const c = t.changelog;
---

<Base lang="hi" title="चेंजलॉग — Dusrel" description="दुसरेल चेंजलॉग — हर लॉन्च और मील का पत्थर, नया पहले।" canonical="https://dusrel.com/hi/changelog">
  <SiteNav lang="hi" altHref="/changelog" />
  <main>
    <section class="py-16 md:py-24">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-[#4d90fe]">{c.eyebrow}</p>
        <h1 class="font-display mt-3 text-4xl font-bold tracking-tight text-slate-900 md:text-5xl dark:text-[#e8eaed]">{c.title}</h1>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-400">{c.sub}</p>
      </div>
    </section>

    <section class="pb-16 md:pb-20">
      <div class="mx-auto max-w-3xl space-y-6 px-6">
        {c.entries.map((e) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-white/10 dark:bg-[#1e1e1e]">
            <p class="text-xs font-semibold uppercase tracking-widest text-[#4d90fe]">{e.date}</p>
            <h2 class="font-display mt-2 text-xl font-bold text-slate-900 dark:text-[#e8eaed]">{e.title}</h2>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{e.body}</p>
          </article>
        ))}
      </div>
    </section>
    <section class="pb-20 md:pb-24">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <h2 class="font-display text-2xl font-bold text-slate-900 dark:text-[#e8eaed]">{c.nextTitle}</h2>
        <p class="mt-3 text-slate-600 dark:text-slate-400">{c.nextBody}</p>
        <a href="/hi/#roadmap" class="mt-6 inline-block rounded-full bg-[#4d90fe] px-8 py-3 font-semibold text-white hover:opacity-90">{c.nextButton}</a>
      </div>
    </section>

  </main>
  <Footer lang="hi" />
</Base>
