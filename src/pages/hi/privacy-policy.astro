---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import Footer from '../../components/Footer.astro';
import { dict, type Lang } from '../../i18n';

const lang: Lang = 'hi';
const t = dict[lang];
const p = t.privacyPolicy;
---

<Base lang="hi" title="प्राइवेसी पॉलिसी — Dusrel" description="दुसरेल प्राइवेसी पॉलिसी सरल भाषा में: हम क्या इकट्ठा करते हैं (लगभग कुछ नहीं), क्या कभी नहीं करते, और आपके अधिकार।" canonical="https://dusrel.com/hi/privacy-policy">
  <SiteNav lang="hi" altHref="/privacy-policy" />
  <main>
    <section class="py-16 md:py-24">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-[#4d90fe]">{p.eyebrow}</p>
        <h1 class="font-display mt-3 text-4xl font-bold tracking-tight text-slate-900 md:text-5xl dark:text-[#e8eaed]">{p.title}</h1>
        <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">{p.updated}</p>
      </div>
    </section>
    <section class="pb-12">
      <div class="mx-auto max-w-3xl px-6">
        <div class="rounded-2xl border border-[#4d90fe]/30 bg-[#4d90fe]/5 p-6 dark:bg-[#4d90fe]/10">
          <h2 class="font-display text-lg font-bold text-slate-900 dark:text-[#e8eaed]">{p.shortTitle}</h2>
          <p class="mt-2 text-slate-600 dark:text-slate-400">{p.shortBody}</p>
        </div>
      </div>
    </section>

    <section class="pb-20 md:pb-24">
      <div class="mx-auto max-w-3xl space-y-10 px-6">
        {p.sections.map((s) => (
          <div>
            <h2 class="font-display text-2xl font-bold text-slate-900 dark:text-[#e8eaed]">{s.title}</h2>
            <div class="mt-3 space-y-3 text-slate-600 dark:text-slate-400">
              {s.body.split('\n\n').map((para) => <p>{para}</p>)}
            </div>
          </div>
        ))}
        <div class="rounded-2xl border border-slate-200 bg-white p-6 text-center dark:border-white/10 dark:bg-[#1e1e1e]">
          <h2 class="font-display text-xl font-bold text-slate-900 dark:text-[#e8eaed]">{p.contactCta.title}</h2>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{p.contactCta.body}</p>
          <a href="mailto:hello@dusrel.com" class="mt-4 inline-block rounded-full bg-[#4d90fe] px-6 py-2.5 font-semibold text-white hover:opacity-90">hello@dusrel.com</a>
        </div>
      </div>
    </section>

  </main>
  <Footer lang="hi" />
</Base>
