---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import Footer from '../../components/Footer.astro';
import { dict, type Lang } from '../../i18n';

const lang: Lang = 'hi';
const t = dict[lang];
const o = t.openSource;
---

<Base lang="hi" title="ओपन सोर्स — Dusrel" description="दुसरेल खुले में बनता है — dusrel.com का सोर्स GitHub पर पब्लिक है। हमारी सोच और योगदान कैसे करें।" canonical="https://dusrel.com/hi/open-source" image="/og-open-source.png">
  <SiteNav lang="hi" altHref="/open-source" />
  <main>
    <section class="py-16 md:py-24">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-[#4d90fe]">{o.eyebrow}</p>
        <h1 class="font-display mt-3 text-4xl font-bold tracking-tight text-slate-900 md:text-5xl dark:text-[#e8eaed]">{o.title}</h1>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-400">{o.sub}</p>
      </div>
    </section>

    <section class="pb-16 md:pb-20">
      <div class="mx-auto max-w-3xl px-6">
        <h2 class="font-display text-3xl font-bold text-slate-900 dark:text-[#e8eaed]">{o.openTitle}</h2>
        <p class="mt-4 text-slate-600 dark:text-slate-400">{o.openBody}</p>
        <div class="mt-6 flex flex-wrap items-center gap-4">
          <a href="https://github.com/dusmamud/dusrel" target="_blank" rel="noopener" class="rounded-full bg-[#4d90fe] px-6 py-2.5 font-semibold text-white hover:opacity-90">{o.starButton}</a>
          <span class="text-sm text-slate-500 dark:text-slate-400">{o.repoLabel}: <span class="font-mono">dusmamud/dusrel</span></span>
        </div>
      </div>
    </section>
    <section class="pb-16 md:pb-20">
      <div class="mx-auto max-w-6xl px-6">
        <h2 class="font-display text-center text-3xl font-bold text-slate-900 dark:text-[#e8eaed]">{o.philoTitle}</h2>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {o.philo.map((ph) => (
            <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-white/10 dark:bg-[#1e1e1e]">
              <h3 class="font-display text-lg font-bold text-slate-900 dark:text-[#e8eaed]">{ph.title}</h3>
              <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{ph.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="pb-16 md:pb-20">
      <div class="mx-auto max-w-3xl px-6">
        <h2 class="font-display text-3xl font-bold text-slate-900 dark:text-[#e8eaed]">{o.contribTitle}</h2>
        <ol class="mt-6 space-y-4">
          {o.steps.map((st, i) => (
            <li class="flex gap-4">
              <span class="font-display flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#4d90fe]/10 font-bold text-[#4d90fe]">{i + 1}</span>
              <div>
                <h3 class="font-semibold text-slate-900 dark:text-[#e8eaed]">{st.title}</h3>
                <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{st.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
    <section class="pb-20 md:pb-24">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <h2 class="font-display text-3xl font-bold text-slate-900 dark:text-[#e8eaed]">{o.ctaTitle}</h2>
        <p class="mt-3 text-slate-600 dark:text-slate-400">{o.ctaSub}</p>
        <a href="https://github.com/dusmamud/dusrel" target="_blank" rel="noopener" class="mt-6 inline-block rounded-full bg-[#4d90fe] px-8 py-3 font-semibold text-white hover:opacity-90">{o.ctaButton}</a>
      </div>
    </section>

  </main>
  <Footer lang="hi" />
</Base>
