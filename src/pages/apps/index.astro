---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import Footer from '../../components/Footer.astro';
import { dict, type Lang } from '../../i18n';

const lang: Lang = 'en';
const t = dict[lang];
const a = t.appsPage;

const slugs = ['image-quill', 'ricsline', 'resumeforge', 'pdf-tools'];
const icons = ['/icons/image-quill.svg', '/icons/ricsline.svg', '/icons/resumeforge.svg', '/icons/pdf-tools.svg'];
const detailHref = (slug: string) => `/apps/${slug}`;
const bell = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>`;
---

<Base
  lang="en"
  title="Apps — Dusrel"
  description="All Dusrel apps in one place — 4 live now, 8 more on the way. Free forever, private by design."
  canonical="https://dusrel.com/apps"
>
  <SiteNav lang="en" altHref="/hi/apps" />
  <main>
    <section class="py-16 md:py-24">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-[#4d90fe]">{a.eyebrow}</p>
        <h1 class="font-display mt-3 text-4xl font-bold tracking-tight text-slate-900 md:text-5xl dark:text-[#e8eaed]">{a.title}</h1>
        <p class="mt-4 text-lg text-slate-600 dark:text-slate-400">{a.sub}</p>
      </div>
    </section>

    <section class="pb-16 md:pb-20">
      <div class="mx-auto max-w-6xl px-6">
        <h2 class="font-display text-3xl font-bold text-slate-900 dark:text-[#e8eaed]">{a.liveTitle}</h2>
        <p class="mt-2 text-slate-600 dark:text-slate-400">{a.liveSub}</p>
        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          {t.ecosystem.apps.map((app, i) => (
            <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-white/10 dark:bg-[#1e1e1e]">
              <div class="flex items-center gap-4">
                <img src={icons[i]} alt="" class="h-12 w-12" width="48" height="48" aria-hidden="true" />
                <div>
                  <h3 class="font-display text-xl font-bold text-slate-900 dark:text-[#e8eaed]">{app.name}</h3>
                  <span class="mt-1 inline-block rounded-full bg-[#4d90fe]/10 px-2.5 py-0.5 text-xs font-semibold text-[#4d90fe]">{t.ecosystem.liveLabel}</span>
                </div>
              </div>
              <p class="mt-4 text-sm text-slate-600 dark:text-slate-400">{app.desc}</p>
              <div class="mt-5 flex flex-wrap gap-3">
                <a href={detailHref(slugs[i] ?? '')} class="rounded-full bg-[#4d90fe] px-5 py-2 text-sm font-semibold text-white hover:opacity-90">{t.ecosystem.learnMore}</a>
                <a href={app.url} target="_blank" rel="noopener" class="rounded-full border border-slate-300 px-5 py-2 text-sm font-semibold text-slate-700 hover:border-[#4d90fe] hover:text-[#4d90fe] dark:border-white/20 dark:text-slate-300">{a.openApp}</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="pb-16 md:pb-20">
      <div class="mx-auto max-w-6xl px-6">
        <h2 class="font-display text-3xl font-bold text-slate-900 dark:text-[#e8eaed]">{a.soonTitle}</h2>
        <p class="mt-2 text-slate-600 dark:text-slate-400">{a.soonSub}</p>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {t.ecosystem.soon.map((name) => (
            <div class="rounded-2xl border border-slate-200 bg-white p-6 text-center dark:border-white/10 dark:bg-[#1e1e1e]">
              <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-[#4d90fe]/10 text-[#4d90fe]" set:html={bell} />
              <h3 class="font-display mt-4 text-lg font-bold text-slate-900 dark:text-[#e8eaed]">{name}</h3>
              <span class="mt-2 inline-block rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-500 dark:bg-white/10 dark:text-slate-400">{t.ecosystem.soonLabel}</span>
              <div class="mt-4">
                <a href={`mailto:hello@dusrel.com?subject=${encodeURIComponent(a.notifyButton + ': ' + name)}`} class="text-sm font-semibold text-[#4d90fe] hover:underline">{a.notifyButton} &rarr;</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="pb-20 md:pb-24">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <h2 class="font-display text-3xl font-bold text-slate-900 dark:text-[#e8eaed]">{a.ctaTitle}</h2>
        <p class="mt-3 text-slate-600 dark:text-slate-400">{a.ctaSub}</p>
        <a href="/#apps" class="mt-6 inline-block rounded-full bg-[#4d90fe] px-8 py-3 font-semibold text-white hover:opacity-90">{a.ctaButton}</a>
      </div>
    </section>
  </main>
  <Footer lang="en" />
</Base>
