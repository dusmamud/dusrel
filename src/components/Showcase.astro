---
import { dict, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const t = dict[lang];

const apps = t.ecosystem.apps;
const images = [
  '/images/showcase-image-quill.jpg',
  '/images/showcase-ricsline.jpg',
  '/images/showcase-resumeforge.jpg',
  '/images/showcase-pdf-tools.jpg',
];

const check = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>`;
---

<section id="showcase" class="py-20 md:py-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto">
      <p>
        <span class="inline-block rounded-full border border-[#4d90fe]/40 bg-[#4d90fe]/5 px-4 py-1.5 text-[11px] font-semibold tracking-[0.18em] text-[#4d90fe]">
          {t.showcase.eyebrow}
        </span>
      </p>
      <h2 class="font-display mt-5 text-3xl md:text-4xl font-bold text-slate-900 dark:text-[#e8eaed]">
        {t.showcase.title}
      </h2>
      <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">{t.showcase.sub}</p>
    </div>

    <div class="mt-14 md:mt-20 space-y-14 md:space-y-20">
      {
        apps.map((app, i) => {
          const detail = t.showcase.details[i];
          const flip = i % 2 === 1;
          return (
            <div class="grid items-center gap-8 md:grid-cols-2 md:gap-12">
              <div class={flip ? 'md:order-2' : ''}>
                <img
                  src={images[i]}
                  alt={app.name}
                  loading="lazy"
                  class="aspect-[4/3] w-full rounded-3xl border border-slate-200 object-cover shadow-sm dark:border-white/10"
                />
              </div>
              <div class={flip ? 'md:order-1' : ''}>
                <h3 class="font-display text-2xl font-bold text-slate-900 dark:text-[#e8eaed]">
                  {app.name}
                </h3>
                <p class="mt-2 text-slate-600 dark:text-slate-400">{detail.tagline}</p>
                <ul class="mt-5 space-y-2.5">
                  {detail.features.map((f) => (
                    <li class="flex items-start gap-2.5 text-sm text-slate-700 dark:text-slate-300">
                      <span class="mt-0.5 text-[#4d90fe]" set:html={check} />
                      {f}
                    </li>
                  ))}
                </ul>
                <a
                  href={app.url}
                  target="_blank"
                  rel="noopener"
                  class="mt-5 inline-block text-sm font-medium text-[#4d90fe] hover:underline"
                >
                  {t.ecosystem.visit} &rarr;
                </a>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
