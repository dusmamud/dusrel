---
/* Light / Dark / System theme toggle. Works with the `dark` class strategy
   (see @custom-variant in global.css + the init script in Base.astro). */
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle color theme"
  title="Toggle color theme"
  class="flex h-9 w-9 items-center justify-center rounded-xl border border-slate-200 text-slate-600 transition-colors hover:border-[#4d90fe] hover:text-[#4d90fe] dark:border-white/10 dark:text-slate-300"
>
  <svg id="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden h-[18px] w-[18px]">
    <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <svg id="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden h-[18px] w-[18px]">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
  </svg>
</button>

<script is:inline>
  (function () {
    var KEY = 'dusrel-theme';
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    var icons = {
      light: document.getElementById('theme-icon-sun'),
      dark: document.getElementById('theme-icon-moon'),
    };
    function osDark() {
      return window.matchMedia('(prefers-color-scheme: dark)').matches;
    }
    function stored() {
      try {
        var v = localStorage.getItem(KEY);
        return v === 'light' || v === 'dark' ? v : 'system';
      } catch (e) {
        return 'system';
      }
    }
    function effective(mode) {
      if (mode === 'dark') return 'dark';
      if (mode === 'light') return 'light';
      return osDark() ? 'dark' : 'light';
    }
    function apply(mode) {
      var eff = effective(mode);
      var dark = eff === 'dark';
      document.documentElement.classList.toggle('dark', dark);
      document.documentElement.style.colorScheme = eff;
      var color = dark ? '#121212' : '#ffffff';
      document.querySelectorAll('meta[data-theme-color]').forEach(function (m) {
        m.setAttribute('content', color);
      });
      // show the icon of the current effective theme
      if (icons.light) icons.light.classList.toggle('hidden', dark);
      if (icons.dark) icons.dark.classList.toggle('hidden', !dark);
      btn.setAttribute('aria-label', 'Theme: ' + eff + ' (click to switch to ' + (dark ? 'light' : 'dark') + ')');
    }
    function toggle() {
      var before = effective(stored());
      var next = before === 'dark' ? 'light' : 'dark';
      try {
        localStorage.setItem(KEY, next);
      } catch (e) {}
      // Circular reveal from the button — same technique as dusmamud/shrinkit.
      // Skip the animation when VT is unavailable or reduced motion is preferred.
      if (
        !document.startViewTransition ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        apply(next);
        return;
      }
      var rect = btn.getBoundingClientRect();
      var cx = rect.left + rect.width / 2;
      var cy = rect.top + rect.height / 2;
      var max = Math.hypot(
        Math.max(cx, window.innerWidth - cx),
        Math.max(cy, window.innerHeight - cy)
      );
      var transition = document.startViewTransition(function () {
        apply(next);
      });
      transition.ready.then(function () {
        document.documentElement.animate(
          {
            clipPath: [
              'circle(0px at ' + cx + 'px ' + cy + 'px)',
              'circle(' + max + 'px at ' + cx + 'px ' + cy + 'px)',
            ],
          },
          {
            duration: 650,
            easing: 'ease-in-out',
            pseudoElement: '::view-transition-new(root)',
          }
        );
      });
    }
    // reflect stored/system theme on load
    apply(stored());
    // keep following the OS theme until the user picks explicitly
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
      if (stored() === 'system') apply('system');
    });
    // cross-tab sync
    window.addEventListener('storage', function (e) {
      if (e.key === KEY) apply(stored());
    });
    btn.addEventListener('click', toggle);
  })();
</script>
