---
import { dict, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const t = dict[lang];

const icons = [
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><path d="M16 5a3.5 3.5 0 0 1 0 6.8"/><path d="M17.5 14.5c2.3.7 4 2.7 4 5.5"/></svg>`,
];
---

<section id="why" class="py-20 md:py-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="font-display text-3xl md:text-4xl font-bold text-slate-900 dark:text-[#e8eaed]">
        {t.why.title}
      </h2>
      <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">{t.why.sub}</p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        t.why.points.map((point, i) => (
          <div class="rounded-2xl border border-slate-200 dark:border-white/10 bg-white dark:bg-[#1e1e1e] p-6">
            <div class="w-11 h-11 rounded-xl bg-[#4d90fe]/10 text-[#4d90fe] flex items-center justify-center">
              <span set:html={icons[i % icons.length]} />
            </div>
            <h3 class="mt-4 font-semibold text-slate-900 dark:text-[#e8eaed]">{point.title}</h3>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{point.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section id="privacy" class="py-20 md:py-24">
  <div class="max-w-3xl mx-auto px-6 text-center">
    <svg viewBox="0 0 24 24" fill="currentColor" class="w-10 h-10 mx-auto text-[#4d90fe]/30" aria-hidden="true">
      <path d="M10 8c-3 1-5 3.5-5 7v1h5v-6H7.5C8 9 9 8.5 10 8.2V8zm9 0c-3 1-5 3.5-5 7v1h5v-6h-2.5c.5-1 1.5-1.5 2.5-1.8V8z" />
    </svg>
    <p class="mt-4 text-sm font-semibold tracking-widest uppercase text-[#4d90fe]">
      {t.privacy.title}
    </p>
    <blockquote class="mt-4 font-display text-2xl md:text-4xl font-bold text-slate-900 dark:text-[#e8eaed] leading-snug">
      {t.privacy.quote}
    </blockquote>
    <p class="mt-6 text-slate-600 dark:text-slate-400 leading-relaxed">{t.privacy.body}</p>
  </div>
</section>
