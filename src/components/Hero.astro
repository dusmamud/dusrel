---
import { dict, type Lang } from '../i18n';
import ThemeToggle from './ThemeToggle.astro';
import { liveApps, soonApps, appIcon, appContentFor } from '../data/apps';
const { lang } = Astro.props as { lang: Lang };
const t = dict[lang];
const homeHref = lang === 'hi' ? '/hi/' : '/';
// Header nav: actual pages everywhere (no # anchors) — professional + consistent with subpages
const lp = (enPath: string) => (lang === 'en' ? enPath : `/hi${enPath}`);
const links = [
  { href: lp('/apps'), label: t.nav.apps },
  { href: lp('/about'), label: t.nav.about },
  { href: lp('/open-source'), label: t.nav.openSource },
  { href: lp('/contact'), label: t.nav.contact },
];

const orbitApps = liveApps.map((app) => {
  const content = appContentFor(t.appContent, app.slug);
  return { ...app, name: content.name, logo: appIcon(app.slug), imgClass: 'h-10 w-10' };
});

const soonNames = soonApps.map((a) => appContentFor(t.appContent, a.slug).name);
---

<!-- Floating pill header -->
<div class="fixed inset-x-0 top-3 z-50 px-3 sm:top-4 sm:px-4">
  <header id="site-header" class="mx-auto max-w-5xl rounded-2xl border border-slate-200/80 bg-white/85 shadow-[0_8px_30px_rgba(0,0,0,0.06)] backdrop-blur-xl dark:border-white/10 dark:bg-[#161616]/85 dark:shadow-[0_8px_30px_rgba(0,0,0,0.4)]">
    <nav class="flex h-14 items-center justify-between px-4 sm:px-5">
      <a href={homeHref} class="flex items-center gap-2.5">
        <img src="/logo.svg" alt="Dusrel logo" class="h-8 w-8" width="32" height="32" />
        <span class="font-display text-lg font-bold tracking-tight text-slate-900 dark:text-[#e8eaed]">Dusrel</span>
      </a>

      <div class="hidden items-center gap-7 text-sm font-medium md:flex">
        {links.map((l) => (
          <a href={l.href} class="text-slate-600 transition-colors hover:text-[#4d90fe] dark:text-slate-300">{l.label}</a>
        ))}
      </div>

      <div class="flex items-center gap-2">
        <span class="hidden text-xs font-semibold tracking-wide text-slate-500 sm:inline dark:text-slate-400">
          <a href="/" class:list={[{ 'text-[#4d90fe]': lang === 'en' }]}>EN</a>
          <span class="mx-1.5 text-slate-300 dark:text-slate-600">|</span>
          <a href="/hi/" class:list={[{ 'text-[#4d90fe]': lang === 'hi' }]}>HI</a>
        </span>
        <ThemeToggle />
        <a
          href={lp('/apps')}
          class="hidden rounded-xl bg-[#4d90fe] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[#3b7de0] md:inline-flex"
        >
          {t.nav.cta}
        </a>
        <button
          id="menu-btn"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          class="flex h-9 w-9 items-center justify-center rounded-xl border border-slate-200 text-slate-600 md:hidden dark:border-white/10 dark:text-slate-300"
        >
          <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden h-5 w-5">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile menu : actual pages -->
    <div id="mobile-menu" class="hidden md:hidden">
      <nav class="flex flex-col gap-1 border-t border-slate-200/70 px-4 py-4 dark:border-white/10">
        {links.map((l) => (
          <a
            href={l.href}
            class="mobile-link rounded-xl px-3 py-2.5 text-[15px] font-medium text-slate-700 transition-colors hover:bg-slate-100 hover:text-[#4d90fe] dark:text-slate-200 dark:hover:bg-white/5"
          >{l.label}</a>
        ))}
        <div class="mt-2 flex items-center gap-3 border-t border-slate-200/70 px-3 pt-4 text-sm font-semibold sm:hidden dark:border-white/10">
          <span class="text-slate-500 dark:text-slate-400">Language:</span>
          <a href="/" class:list={[{ 'text-[#4d90fe]': lang === 'en' }, 'text-slate-600 dark:text-slate-300']}>English</a>
          <a href="/hi/" class:list={[{ 'text-[#4d90fe]': lang === 'hi' }, 'text-slate-600 dark:text-slate-300']}>हिन्दी</a>
        </div>
      </nav>
    </div>
  </header>
</div>

<!-- Hero -->
<section id="hero" class="relative overflow-hidden">
  <div class="relative mx-auto max-w-4xl px-4 pt-32 text-center sm:px-6 sm:pt-40">
    <div class="animate-rise">
      <p class="text-sm font-semibold text-[#4d90fe]">
        {t.hero.eyebrow}
      </p>
      <h1 class="font-display mt-6 text-[2.6rem] font-bold leading-[1.08] tracking-tight text-slate-900 sm:text-6xl lg:text-7xl dark:text-[#e8eaed]">
        {t.hero.titleAccent} {t.hero.title}
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg dark:text-slate-300">
        {t.hero.sub}
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
        <a
          href="#apps"
          class="w-full rounded-[10px] bg-[#4d90fe] px-8 py-3.5 text-base font-semibold text-white shadow-sm transition-colors hover:bg-[#3b7de0] sm:w-auto"
        >
          {t.hero.ctaApps}
        </a>
        <a
          href="#privacy"
          class="w-full rounded-[10px] border border-slate-300 bg-white px-8 py-3.5 text-base font-semibold text-slate-900 transition-colors hover:border-[#4d90fe] hover:text-[#4d90fe] sm:w-auto dark:border-white/20 dark:bg-transparent dark:text-[#e8eaed]"
        >
          {t.hero.ctaPrivacy}
        </a>
      </div>
    </div>
  </div>

  <!-- Ecosystem orbit visual (static) -->
  <div class="relative mx-auto mt-12 max-w-3xl px-4 sm:mt-14">
    <!-- desktop orbit -->
    <div class="relative hidden h-[320px] sm:block">
      <div class="absolute left-1/2 top-1/2 h-[220px] w-[220px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-dashed border-slate-300/80 dark:border-white/10"></div>
      <div class="absolute left-1/2 top-1/2 h-[300px] w-[300px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-dashed border-slate-300/60 dark:border-white/[0.07]"></div>
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
        <div class="flex h-24 w-24 items-center justify-center rounded-[1.75rem] border border-slate-200/80 bg-white p-4 shadow-[0_12px_40px_rgba(0,0,0,0.08)] dark:border-white/10 dark:bg-[#1e1e1e]">
          <img src="/logo.svg" alt="" class="h-full w-full" />
        </div>
      </div>
      <a href={orbitApps[0].url} target="_blank" rel="noopener"
        class="absolute left-[1%] top-[6%] flex items-center gap-2.5 rounded-2xl border border-slate-200/80 bg-white px-4 py-3 shadow-[0_8px_24px_rgba(0,0,0,0.06)] transition-colors hover:border-[#4d90fe]/40 dark:border-white/10 dark:bg-[#1e1e1e] dark:shadow-[0_8px_24px_rgba(0,0,0,0.35)]">
        <img src={orbitApps[0].logo} alt="" class={orbitApps[0].imgClass} width="48" height="48" />
        <span class="text-sm font-semibold text-slate-800 dark:text-slate-100">{orbitApps[0].name}</span>
      </a>
      <a href={orbitApps[1].url} target="_blank" rel="noopener"
        class="absolute right-[1%] top-[2%] flex items-center gap-2.5 rounded-2xl border border-slate-200/80 bg-white px-4 py-3 shadow-[0_8px_24px_rgba(0,0,0,0.06)] transition-colors hover:border-[#4d90fe]/40 dark:border-white/10 dark:bg-[#1e1e1e] dark:shadow-[0_8px_24px_rgba(0,0,0,0.35)]">
        <img src={orbitApps[1].logo} alt="" class={orbitApps[1].imgClass} width="48" height="48" />
        <span class="text-sm font-semibold text-slate-800 dark:text-slate-100">{orbitApps[1].name}</span>
      </a>
      <a href={orbitApps[2].url} target="_blank" rel="noopener"
        class="absolute bottom-[8%] left-[4%] flex items-center gap-2.5 rounded-2xl border border-slate-200/80 bg-white px-4 py-3 shadow-[0_8px_24px_rgba(0,0,0,0.06)] transition-colors hover:border-[#4d90fe]/40 dark:border-white/10 dark:bg-[#1e1e1e] dark:shadow-[0_8px_24px_rgba(0,0,0,0.35)]">
        <img src={orbitApps[2].logo} alt="" class={orbitApps[2].imgClass} width="48" height="48" />
        <span class="text-sm font-semibold text-slate-800 dark:text-slate-100">{orbitApps[2].name}</span>
      </a>
      <a href={orbitApps[3].url} target="_blank" rel="noopener"
        class="absolute bottom-[4%] right-[4%] flex items-center gap-2.5 rounded-2xl border border-slate-200/80 bg-white px-4 py-3 shadow-[0_8px_24px_rgba(0,0,0,0.06)] transition-colors hover:border-[#4d90fe]/40 dark:border-white/10 dark:bg-[#1e1e1e] dark:shadow-[0_8px_24px_rgba(0,0,0,0.35)]">
        <img src={orbitApps[3].logo} alt="" class={orbitApps[3].imgClass} width="48" height="48" />
        <span class="text-sm font-semibold text-slate-800 dark:text-slate-100">{orbitApps[3].name}</span>
      </a>
    </div>

    <!-- mobile: simple 2x2 grid -->
    <div class="grid grid-cols-2 gap-3 sm:hidden">
      {orbitApps.map((app) => (
        <a href={app.url} target="_blank" rel="noopener"
          class="flex items-center gap-2.5 rounded-2xl border border-slate-200/80 bg-white px-4 py-3.5 dark:border-white/10 dark:bg-[#1e1e1e]">
          <img src={app.logo} alt="" class={`${app.imgClass} shrink-0`} width="48" height="48" />
          <span class="text-sm font-semibold text-slate-800 dark:text-slate-100">{app.name}</span>
        </a>
      ))}
    </div>

    <!-- stats strip -->
    <dl class="mx-auto mt-10 grid max-w-2xl grid-cols-2 gap-y-6 sm:grid-cols-4">
      {t.hero.stats.map((s) => (
        <div class="px-4">
          <dt class="sr-only">{s.label}</dt>
          <dd class="font-display text-2xl font-bold tabular-nums text-slate-900 sm:text-3xl dark:text-[#e8eaed]">{s.value}</dd>
          <dd class="mt-1 text-xs font-medium text-slate-500 dark:text-slate-400">{s.label}</dd>
        </div>
      ))}
    </dl>
  </div>

  <!-- coming-soon list (static) -->
  <div class="relative mt-10 overflow-hidden border-y border-slate-200/70 py-4 dark:border-white/10" aria-hidden="true">
    <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-3 px-4">
      {soonNames.map((name) => (
        <span class="flex items-center gap-10 whitespace-nowrap text-sm font-semibold text-slate-400 dark:text-slate-500">
          {name}
          <span class="h-1.5 w-1.5 rounded-full bg-[#4d90fe]/50"></span>
        </span>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    // Mobile menu
    var btn = document.getElementById('menu-btn');
    var menu = document.getElementById('mobile-menu');
    if (btn && menu) {
      var iconOpen = document.getElementById('menu-icon-open');
      var iconClose = document.getElementById('menu-icon-close');
      function setOpen(open) {
        menu.classList.toggle('hidden', !open);
        if (iconOpen) iconOpen.classList.toggle('hidden', open);
        if (iconClose) iconClose.classList.toggle('hidden', !open);
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        // Lock background scroll while the menu is open (UX).
        document.body.style.overflow = open ? 'hidden' : '';
      }
      btn.addEventListener('click', function () {
        setOpen(menu.classList.contains('hidden'));
      });
      menu.querySelectorAll('.mobile-link').forEach(function (a) {
        a.addEventListener('click', function () { setOpen(false); });
      });
    }

    // Header shadow on scroll
    var header = document.getElementById('site-header');
    if (header) {
      var onScroll = function () {
        header.classList.toggle('is-scrolled', window.scrollY > 12);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
  })();
</script>
