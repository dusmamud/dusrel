---
/**
 * Shared template for /pass/<tool> pages (EN + HI).
 * Content comes from src/i18n dict `tools.*` (keyed via contentBySlug);
 * the interactive island from src/components/tools/.
 * Emits WebApplication + FAQPage JSON-LD; breadcrumbs come from Base.astro.
 * To add a tool page: registry entry in src/data/tools.ts + component +
 * i18n content + one line in contentBySlug and in the render switch below.
 */
import Base from '../layouts/Base.astro';
import SiteNav from './SiteNav.astro';
import Footer from './Footer.astro';
import PasswordGenerator from './tools/PasswordGenerator.astro';
import UsernameGenerator from './tools/UsernameGenerator.astro';
import WordCounter from './tools/WordCounter.astro';
import QrCodeGenerator from './tools/QrCodeGenerator.astro';
import AgeCalculator from './tools/AgeCalculator.astro';
import PasswordStrength from './tools/PasswordStrength.astro';
import { tools, toolHref } from '../data/tools';
import { dict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  slug: string;
}
const { lang, slug } = Astro.props;
const t = dict[lang];

const contentBySlug: Record<string, (typeof t.tools)[keyof typeof t.tools]> = {
  'password-generator': t.tools.password,
  'username-generator': t.tools.username,
  'word-counter': t.tools.wordCounter,
  'qr-code-generator': t.tools.qrCode,
  'age-calculator': t.tools.ageCalculator,
  'password-strength-checker': t.tools.passwordStrength,
};
const d = contentBySlug[slug] as typeof t.tools.password | undefined;
if (!d) return Astro.redirect('/404');

const lp = (p: string) => `${lang === 'hi' ? '/hi' : ''}${p}/`;
const canonical = `https://dusrel.com${lp(`/pass/${slug}`)}`;
const others = tools.filter((x) => x.slug !== slug);

const webAppLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: d.h1,
  description: d.metaDesc,
  url: canonical,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web',
  inLanguage: lang === 'hi' ? 'hi-IN' : 'en-US',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Organization', name: 'Dusrel', url: 'https://dusrel.com/' },
  publisher: { '@type': 'Organization', name: 'Dusrel', url: 'https://dusrel.com/' },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: d.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const moreToolsLabel = lang === 'hi' ? 'और मुफ्त टूल्स' : 'More free tools';
---

<Base lang={lang} title={d.metaTitle} description={d.metaDesc} canonical={canonical} image={`/og-${slug}.png`}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(webAppLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>
  <SiteNav lang={lang} />
  <main class="mx-auto max-w-3xl px-4 pb-20 pt-10">
    <nav class="text-sm text-slate-500 dark:text-slate-400" aria-label="Breadcrumb">
      <a href={lp('/pass')} class="hover:text-[#4d90fe]">{lang === 'hi' ? 'टूल्स' : 'Tools'}</a>
      <span class="mx-2">/</span>
      <span class="text-slate-900 dark:text-white">{d.h1}</span>
    </nav>

    <div class="mt-8 text-center">
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-white md:text-5xl">{d.h1}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-400">{d.tagline}</p>
    </div>

    <div class="mt-10">
      {slug === 'password-generator' && <PasswordGenerator lang={lang} />}
      {slug === 'username-generator' && <UsernameGenerator lang={lang} />}
      {slug === 'word-counter' && <WordCounter lang={lang} />}
      {slug === 'qr-code-generator' && <QrCodeGenerator lang={lang} />}
      {slug === 'age-calculator' && <AgeCalculator lang={lang} />}
      {slug === 'password-strength-checker' && <PasswordStrength lang={lang} />}
    </div>

    <div class="mx-auto mt-12 max-w-2xl space-y-4 leading-relaxed text-slate-600 dark:text-slate-300">
      {d.intro.map((para) => <p>{para}</p>)}
    </div>

    <section class="mt-14">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">{d.howTitle}</h2>
      <ol class="mt-6 space-y-6">
        {d.steps.map((s, i) => (
          <li class="flex gap-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#4d90fe]/10 text-base font-bold text-[#4d90fe]">{i + 1}</span>
            <div>
              <p class="font-semibold text-slate-900 dark:text-white">{s.title}</p>
              <p class="mt-1 leading-relaxed text-slate-600 dark:text-slate-400">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-14">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">{d.faqTitle}</h2>
      <div class="mt-5 space-y-3">
        {d.faqs.map((f) => (
          <details class="group rounded-2xl border border-slate-200 bg-white px-5 py-4 dark:border-white/10 dark:bg-white/5">
            <summary class="cursor-pointer list-none font-semibold text-slate-900 marker:hidden dark:text-white [&::-webkit-details-marker]:hidden">
              <span class="flex items-center justify-between gap-4">
                {f.q}
                <span aria-hidden="true" class="text-[#4d90fe] transition-transform group-open:rotate-45">+</span>
              </span>
            </summary>
            <p class="mt-3 leading-relaxed text-slate-600 dark:text-slate-300">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mt-14">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">{moreToolsLabel}</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {others.map((o) => (
          <a
            href={toolHref(o.slug, lang)}
            class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-[#4d90fe] hover:shadow-md dark:border-white/10 dark:bg-white/5"
          >
            <p class="font-semibold text-slate-900 dark:text-white">{o.name[lang]}</p>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{o.blurb[lang]}</p>
            <span aria-hidden="true" class="mt-3 inline-block text-[#4d90fe] transition-transform group-hover:translate-x-0.5">→</span>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Base>
