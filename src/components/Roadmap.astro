---
import { dict, type Lang } from '../i18n';
import { liveApps, soonApps, appContentFor } from '../data/apps';
const { lang } = Astro.props as { lang: Lang };
const t = dict[lang];

const content = (slug: string) => appContentFor(t.appContent, slug);

const groups = [
  {
    label: t.roadmap.live,
    dot: 'bg-green-500',
    kind: 'live' as const,
  },
  {
    label: t.roadmap.next,
    dot: 'bg-[#4d90fe]',
    kind: 'next' as const,
  },
  {
    label: t.roadmap.later,
    dot: 'bg-slate-400 dark:bg-slate-500',
    kind: 'later' as const,
  },
];

const comingNext = soonApps.slice(0, 4);
const onHorizon = soonApps.slice(4);
---

<section id="roadmap" class="py-20 md:py-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto">
      <p class="text-sm font-semibold tracking-widest uppercase text-[#4d90fe]">
        {t.roadmap.eyebrow}
      </p>
      <h2 class="font-display mt-3 text-3xl md:text-4xl font-bold text-slate-900 dark:text-[#e8eaed]">
        {t.roadmap.title}
      </h2>
      <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">{t.roadmap.sub}</p>
    </div>

    <div class="relative max-w-3xl mx-auto mt-14">
      <div
        class="absolute top-3 bottom-3 left-[7px] w-px bg-slate-200 dark:bg-white/10"
        aria-hidden="true"
      ></div>

      {
        groups.map((group) => (
          <div class="relative pl-10 pb-10 last:pb-0">
            <span
              class={`absolute left-0 top-1.5 w-4 h-4 rounded-full ${group.dot}`}
              aria-hidden="true"
            />
            <p class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
              {group.label}
            </p>
            {group.kind === 'live' ? (
              <div class="mt-4 flex flex-wrap gap-3">
                {liveApps.map((app) => (
                  <a
                    href={app.url}
                    target="_blank"
                    rel="noopener"
                    class="rounded-full border border-slate-200 dark:border-white/10 bg-white dark:bg-[#1e1e1e] px-4 py-2 text-sm font-medium text-slate-700 dark:text-slate-200 transition hover:border-[#4d90fe] hover:text-[#4d90fe]"
                  >
                    {content(app.slug).name}
                  </a>
                ))}
              </div>
            ) : (
              <div class="mt-4 flex flex-wrap gap-3">
                {(group.kind === 'next' ? comingNext : onHorizon).map((app) => (
                  <span class="rounded-full border border-dashed border-slate-300 dark:border-white/10 px-4 py-2 text-sm font-medium text-slate-500 dark:text-slate-400">
                    {content(app.slug).name}
                  </span>
                ))}
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
