---
/**
 * Password Strength Checker tool island — 100% client-side.
 * Character-pool entropy estimate + crack-time estimate + checklist.
 * The typed password never leaves the browser. Used on /pass and
 * /pass/password-strength (EN + HI via the `lang` prop).
 */
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const L = {
  en: {
    placeholder: 'Type a password to test it',
    show: 'Show',
    hide: 'Hide',
    strength: 'Strength',
    bits: 'bits of entropy',
    weak: 'Weak',
    fair: 'Fair',
    strong: 'Strong',
    excellent: 'Excellent',
    crackTime: 'Estimated crack time',
    instant: 'instant',
    seconds: 'seconds',
    minutes: 'minutes',
    hours: 'hours',
    days: 'days',
    years: 'years',
    thousandYears: 'thousand years',
    millionYears: 'million years',
    billionYears: 'billion years',
    trillionYears: 'trillion+ years',
    checkLength: 'At least 12 characters',
    checkCase: 'Uppercase and lowercase letters',
    checkNumber: 'Contains a number',
    checkSymbol: 'Contains a symbol',
    checkPattern: 'No obvious patterns (repeats, sequences, common words, years)',
    note: 'Checked locally in your browser only — the password you type is never sent anywhere or stored.',
    tip: 'Honest tip: avoid typing a real password you currently use into any website tool, including this one. Test a similar made-up password instead.',
  },
  hi: {
    placeholder: 'जांचने के लिए पासवर्ड लिखें',
    show: 'दिखाएं',
    hide: 'छिपाएं',
    strength: 'मज़बूती',
    bits: 'बिट्स एंट्रॉपी',
    weak: 'कमज़ोर',
    fair: 'ठीक-ठाक',
    strong: 'मज़बूत',
    excellent: 'बेहतरीन',
    crackTime: 'अनुमानित क्रैक समय',
    instant: 'तुरंत',
    seconds: 'सेकंड',
    minutes: 'मिनट',
    hours: 'घंटे',
    days: 'दिन',
    years: 'साल',
    thousandYears: 'हज़ार साल',
    millionYears: 'मिलियन साल',
    billionYears: 'बिलियन साल',
    trillionYears: 'ट्रिलियन+ साल',
    checkLength: 'कम से कम 12 अक्षर',
    checkCase: 'बड़े और छोटे दोनों अक्षर',
    checkNumber: 'एक अंक शामिल है',
    checkSymbol: 'एक चिह्न शामिल है',
    checkPattern: 'कोई स्पष्ट पैटर्न नहीं (दोहराव, क्रम, आम शब्द, साल)',
    note: 'जांच सिर्फ़ आपके ब्राउज़र में ही होती है — आप जो पासवर्ड लिखते हैं वह कहीं भेजा या स्टोर नहीं होता।',
    tip: 'एक ईमानदार सलाह: जो असली पासवर्ड आप अभी इस्तेमाल करते हैं, उसे किसी भी वेबसाइट टूल में लिखने से बचें — इस टूल में भी। इसके बजाय वैसा ही कोई बना-बनाया पासवर्ड जांचें।',
  },
} as const;
const t = L[lang];

const checks = [
  { key: 'length', label: t.checkLength },
  { key: 'case', label: t.checkCase },
  { key: 'number', label: t.checkNumber },
  { key: 'symbol', label: t.checkSymbol },
  { key: 'pattern', label: t.checkPattern },
];
---

<div
  data-pws
  data-labels={JSON.stringify({
    weak: t.weak, fair: t.fair, strong: t.strong, excellent: t.excellent,
    bits: t.bits, show: t.show, hide: t.hide, instant: t.instant,
    seconds: t.seconds, minutes: t.minutes, hours: t.hours, days: t.days,
    years: t.years, thousandYears: t.thousandYears, millionYears: t.millionYears,
    billionYears: t.billionYears, trillionYears: t.trillionYears,
  })}
  class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-white/5 md:p-8"
>
  <div class="flex items-stretch gap-3">
    <input
      type="password"
      data-pws-input
      placeholder={t.placeholder}
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      class="min-w-0 flex-1 rounded-2xl bg-slate-100 px-5 py-4 font-mono text-lg text-slate-900 outline-none placeholder:text-slate-400 dark:bg-black/40 dark:text-white"
    />
    <button
      type="button"
      data-pws-toggle
      class="shrink-0 rounded-xl border border-slate-300 px-4 text-sm font-semibold text-slate-700 transition hover:border-[#4d90fe] hover:text-[#4d90fe] dark:border-white/20 dark:text-slate-200"
    >
      {t.show}
    </button>
  </div>

  <div class="mt-5">
    <div class="flex items-center justify-between text-sm">
      <span class="font-medium text-slate-700 dark:text-slate-300">{t.strength}</span>
      <span class="text-slate-500 dark:text-slate-400"><span data-pws-strength class="font-semibold text-slate-900 dark:text-white">—</span> · <span data-pws-bits>0 {t.bits}</span></span>
    </div>
    <div class="mt-2 h-2.5 overflow-hidden rounded-full bg-slate-200 dark:bg-white/10">
      <div data-pws-bar class="h-full rounded-full transition-all duration-300" style="width: 0%; background: #ef4444"></div>
    </div>
    <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">
      {t.crackTime}: <span data-pws-crack class="font-semibold text-slate-900 dark:text-white">{t.instant}</span>
    </p>
  </div>

  <ul class="mt-6 space-y-2.5">
    {checks.map((c) => (
      <li data-pws-check={c.key} class="flex items-center gap-2.5 text-sm text-slate-600 dark:text-slate-300">
        <span data-pws-icon class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-slate-500/10 text-xs font-bold text-slate-400">✗</span>
        {c.label}
      </li>
    ))}
  </ul>

  <p class="mt-6 text-center text-xs leading-relaxed text-slate-500 dark:text-slate-400">{t.note}</p>
  <p class="mt-2 text-center text-xs leading-relaxed text-slate-500 dark:text-slate-400">{t.tip}</p>
</div>

<script>
  // The 32 printable ASCII punctuation characters.
  const SYMBOLS = '!"#$%&\'()*+,-./:;<=>?@[\\]^_`{|}~';

  document.querySelectorAll<HTMLElement>('[data-pws]').forEach((root) => {
    const labels = JSON.parse(root.dataset.labels || '{}');
    const input = root.querySelector<HTMLInputElement>('[data-pws-input]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-pws-toggle]')!;
    const bar = root.querySelector<HTMLElement>('[data-pws-bar]')!;
    const strengthEl = root.querySelector<HTMLElement>('[data-pws-strength]')!;
    const bitsEl = root.querySelector<HTMLElement>('[data-pws-bits]')!;
    const crackEl = root.querySelector<HTMLElement>('[data-pws-crack]')!;

    const ICON_BASE =
      'flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-xs font-bold ';
    const setCheck = (key: string, pass: boolean) => {
      const row = root.querySelector<HTMLElement>(`[data-pws-check="${key}"]`)!;
      const icon = row.querySelector<HTMLElement>('[data-pws-icon]')!;
      icon.textContent = pass ? '✓' : '✗';
      icon.className =
        ICON_BASE + (pass ? 'bg-green-500/15 text-green-500' : 'bg-slate-500/10 text-slate-400');
    };

    // Human-friendly crack time at 10 billion guesses/second (offline
    // attack on a fast hash): seconds = 2^(bits-1) / 1e10.
    const fmtCrack = (bits: number): string => {
      if (bits <= 0) return labels.instant;
      const seconds = Math.pow(2, bits - 1) / 1e10;
      if (!isFinite(seconds)) return labels.trillionYears;
      if (seconds < 1) return labels.instant;
      if (seconds < 60) return `${Math.max(1, Math.floor(seconds))} ${labels.seconds}`;
      const minutes = seconds / 60;
      if (minutes < 60) return `${Math.floor(minutes)} ${labels.minutes}`;
      const hours = minutes / 60;
      if (hours < 24) return `${Math.floor(hours)} ${labels.hours}`;
      const days = hours / 24;
      if (days < 365) return `${Math.floor(days)} ${labels.days}`;
      const years = days / 365;
      if (years < 1000) return `${Math.floor(years)} ${labels.years}`;
      if (years < 1e6) return `${Math.floor(years / 1e3)} ${labels.thousandYears}`;
      if (years < 1e9) return `${Math.floor(years / 1e6)} ${labels.millionYears}`;
      if (years < 1e12) return `${Math.floor(years / 1e9)} ${labels.billionYears}`;
      return labels.trillionYears;
    };

    const analyze = () => {
      const pw = input.value;
      const chars = [...pw];
      let pool = 0;
      if (/[a-z]/.test(pw)) pool += 26;
      if (/[A-Z]/.test(pw)) pool += 26;
      if (/[0-9]/.test(pw)) pool += 10;
      let hasSymbol = false;
      let hasOther = false;
      for (const ch of chars) {
        if (/[a-zA-Z0-9]/.test(ch)) continue;
        if (SYMBOLS.includes(ch)) hasSymbol = true;
        else hasOther = true;
      }
      if (hasSymbol) pool += 32;
      if (hasOther) pool += 50;

      const bits = chars.length > 0 && pool > 0 ? Math.round(chars.length * Math.log2(pool)) : 0;
      bitsEl.textContent = `${bits} ${labels.bits}`;

      let label = '—';
      let color = '#ef4444';
      if (bits > 0) {
        label = labels.weak;
        if (bits >= 80) { label = labels.excellent; color = '#4d90fe'; }
        else if (bits >= 60) { label = labels.strong; color = '#22c55e'; }
        else if (bits >= 40) { label = labels.fair; color = '#f59e0b'; }
      }
      strengthEl.textContent = label;
      bar.style.width = bits > 0 ? `${Math.max(8, Math.min(100, (bits / 128) * 100))}%` : '0%';
      bar.style.background = color;
      crackEl.textContent = fmtCrack(bits);

      const lower = pw.toLowerCase();
      const hasPattern =
        /(.)\1\1/.test(pw) ||
        lower.includes('1234') ||
        lower.includes('abcd') ||
        lower.includes('qwerty') ||
        lower.includes('password') ||
        /(19|20)\d{2}/.test(pw);
      setCheck('length', chars.length >= 12);
      setCheck('case', /[a-z]/.test(pw) && /[A-Z]/.test(pw));
      setCheck('number', /[0-9]/.test(pw));
      setCheck('symbol', hasSymbol);
      setCheck('pattern', pw.length > 0 && !hasPattern);
    };

    input.addEventListener('input', analyze);
    toggle.addEventListener('click', () => {
      const show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      toggle.textContent = show ? labels.hide : labels.show;
    });

    analyze();
  });
</script>
