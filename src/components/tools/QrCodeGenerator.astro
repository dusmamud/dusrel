---
/**
 * QR Code Generator tool island — 100% client-side.
 * Renders with the `qrcode` package in the browser; the text never leaves
 * the device. Used on /pass and /pass/qr-code-generator
 * (EN + HI via the `lang` prop).
 */
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const L = {
  en: {
    inputLabel: 'Text or URL',
    placeholder: 'https://example.com or any text',
    size: 'Size',
    download: 'Download PNG',
    emptyMsg: 'Type something above to see your QR code.',
    errorMsg: 'That text is too long for a QR code. Try something shorter.',
    note: 'The QR code is generated locally in your browser — your text is never sent to a server.',
  },
  hi: {
    inputLabel: 'टेक्स्ट या URL',
    placeholder: 'https://example.com या कोई भी टेक्स्ट',
    size: 'आकार',
    download: 'PNG डाउनलोड करें',
    emptyMsg: 'QR कोड देखने के लिए ऊपर कुछ लिखें।',
    errorMsg: 'टेक्स्ट बहुत लंबा है — QR कोड नहीं बन पाया। थोड़ा छोटा टेक्स्ट आज़माएं।',
    note: 'QR कोड आपके ब्राउज़र में ही बनता है — आपका टेक्स्ट किसी सर्वर पर कभी नहीं जाता।',
  },
} as const;
const t = L[lang];
---

<div
  data-qr
  class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-white/5 md:p-8"
>
  <div>
    <label class="text-sm font-medium text-slate-700 dark:text-slate-300" for="qr-input">{t.inputLabel}</label>
    <textarea
      id="qr-input"
      data-qr-input
      rows="3"
      placeholder={t.placeholder}
      class="mt-2.5 w-full resize-y rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-800 outline-none transition focus:border-[#4d90fe] dark:border-white/20 dark:bg-[#1e1e1e] dark:text-slate-100"
    >https://dusrel.com</textarea>
  </div>

  <div class="mt-6 flex justify-center">
    <div data-qr-wrap class="inline-block rounded-2xl bg-white p-4">
      <canvas data-qr-canvas class="h-auto w-full max-w-[280px]" aria-label="QR code"></canvas>
    </div>
    <p data-qr-empty class="hidden text-center text-sm text-slate-500 dark:text-slate-400">{t.emptyMsg}</p>
  </div>
  <p data-qr-error class="mt-3 hidden text-center text-sm font-medium text-red-500">{t.errorMsg}</p>

  <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-end">
    <div class="flex-1">
      <label class="text-sm font-medium text-slate-700 dark:text-slate-300" for="qr-size">{t.size}</label>
      <select
        id="qr-size"
        data-qr-size
        class="mt-2.5 w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-800 dark:border-white/20 dark:bg-[#1e1e1e] dark:text-slate-100"
      >
        <option value="256">256 × 256 px</option>
        <option value="512" selected>512 × 512 px</option>
        <option value="1024">1024 × 1024 px</option>
      </select>
    </div>
    <button
      type="button"
      data-qr-download
      class="rounded-2xl bg-[#4d90fe] px-8 py-3.5 text-base font-semibold text-white transition-colors hover:bg-[#3b7de0] disabled:opacity-50"
    >
      {t.download}
    </button>
  </div>

  <p class="mt-4 text-center text-xs leading-relaxed text-slate-500 dark:text-slate-400">{t.note}</p>
</div>

<script>
  import QRCode from 'qrcode';

  document.querySelectorAll<HTMLElement>('[data-qr]').forEach((root) => {
    const input = root.querySelector<HTMLTextAreaElement>('[data-qr-input]')!;
    const sizeSel = root.querySelector<HTMLSelectElement>('[data-qr-size]')!;
    const wrap = root.querySelector<HTMLElement>('[data-qr-wrap]')!;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-qr-canvas]')!;
    const emptyEl = root.querySelector<HTMLElement>('[data-qr-empty]')!;
    const errorEl = root.querySelector<HTMLElement>('[data-qr-error]')!;
    const downloadBtn = root.querySelector<HTMLButtonElement>('[data-qr-download]')!;

    const render = () => {
      const text = input.value;
      errorEl.classList.add('hidden');
      if (!text.trim()) {
        wrap.classList.add('hidden');
        emptyEl.classList.remove('hidden');
        downloadBtn.disabled = true;
        return;
      }
      emptyEl.classList.add('hidden');
      wrap.classList.remove('hidden');
      downloadBtn.disabled = false;
      QRCode.toCanvas(
        canvas,
        text,
        {
          width: parseInt(sizeSel.value, 10),
          margin: 2,
          errorCorrectionLevel: 'M',
          color: { dark: '#0f172a', light: '#ffffff' },
        },
        (err) => {
          if (err) {
            wrap.classList.add('hidden');
            errorEl.classList.remove('hidden');
            downloadBtn.disabled = true;
          }
        },
      );
    };

    let timer: ReturnType<typeof setTimeout> | undefined;
    const debounced = () => {
      clearTimeout(timer);
      timer = setTimeout(render, 200);
    };

    input.addEventListener('input', debounced);
    sizeSel.addEventListener('change', render);

    downloadBtn.addEventListener('click', () => {
      const text = input.value;
      if (!text.trim()) return;
      const off = document.createElement('canvas');
      QRCode.toCanvas(
        off,
        text,
        {
          width: parseInt(sizeSel.value, 10),
          margin: 2,
          errorCorrectionLevel: 'M',
          color: { dark: '#0f172a', light: '#ffffff' },
        },
        (err) => {
          if (err) {
            errorEl.classList.remove('hidden');
            return;
          }
          const a = document.createElement('a');
          a.href = off.toDataURL('image/png');
          a.download = 'dusrel-qr-code.png';
          a.click();
        },
      );
    });

    render();
  });
</script>
