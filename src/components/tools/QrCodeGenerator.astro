---
/**
 * QR Code Generator tool island — 100% client-side.
 * The `qrcode` package builds the module matrix; src/lib/qrRender.ts draws
 * it as styled SVG (templates, eye shapes, frames, centre logo). The text
 * and the logo never leave the device. Used on /pass and
 * /pass/qr-code-generator (EN + HI via the `lang` prop).
 *
 * Form-control best practices applied (cross-verified via Exa, 2026-10-31):
 * - USWDS/CMS rule: a dropdown is only for ~7-15 options; with 3-4 options
 *   a segmented radio group wins (all options visible, one click). So every
 *   former <select> here is a native radio group styled as segments.
 * - Labels always visible above controls, never placeholder-as-label.
 * - Text inputs are 16px so iOS Safari does not auto-zoom on focus.
 * - 44px touch targets; visible :focus-visible rings on every control.
 * - Native range slider with a 28px thumb, visible value text + aria-valuetext.
 * - Color swatches show their hex, carry a clear selected ring + aria-pressed,
 *   and the hex itself is an editable, validated text input.
 * - The file input is sr-only (not hidden) so keyboard users can reach it,
 *   and its label shows the focus ring via an adjacent-sibling CSS rule.
 * - Segmented groups are styled with adjacent-sibling CSS (`:checked + label`),
 *   NOT Tailwind's peer-checked: peer uses the general sibling combinator (~),
 *   which would paint every segment after the checked one as selected.
 *
 * Responsive rules applied (cross-verified via Exa, 2026-11-02):
 * - Mobile-first, content-driven breakpoints: single column up to lg, then
 *   the preview column (360px) beside the form; nothing is hidden per screen.
 * - The sticky preview sits at lg:top-24, not top-6: the site header is
 *   sticky (~65px), so top-6 would slide the preview underneath it.
 * - Download buttons stack full-width on phones (grid-cols-1) and sit
 *   side-by-side from 480px up, so "Download PNG" never wraps mid-label.
 * - Card padding steps up with the viewport (p-4 -> sm:p-6 -> md:p-8) so
 *   small phones keep usable content width.
 * - Segment labels are flex-centered, so a wrapped label stays vertically
 *   aligned with its single-line siblings.
 * - 2026-11-02 layout fix (defects found by full-page screenshots, not the
 *   viewport top): the EC + PNG-size grid is sm:grid-cols-2 but
 *   lg:grid-cols-1, because on desktop both groups live in the ~312px left
 *   column where ~148px sub-columns wrapped "M (15%)" and clipped "H (30%)"
 *   entirely, and broke "1024 × 1024" across three lines. The 4-option Frame
 *   group renders as a 2x2 grid at every width for the same reason. Segment
 *   labels carry min-w-0 so a long label wraps instead of silently clipping
 *   behind the group's overflow-hidden.
 */
import type { Lang } from '../../i18n';
import { QR_TEMPLATES } from '../../lib/qrRender';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const L = {
  en: {
    inputLabel: 'Text or URL',
    placeholder: 'https://example.com or any text',
    templates: 'Templates',
    style: 'Style',
    moduleShape: 'Module shape',
    moduleShapeSquare: 'Square',
    moduleShapeRounded: 'Rounded',
    moduleShapeDots: 'Dots',
    eyes: 'Corner eyes',
    eyesSquare: 'Square',
    eyesRounded: 'Rounded',
    eyesCircle: 'Circle',
    frame: 'Frame',
    frameNone: 'None',
    frameScan: 'Scan Me',
    frameCircle: 'Circle',
    frameAperture: 'Aperture',
    colors: 'Colors',
    moduleColor: 'Code color',
    moduleColorHex: 'Code color hex value',
    bgColor: 'Background',
    bgColorHex: 'Background hex value',
    hexError: 'Invalid hex color — use the #rrggbb format.',
    logo: 'Logo',
    uploadLogo: 'Upload logo',
    removeLogo: 'Remove',
    logoSize: 'Logo size',
    logoSizeNote: 'Max 30% — a bigger logo can break scanning.',
    logoHNote: 'With a logo, error correction is fixed at H.',
    logoClamp: 'Logo limited to {pct}% on this small code so the corners stay scannable.',
    logoTooBig: 'Image is too large (max 2 MB).',
    logoNotImage: 'Please choose an image file.',
    ec: 'Error correction',
    pngSize: 'PNG size',
    downloadPng: 'Download PNG',
    downloadSvg: 'Download SVG',
    emptyMsg: 'Type something above to see your QR code.',
    errorMsg: 'That text is too long for a QR code. Try something shorter.',
    dlError: 'Download failed, please try again.',
    contrastWarn: 'Low contrast — this code may be hard to scan.',
    invertedWarn: 'Light code on a dark background — most scanners cannot read this.',
    note: 'The QR code and logo are processed locally in your browser — nothing is ever sent to a server.',
    frameText: 'SCAN ME',
    qrAria: 'QR code',
  },
  hi: {
    inputLabel: 'टेक्स्ट या URL',
    placeholder: 'https://example.com या कोई भी टेक्स्ट',
    templates: 'टेम्पलेट्स',
    style: 'स्टाइल',
    moduleShape: 'मॉड्यूल का आकार',
    moduleShapeSquare: 'वर्गाकार',
    moduleShapeRounded: 'गोल कोने',
    moduleShapeDots: 'बिंदु',
    eyes: 'कॉर्नर आइज़',
    eyesSquare: 'वर्गाकार',
    eyesRounded: 'गोल कोने',
    eyesCircle: 'गोल',
    frame: 'फ़्रेम',
    frameNone: 'कोई नहीं',
    frameScan: 'स्कैन मी',
    frameCircle: 'गोलाकार',
    frameAperture: 'अपर्चर',
    colors: 'रंग',
    moduleColor: 'कोड का रंग',
    moduleColorHex: 'कोड का रंग (hex)',
    bgColor: 'बैकग्राउंड',
    bgColorHex: 'बैकग्राउंड (hex)',
    hexError: 'गलत hex color — #rrggbb फॉर्मेट में लिखें।',
    logo: 'लोगो',
    uploadLogo: 'लोगो अपलोड करें',
    removeLogo: 'हटाएं',
    logoSize: 'लोगो का आकार',
    logoSizeNote: 'अधिकतम 30% — बड़ा लोगो स्कैन खराब कर सकता है।',
    logoHNote: 'लोगो के साथ एरर करेक्शन H पर फिक्स है।',
    logoClamp: 'इस छोटे कोड पर लोगो {pct}% तक सीमित है ताकि कॉर्नर स्कैन हो सकें।',
    logoTooBig: 'इमेज बहुत बड़ी है (अधिकतम 2 MB)।',
    logoNotImage: 'कृपया एक इमेज फ़ाइल चुनें।',
    ec: 'एरर करेक्शन',
    pngSize: 'PNG आकार',
    downloadPng: 'PNG डाउनलोड करें',
    downloadSvg: 'SVG डाउनलोड करें',
    emptyMsg: 'QR कोड देखने के लिए ऊपर कुछ लिखें।',
    errorMsg: 'टेक्स्ट बहुत लंबा है — QR कोड नहीं बन पाया। थोड़ा छोटा टेक्स्ट आज़माएं।',
    dlError: 'डाउनलोड नहीं हो पाया, दोबारा कोशिश करें।',
    contrastWarn: 'कॉन्ट्रास्ट कम है — यह कोड स्कैन होने में मुश्किल हो सकती है।',
    invertedWarn: 'गहरे बैकग्राउंड पर हल्का कोड — ज़्यादातर स्कैनर इसे नहीं पढ़ पाएंगे।',
    note: 'QR कोड और लोगो आपके ब्राउज़र में ही बनते हैं — कुछ भी किसी सर्वर पर नहीं जाता।',
    frameText: 'स्कैन करें',
    qrAria: 'QR कोड',
  },
} as const;
const t = L[lang];

const labelCls = 'text-sm font-medium text-slate-700 dark:text-slate-300';
const sectionCls = 'mt-8 text-sm font-semibold text-slate-800 dark:text-slate-100';
const swatches = ['#0f172a', '#0b4f9c', '#166534', '#9d174d', '#7c3aed', '#b45309'];
const segmentGroupCls =
  'mt-2.5 flex overflow-hidden rounded-xl border border-slate-300 bg-white dark:border-white/20 dark:bg-[#1e1e1e]';
// Frame is the only 4-option group with long labels ("Scan Me", "Aperture"):
// a 1-row strip wraps them in the narrow desktop column (~312px), so Frame
// renders as a 2x2 grid at every width instead — every label keeps full text
// and the control never changes shape while resizing. Cell corners are 11px
// (container 12px minus the 1px border); dividers come from label borders.
const segmentGridCls =
  'mt-2.5 grid grid-cols-2 overflow-hidden rounded-xl border border-slate-300 bg-white dark:border-white/20 dark:bg-[#1e1e1e]';
const segmentLabelCls =
  'flex min-w-0 flex-1 cursor-pointer items-center justify-center border-slate-300 px-2 py-3 text-center text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-white/20 dark:text-slate-200 dark:hover:bg-white/5';
const hexInputCls =
  'h-11 w-[86px] min-w-0 rounded-lg border border-slate-300 bg-white px-2 font-mono text-sm text-slate-800 outline-none focus-visible:border-[#4d90fe] focus-visible:ring-2 focus-visible:ring-[#4d90fe]/40 dark:border-white/20 dark:bg-[#1e1e1e] dark:text-slate-100';
---

<div
  data-qr
  data-qr-frame-text={t.frameText}
  data-qr-aria={t.qrAria}
  data-qr-clamp={t.logoClamp}
  data-qr-logo-not-image={t.logoNotImage}
  data-qr-logo-too-big={t.logoTooBig}
  class="rounded-3xl border border-slate-200 bg-white p-4 shadow-sm dark:border-white/10 dark:bg-white/5 sm:p-6 md:p-8"
>
  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_360px]">
    <!-- Text input (left column, row 1) -->
    <div>
      <label class={labelCls} for="qr-input">{t.inputLabel}</label>
      <textarea
        id="qr-input"
        data-qr-input
        rows="3"
        placeholder={t.placeholder}
        aria-describedby="qr-error"
        class="mt-2.5 w-full resize-y rounded-xl border border-slate-300 bg-white px-4 py-3 text-base text-slate-800 outline-none transition focus-visible:border-[#4d90fe] focus-visible:ring-2 focus-visible:ring-[#4d90fe]/40 dark:border-white/20 dark:bg-[#1e1e1e] dark:text-slate-100"
      >https://dusrel.com</textarea>
    </div>

    <!-- Preview + downloads (right column on desktop, sticky) -->
    <div class="lg:col-start-2 lg:row-start-1 lg:row-span-2">
      <div class="lg:sticky lg:top-24">
        <div class="rounded-2xl bg-white p-4 ring-1 ring-slate-200">
          <div data-qr-preview class="mx-auto w-full max-w-[320px]"></div>
          <p data-qr-empty class="hidden py-10 text-center text-sm text-slate-500">{t.emptyMsg}</p>
        </div>
        <p id="qr-error" data-qr-error class="mt-3 hidden text-center text-sm font-medium text-red-500" role="alert">{t.errorMsg}</p>
        <p data-qr-contrast-warn class="mt-3 hidden text-center text-sm font-medium text-amber-600 dark:text-amber-400" role="alert">{t.contrastWarn}</p>
        <p data-qr-inverted-warn class="mt-3 hidden text-center text-sm font-medium text-red-500" role="alert">{t.invertedWarn}</p>
        <div class="mt-4 grid grid-cols-1 gap-3 min-[480px]:grid-cols-2">
          <button
            type="button"
            data-qr-download-png
            class="touch-manipulation rounded-2xl bg-[#4d90fe] px-4 py-3.5 text-base font-semibold text-white transition-colors hover:bg-[#3b7de0] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#4d90fe]/60 focus-visible:ring-offset-2 disabled:opacity-50"
          >
            {t.downloadPng}
          </button>
          <button
            type="button"
            data-qr-download-svg
            class="touch-manipulation rounded-2xl border border-slate-300 px-4 py-3.5 text-base font-semibold text-slate-700 transition-colors hover:border-[#4d90fe] hover:text-[#4d90fe] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#4d90fe]/60 focus-visible:ring-offset-2 disabled:opacity-50 dark:border-white/20 dark:text-slate-200"
          >
            {t.downloadSvg}
          </button>
        </div>
        <p data-qr-dl-error class="mt-3 hidden text-center text-sm font-medium text-red-500" role="alert">{t.dlError}</p>
        <p class="mt-4 text-center text-xs leading-relaxed text-slate-500 dark:text-slate-400">{t.note}</p>
      </div>
    </div>

    <!-- Customization (left column, row 2) -->
    <div>
      <p class={sectionCls}>{t.templates}</p>
      <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {
          QR_TEMPLATES.map((tpl) => (
            <button
              type="button"
              data-qr-template={tpl.id}
              aria-label={tpl.label}
              class="touch-manipulation rounded-2xl border border-slate-200 bg-white p-2 transition hover:-translate-y-0.5 hover:border-[#4d90fe] hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#4d90fe]/60 data-[active=true]:border-[#4d90fe] data-[active=true]:ring-2 data-[active=true]:ring-[#4d90fe]/40 dark:border-white/10 dark:bg-white/5"
            >
              <span data-qr-mini class="block aspect-square w-full" />
              <span class="mt-1.5 block text-center text-xs font-medium text-slate-700 dark:text-slate-300">{tpl.label}</span>
            </button>
          ))
        }
      </div>

      <p class={sectionCls}>{t.style}</p>
      <div class="mt-3 grid gap-4">
        <div>
          <span id="qr-shape-label" class={labelCls}>{t.moduleShape}</span>
          <div role="radiogroup" aria-labelledby="qr-shape-label" class={segmentGroupCls}>
            <input type="radio" name="qr-shape" id="qr-shape-square" value="square" class="sr-only" />
            <label for="qr-shape-square" class={`${segmentLabelCls} border-r`}>{t.moduleShapeSquare}</label>
            <input type="radio" name="qr-shape" id="qr-shape-rounded" value="rounded" class="sr-only" checked />
            <label for="qr-shape-rounded" class={`${segmentLabelCls} border-r`}>{t.moduleShapeRounded}</label>
            <input type="radio" name="qr-shape" id="qr-shape-dots" value="dots" class="sr-only" />
            <label for="qr-shape-dots" class={segmentLabelCls}>{t.moduleShapeDots}</label>
          </div>
        </div>
        <div>
          <span id="qr-eyes-label" class={labelCls}>{t.eyes}</span>
          <div role="radiogroup" aria-labelledby="qr-eyes-label" class={segmentGroupCls}>
            <input type="radio" name="qr-eyes" id="qr-eyes-square" value="square" class="sr-only" />
            <label for="qr-eyes-square" class={`${segmentLabelCls} border-r`}>{t.eyesSquare}</label>
            <input type="radio" name="qr-eyes" id="qr-eyes-rounded" value="rounded" class="sr-only" checked />
            <label for="qr-eyes-rounded" class={`${segmentLabelCls} border-r`}>{t.eyesRounded}</label>
            <input type="radio" name="qr-eyes" id="qr-eyes-circle" value="circle" class="sr-only" />
            <label for="qr-eyes-circle" class={segmentLabelCls}>{t.eyesCircle}</label>
          </div>
        </div>
        <div>
          <span id="qr-frame-label" class={labelCls}>{t.frame}</span>
          <div role="radiogroup" aria-labelledby="qr-frame-label" class={segmentGridCls}>
            <input type="radio" name="qr-frame" id="qr-frame-none" value="none" class="sr-only" checked />
            <label for="qr-frame-none" class={`${segmentLabelCls} rounded-tl-[11px] border-b border-r`}>{t.frameNone}</label>
            <input type="radio" name="qr-frame" id="qr-frame-scan" value="scan" class="sr-only" />
            <label for="qr-frame-scan" class={`${segmentLabelCls} rounded-tr-[11px] border-b`}>{t.frameScan}</label>
            <input type="radio" name="qr-frame" id="qr-frame-circle" value="circle" class="sr-only" />
            <label for="qr-frame-circle" class={`${segmentLabelCls} rounded-bl-[11px] border-r`}>{t.frameCircle}</label>
            <input type="radio" name="qr-frame" id="qr-frame-aperture" value="aperture" class="sr-only" />
            <label for="qr-frame-aperture" class={`${segmentLabelCls} rounded-br-[11px]`}>{t.frameAperture}</label>
          </div>
        </div>
      </div>

      <p class={sectionCls}>{t.colors}</p>
      <div class="mt-3 grid gap-4 sm:grid-cols-2">
        <div>
          <label class={labelCls} for="qr-fg">{t.moduleColor}</label>
          <div class="mt-2.5 flex items-center gap-2">
            <input
              id="qr-fg"
              type="color"
              data-qr-fg
              value="#0f172a"
              aria-label={t.moduleColor}
              class="h-11 w-14 shrink-0 cursor-pointer rounded-xl border border-slate-300 bg-white p-1 outline-none focus-visible:ring-2 focus-visible:ring-[#4d90fe]/50 dark:border-white/20 dark:bg-[#1e1e1e]"
            />
            <input
              type="text"
              data-qr-fg-hex
              value="#0f172a"
              spellcheck="false"
              autocomplete="off"
              maxlength="7"
              aria-label={t.moduleColorHex}
              class={hexInputCls}
            />
          </div>
          <div class="mt-2 flex flex-wrap gap-2">
            {
              swatches.map((hex) => (
                <button
                  type="button"
                  data-qr-swatch={hex}
                  aria-label={hex}
                  aria-pressed="false"
                  title={hex}
                  style={`background-color:${hex}`}
                  class="h-11 w-11 touch-manipulation rounded-full shadow ring-1 ring-slate-300 transition hover:scale-110 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#4d90fe] focus-visible:ring-offset-2 aria-pressed:ring-2 aria-pressed:ring-[#4d90fe] aria-pressed:ring-offset-2 dark:ring-white/30"
                />
              ))
            }
          </div>
        </div>
        <div>
          <label class={labelCls} for="qr-bg">{t.bgColor}</label>
          <div class="mt-2.5 flex items-center gap-2">
            <input
              id="qr-bg"
              type="color"
              data-qr-bg
              value="#ffffff"
              aria-label={t.bgColor}
              class="h-11 w-14 shrink-0 cursor-pointer rounded-xl border border-slate-300 bg-white p-1 outline-none focus-visible:ring-2 focus-visible:ring-[#4d90fe]/50 dark:border-white/20 dark:bg-[#1e1e1e]"
            />
            <input
              type="text"
              data-qr-bg-hex
              value="#ffffff"
              spellcheck="false"
              autocomplete="off"
              maxlength="7"
              aria-label={t.bgColorHex}
              class={hexInputCls}
            />
          </div>
        </div>
      </div>
      <p data-qr-hex-error class="mt-2 hidden text-xs font-medium text-red-500" role="alert">{t.hexError}</p>

      <p class={sectionCls}>{t.logo}</p>
      <div class="mt-3">
        <div class="flex flex-wrap items-center gap-3">
          <input type="file" id="qr-logo-file" data-qr-logo-file accept="image/*" class="sr-only" />
          <label
            for="qr-logo-file"
            class="cursor-pointer rounded-xl bg-slate-100 px-4 py-3 text-sm font-medium text-slate-700 transition hover:bg-slate-200 dark:bg-white/10 dark:text-slate-200 dark:hover:bg-white/20"
          >
            {t.uploadLogo}
          </label>
          <span data-qr-logo-name class="hidden items-center gap-2">
            <img data-qr-logo-thumb alt="" class="h-10 w-10 rounded-lg bg-white object-contain ring-1 ring-slate-200" />
            <span data-qr-logo-filename class="max-w-[160px] truncate text-sm text-slate-600 dark:text-slate-300"></span>
            <button
              type="button"
              data-qr-logo-remove
              class="rounded-lg px-3 py-2.5 text-sm font-medium text-red-500 transition hover:bg-red-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-400/60 dark:hover:bg-red-500/10"
            >
              {t.removeLogo}
            </button>
          </span>
        </div>
        <div data-qr-logo-size-wrap class="mt-4 hidden">
          <label class={labelCls} for="qr-logo-size">
            {t.logoSize} — <span data-qr-logo-size-val>22%</span>
          </label>
          <input
            id="qr-logo-size"
            type="range"
            data-qr-logo-size
            min="10"
            max="30"
            step="1"
            value="22"
            aria-valuetext="22%"
            class="mt-2.5 w-full cursor-pointer"
          />
          <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">{t.logoSizeNote}</p>
        </div>
        <p data-qr-logo-h-note class="mt-3 hidden text-xs font-medium text-slate-500 dark:text-slate-400">{t.logoHNote}</p>
        <p data-qr-logo-clamp-note class="mt-3 hidden text-xs font-medium text-amber-600 dark:text-amber-400"></p>
        <p data-qr-logo-error class="mt-3 hidden text-sm font-medium text-red-500" role="alert"></p>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
        <div>
          <span id="qr-ec-label" class={labelCls}>{t.ec}</span>
          <div role="radiogroup" aria-labelledby="qr-ec-label" class={segmentGroupCls}>
            <input type="radio" name="qr-ec" id="qr-ec-m" value="M" class="sr-only" checked />
            <label for="qr-ec-m" class={`${segmentLabelCls} border-r`}>M (15%)</label>
            <input type="radio" name="qr-ec" id="qr-ec-q" value="Q" class="sr-only" />
            <label for="qr-ec-q" class={`${segmentLabelCls} border-r`}>Q (25%)</label>
            <input type="radio" name="qr-ec" id="qr-ec-h" value="H" class="sr-only" />
            <label for="qr-ec-h" class={`${segmentLabelCls}`}>H (30%)</label>
          </div>
        </div>
        <div>
          <span id="qr-size-label" class={labelCls}>{t.pngSize}</span>
          <div role="radiogroup" aria-labelledby="qr-size-label" class={segmentGroupCls}>
            <input type="radio" name="qr-size" id="qr-size-256" value="256" class="sr-only" />
            <label for="qr-size-256" class={`${segmentLabelCls} border-r`}>256 px</label>
            <input type="radio" name="qr-size" id="qr-size-512" value="512" class="sr-only" checked />
            <label for="qr-size-512" class={`${segmentLabelCls} border-r`}>512 px</label>
            <input type="radio" name="qr-size" id="qr-size-1024" value="1024" class="sr-only" />
            <label for="qr-size-1024" class={segmentLabelCls}>1024 px</label>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import {
    buildQrSvg,
    hexLuminance,
    qrLuminanceDiff,
    QR_LOGO_DEFAULT_PCT,
    QR_LOGO_MAX_PCT,
    QR_LOGO_MIN_PCT,
    QR_MIN_LUMINANCE_DIFF,
    QR_TEMPLATES,
    type QrECLevel,
    type QrEyeStyle,
    type QrFrameStyle,
    type QrModuleShape,
    type QrStyle,
  } from '../../lib/qrRender';

  const SAMPLE_TEXT = 'https://dusrel.com';
  const MAX_LOGO_BYTES = 2 * 1024 * 1024;
  const HEX_RE = /^#[0-9a-fA-F]{6}$/;

  document.querySelectorAll<HTMLElement>('[data-qr]').forEach((root) => {
    const frameText = root.dataset.qrFrameText ?? 'SCAN ME';
    const ariaLabel = root.dataset.qrAria ?? 'QR code';
    const clampTemplate = root.dataset.qrClamp ?? 'Logo limited to {pct}%.';
    const hexErrorText = root.querySelector<HTMLElement>('[data-qr-hex-error]')?.textContent ?? 'Invalid hex color.';

    const input = root.querySelector<HTMLTextAreaElement>('[data-qr-input]')!;
    const preview = root.querySelector<HTMLElement>('[data-qr-preview]')!;
    const emptyEl = root.querySelector<HTMLElement>('[data-qr-empty]')!;
    const errorEl = root.querySelector<HTMLElement>('[data-qr-error]')!;
    const contrastEl = root.querySelector<HTMLElement>('[data-qr-contrast-warn]')!;
    const invertedEl = root.querySelector<HTMLElement>('[data-qr-inverted-warn]')!;
    const dlErrorEl = root.querySelector<HTMLElement>('[data-qr-dl-error]')!;
    const pngBtn = root.querySelector<HTMLButtonElement>('[data-qr-download-png]')!;
    const svgBtn = root.querySelector<HTMLButtonElement>('[data-qr-download-svg]')!;
    const templateBtns = root.querySelectorAll<HTMLButtonElement>('[data-qr-template]');
    const fgInput = root.querySelector<HTMLInputElement>('[data-qr-fg]')!;
    const bgInput = root.querySelector<HTMLInputElement>('[data-qr-bg]')!;
    const fgHex = root.querySelector<HTMLInputElement>('[data-qr-fg-hex]')!;
    const bgHex = root.querySelector<HTMLInputElement>('[data-qr-bg-hex]')!;
    const hexError = root.querySelector<HTMLElement>('[data-qr-hex-error]')!;
    const swatchBtns = root.querySelectorAll<HTMLButtonElement>('[data-qr-swatch]');
    const logoFile = root.querySelector<HTMLInputElement>('[data-qr-logo-file]')!;
    const logoName = root.querySelector<HTMLElement>('[data-qr-logo-name]')!;
    const logoThumb = root.querySelector<HTMLImageElement>('[data-qr-logo-thumb]')!;
    const logoFilename = root.querySelector<HTMLElement>('[data-qr-logo-filename]')!;
    const logoRemove = root.querySelector<HTMLButtonElement>('[data-qr-logo-remove]')!;
    const logoSizeWrap = root.querySelector<HTMLElement>('[data-qr-logo-size-wrap]')!;
    const logoSize = root.querySelector<HTMLInputElement>('[data-qr-logo-size]')!;
    const logoSizeVal = root.querySelector<HTMLElement>('[data-qr-logo-size-val]')!;
    const logoHNote = root.querySelector<HTMLElement>('[data-qr-logo-h-note]')!;
    const logoClampNote = root.querySelector<HTMLElement>('[data-qr-logo-clamp-note]')!;
    const logoError = root.querySelector<HTMLElement>('[data-qr-logo-error]')!;

    const state: {
      style: QrStyle;
      ec: QrECLevel;
      size: number;
      logo: string | null;
      logoPct: number;
    } = {
      style: { moduleShape: 'rounded', eyeStyle: 'rounded', frame: 'none', moduleColor: '#0f172a', bgColor: '#ffffff' },
      ec: 'M',
      size: 512,
      logo: null,
      logoPct: QR_LOGO_DEFAULT_PCT,
    };

    const show = (el: HTMLElement, visible: boolean): void => {
      el.classList.toggle('hidden', !visible);
    };
    const showFlex = (el: HTMLElement, visible: boolean): void => {
      el.classList.toggle('hidden', !visible);
      el.classList.toggle('flex', visible);
    };
    const setDownloadsEnabled = (enabled: boolean): void => {
      pngBtn.disabled = !enabled;
      svgBtn.disabled = !enabled;
    };
    const setRadio = (name: string, value: string): void => {
      const el = root.querySelector<HTMLInputElement>(`input[name="${name}"][value="${value}"]`);
      if (el) el.checked = true;
    };
    const setRadiosDisabled = (name: string, disabled: boolean): void => {
      root.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`).forEach((el) => {
        el.disabled = disabled;
      });
    };
    const syncSwatchPressed = (): void => {
      for (const btn of swatchBtns) {
        btn.setAttribute('aria-pressed', btn.dataset.qrSwatch === state.style.moduleColor ? 'true' : 'false');
      }
    };
    const clearHexInvalid = (el: HTMLInputElement): void => {
      el.removeAttribute('aria-invalid');
      el.classList.remove('border-red-500!');
      show(hexError, false);
    };
    const markHexInvalid = (el: HTMLInputElement): void => {
      el.setAttribute('aria-invalid', 'true');
      el.classList.add('border-red-500!');
      hexError.textContent = hexErrorText;
      show(hexError, true);
    };

    const currentOpts = (sizing: 'responsive' | 'fill' | 'absolute') => ({
      ...state.style,
      ec: state.ec,
      frameText,
      ariaLabel,
      logo: state.logo ? { dataUrl: state.logo, pct: state.logoPct } : null,
      sizing,
    });

    const render = (): void => {
      const text = input.value;
      show(dlErrorEl, false);
      if (!text.trim()) {
        show(preview, false);
        show(emptyEl, true);
        show(errorEl, false);
        show(contrastEl, false);
        show(invertedEl, false);
        show(logoClampNote, false);
        input.removeAttribute('aria-invalid');
        input.classList.remove('border-red-500!');
        setDownloadsEnabled(false);
        return;
      }
      const result = buildQrSvg(text, currentOpts('responsive'));
      if (!result) {
        show(preview, false);
        show(emptyEl, false);
        show(errorEl, true);
        show(contrastEl, false);
        show(invertedEl, false);
        show(logoClampNote, false);
        input.setAttribute('aria-invalid', 'true');
        input.classList.add('border-red-500!');
        setDownloadsEnabled(false);
        return;
      }
      show(emptyEl, false);
      show(errorEl, false);
      show(preview, true);
      preview.innerHTML = result.svg;
      input.removeAttribute('aria-invalid');
      input.classList.remove('border-red-500!');
      setDownloadsEnabled(true);

      // Contrast warnings: warn, never block — the user decides.
      const inverted = hexLuminance(state.style.moduleColor) > hexLuminance(state.style.bgColor);
      const lowContrast = qrLuminanceDiff(state.style.moduleColor, state.style.bgColor) < QR_MIN_LUMINANCE_DIFF;
      show(invertedEl, inverted);
      show(contrastEl, !inverted && lowContrast);

      if (result.logoClamped && result.logoPct !== null) {
        logoClampNote.textContent = clampTemplate.replace('{pct}', String(result.logoPct));
        show(logoClampNote, true);
        logoSize.value = String(result.logoPct);
        logoSizeVal.textContent = `${result.logoPct}%`;
        logoSize.setAttribute('aria-valuetext', `${result.logoPct}%`);
      } else {
        show(logoClampNote, false);
      }

      for (const btn of templateBtns) {
        const tpl = QR_TEMPLATES.find((t) => t.id === btn.dataset.qrTemplate);
        btn.dataset.active =
          tpl !== undefined &&
          tpl.moduleShape === state.style.moduleShape &&
          tpl.eyeStyle === state.style.eyeStyle &&
          tpl.frame === state.style.frame &&
          tpl.moduleColor === state.style.moduleColor &&
          tpl.bgColor === state.style.bgColor
            ? 'true'
            : 'false';
      }
    };

    // Template thumbnails: rendered once from a fixed sample — they show the
    // template's own look and never change while typing.
    for (const btn of templateBtns) {
      const tpl = QR_TEMPLATES.find((t) => t.id === btn.dataset.qrTemplate);
      const slot = btn.querySelector<HTMLElement>('[data-qr-mini]');
      if (tpl && slot) {
        const mini = buildQrSvg(SAMPLE_TEXT, { ...tpl, ec: 'M', frameText, ariaLabel, sizing: 'fill' });
        if (mini) slot.innerHTML = mini.svg;
      }
    }

    const applyTemplate = (id: string): void => {
      const tpl = QR_TEMPLATES.find((t) => t.id === id);
      if (!tpl) return;
      state.style = {
        moduleShape: tpl.moduleShape,
        eyeStyle: tpl.eyeStyle,
        frame: tpl.frame,
        moduleColor: tpl.moduleColor,
        bgColor: tpl.bgColor,
      };
      setRadio('qr-shape', tpl.moduleShape);
      setRadio('qr-eyes', tpl.eyeStyle);
      setRadio('qr-frame', tpl.frame);
      fgInput.value = tpl.moduleColor;
      bgInput.value = tpl.bgColor;
      fgHex.value = tpl.moduleColor;
      bgHex.value = tpl.bgColor;
      clearHexInvalid(fgHex);
      clearHexInvalid(bgHex);
      syncSwatchPressed();
      render();
    };

    const applyHex = (el: HTMLInputElement, which: 'fg' | 'bg'): void => {
      const v = el.value.trim();
      if (!HEX_RE.test(v)) {
        markHexInvalid(el);
        return;
      }
      const hex = v.toLowerCase();
      el.value = hex;
      clearHexInvalid(el);
      if (which === 'fg') {
        fgInput.value = hex;
        state.style.moduleColor = hex;
        syncSwatchPressed();
      } else {
        bgInput.value = hex;
        state.style.bgColor = hex;
      }
      render();
    };

    let timer: ReturnType<typeof setTimeout> | undefined;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(render, 200);
    });
    for (const btn of templateBtns) {
      btn.addEventListener('click', () => applyTemplate(btn.dataset.qrTemplate ?? ''));
    }
    const onRadioGroup = (name: string, apply: (value: string) => void): void => {
      root.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`).forEach((el) => {
        el.addEventListener('change', () => {
          if (el.checked) apply(el.value);
        });
      });
    };
    onRadioGroup('qr-shape', (value) => {
      state.style.moduleShape = value as QrModuleShape;
      render();
    });
    onRadioGroup('qr-eyes', (value) => {
      state.style.eyeStyle = value as QrEyeStyle;
      render();
    });
    onRadioGroup('qr-frame', (value) => {
      state.style.frame = value as QrFrameStyle;
      render();
    });
    onRadioGroup('qr-ec', (value) => {
      state.ec = value as QrECLevel;
      render();
    });
    onRadioGroup('qr-size', (value) => {
      state.size = Number.parseInt(value, 10) || 512;
    });
    fgInput.addEventListener('input', () => {
      state.style.moduleColor = fgInput.value;
      fgHex.value = fgInput.value;
      clearHexInvalid(fgHex);
      syncSwatchPressed();
      render();
    });
    bgInput.addEventListener('input', () => {
      state.style.bgColor = bgInput.value;
      bgHex.value = bgInput.value;
      clearHexInvalid(bgHex);
      render();
    });
    fgHex.addEventListener('change', () => applyHex(fgHex, 'fg'));
    bgHex.addEventListener('change', () => applyHex(bgHex, 'bg'));
    fgHex.addEventListener('input', () => clearHexInvalid(fgHex));
    bgHex.addEventListener('input', () => clearHexInvalid(bgHex));
    for (const btn of swatchBtns) {
      btn.addEventListener('click', () => {
        const hex = btn.dataset.qrSwatch ?? '#0f172a';
        fgInput.value = hex;
        fgHex.value = hex;
        state.style.moduleColor = hex;
        clearHexInvalid(fgHex);
        syncSwatchPressed();
        render();
      });
    }

    const formatBytes = (bytes: number): string =>
      bytes < 1024 ? `${bytes} B` : `${(bytes / 1024).toFixed(bytes < 10240 ? 1 : 0)} KB`;
    const setLogoUi = (visible: boolean): void => {
      showFlex(logoName, visible);
      show(logoSizeWrap, visible);
      show(logoHNote, visible);
    };
    logoFile.addEventListener('change', () => {
      const file = logoFile.files?.[0];
      show(logoError, false);
      if (!file) return;
      if (!file.type.startsWith('image/')) {
        logoError.textContent = root.dataset.qrLogoNotImage ?? 'Please choose an image file.';
        show(logoError, true);
        logoFile.value = '';
        return;
      }
      if (file.size > MAX_LOGO_BYTES) {
        logoError.textContent = root.dataset.qrLogoTooBig ?? 'Image is too large (max 2 MB).';
        show(logoError, true);
        logoFile.value = '';
        return;
      }
      const reader = new FileReader();
      reader.onload = () => {
        const dataUrl = reader.result;
        if (typeof dataUrl !== 'string') return;
        state.logo = dataUrl;
        // A logo always forces error correction H — and the state now says so
        // too, so the displayed selection and the rendered code can no longer
        // disagree when the logo is removed later.
        state.ec = 'H';
        logoThumb.src = dataUrl;
        logoFilename.textContent = `${file.name} · ${formatBytes(file.size)}`;
        setLogoUi(true);
        setRadio('qr-ec', 'H');
        setRadiosDisabled('qr-ec', true);
        render();
      };
      reader.readAsDataURL(file);
    });
    logoRemove.addEventListener('click', () => {
      state.logo = null;
      logoFile.value = '';
      setLogoUi(false);
      show(logoClampNote, false);
      setRadiosDisabled('qr-ec', false);
      render();
    });
    logoSize.addEventListener('input', () => {
      const pct = Math.max(QR_LOGO_MIN_PCT, Math.min(QR_LOGO_MAX_PCT, Number.parseInt(logoSize.value, 10) || QR_LOGO_DEFAULT_PCT));
      state.logoPct = pct;
      logoSizeVal.textContent = `${pct}%`;
      logoSize.setAttribute('aria-valuetext', `${pct}%`);
      render();
    });

    const downloadBlob = (blob: Blob, filename: string): void => {
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      a.click();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    };
    svgBtn.addEventListener('click', () => {
      if (!input.value.trim()) return;
      const result = buildQrSvg(input.value, currentOpts('absolute'));
      if (!result) {
        show(dlErrorEl, true);
        return;
      }
      downloadBlob(new Blob([result.svg], { type: 'image/svg+xml;charset=utf-8' }), 'dusrel-qr-code.svg');
    });
    pngBtn.addEventListener('click', async () => {
      if (!input.value.trim()) return;
      const result = buildQrSvg(input.value, currentOpts('absolute'));
      if (!result) {
        show(dlErrorEl, true);
        return;
      }
      try {
        const svgUrl = URL.createObjectURL(new Blob([result.svg], { type: 'image/svg+xml;charset=utf-8' }));
        const img = new Image();
        await new Promise<void>((resolve, reject) => {
          img.onload = () => resolve();
          img.onerror = () => reject(new Error('svg load failed'));
          img.src = svgUrl;
        });
        URL.revokeObjectURL(svgUrl);
        const size = state.size;
        const canvas = document.createElement('canvas');
        canvas.width = size;
        canvas.height = size;
        const ctx = canvas.getContext('2d');
        if (!ctx) throw new Error('no 2d context');
        ctx.fillStyle = state.style.bgColor;
        ctx.fillRect(0, 0, size, size);
        const scale = Math.min(size / result.vbW, size / result.vbH);
        const w = result.vbW * scale;
        const h = result.vbH * scale;
        ctx.drawImage(img, (size - w) / 2, (size - h) / 2, w, h);
        canvas.toBlob((blob) => {
          if (!blob) {
            show(dlErrorEl, true);
            return;
          }
          downloadBlob(blob, 'dusrel-qr-code.png');
        }, 'image/png');
      } catch {
        show(dlErrorEl, true);
      }
    });

    syncSwatchPressed();
    render();
  });
</script>

<style>
  /* Segmented radio groups: the adjacent-sibling combinator (+) styles ONLY
     the label belonging to the checked/focused/disabled input. Tailwind's
     peer-checked must not be used here — it uses ~ and would paint every
     segment after the checked one as selected. */
  [data-qr] input[type='radio']:checked + label {
    background-color: #4d90fe;
    border-color: #4d90fe;
    color: #ffffff;
  }
  [data-qr] input[type='radio']:focus-visible + label {
    position: relative;
    z-index: 10;
    box-shadow: inset 0 0 0 2px #4d90fe;
  }
  [data-qr] input[type='radio']:disabled + label {
    cursor: not-allowed;
    opacity: 0.5;
  }
  /* File upload: the sr-only input stays keyboard-focusable; its label
     (the visible button) shows the focus ring. */
  [data-qr] input[type='file']:focus-visible + label {
    outline: 3px solid #4d90fe;
    outline-offset: 2px;
  }
  /* Native range slider: 28px thumb (WCAG 2.5.8 wants 24px+, touch wants 44px
     hit area — the thumb plus its surrounding track padding gets close while
     staying visually light), blue thumb with a white edge for 3:1 contrast
     against the track, and a clear focus-visible outline. */
  [data-qr] input[type='range'] {
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    height: 28px;
  }
  [data-qr] input[type='range']::-webkit-slider-runnable-track {
    height: 8px;
    border-radius: 9999px;
    background: #e2e8f0;
  }
  [data-qr] input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 28px;
    height: 28px;
    margin-top: -10px;
    border-radius: 9999px;
    background: #4d90fe;
    border: 3px solid #ffffff;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.3);
    cursor: pointer;
  }
  [data-qr] input[type='range']::-moz-range-track {
    height: 8px;
    border-radius: 9999px;
    background: #e2e8f0;
  }
  [data-qr] input[type='range']::-moz-range-thumb {
    width: 28px;
    height: 28px;
    border-radius: 9999px;
    background: #4d90fe;
    border: 3px solid #ffffff;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.3);
    cursor: pointer;
  }
  [data-qr] input[type='range']:focus-visible {
    outline: 3px solid #4d90fe;
    outline-offset: 4px;
  }
</style>
