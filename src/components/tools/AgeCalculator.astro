---
/**
 * Age Calculator tool island — 100% client-side.
 * Exact age in years/months/days (with proper month/day borrowing), total
 * days and weeks lived, and the next birthday countdown. Dates never
 * leave the device. Used on /pass and /pass/age-calculator (EN + HI).
 *
 * Date-entry UX (cross-verified via Exa against GOV.UK Design System,
 * USWDS memorable-date pattern, NN/g date-input guidelines and ONS):
 * - Date of birth is a memorable date from the distant past, so it uses
 *   three separate labelled text fields (day / month / year) instead of
 *   a calendar picker — navigating decades in a calendar is slow and
 *   painful, and dropdowns for day/year add needless clicks.
 * - Fields are type="text" with inputmode="numeric" (numeric keyboard on
 *   mobile, no number-input spinner/stepper problems), maxlength 2/2/4,
 *   and autocomplete bday-day / bday-month / bday-year (WCAG 2.1 AA).
 * - Calculation is NEVER live: typing never calculates and never
 *   shows errors (Baymard, Smashing Magazine, Adam Silver — live
 *   validation interrupts users before they finish typing). The age
 *   is calculated only on the explicit "Calculate age" button click
 *   (or Enter in a field). Editing any field after a calculation
 *   clears the stale result, so a wrong number is never shown as
 *   current.
 * - Focus IS auto-advanced, but only when the field is full AND
 *   valid (cross-verified via Exa: Kendo segmented date inputs
 *   advance "once a valid value is entered"; GOV.UK refuses values
 *   that "cannot be correct", e.g. month 13): a full but
 *   out-of-range value (day 32, month 13, year 0000) turns its box
 *   red and does NOT advance, so focus never leaves a value the
 *   user still needs to fix. Advance stays within its own date
 *   group, never across groups, never auto-calculating. Backspace
 *   in an empty field moves back, Tab / Shift+Tab / click always
 *   work normally. No advance warning is shown — the pattern is
 *   now a familiar convention (OTP/date segments) and the user
 *   explicitly asked to remove the hint.
 * - Field-level validity is shown live ONLY as a red border, and
 *   only for complete values that can never become valid; error
 *   messages still appear only on Calculate (GOV.UK: do not
 *   validate before the user has finished entering). A red border
 *   clears the moment the value becomes valid again.
 * - Leading zeros are never required in any field.
 * - The "as of" date uses the same three-field pattern, pre-filled
 *   with today's date by default (it can still be changed to any date,
 *   e.g. to see your age on a past or future date).
 * - Date format is detected AUTOMATICALLY, no manual selection,
 *   users never pick a country, no network request, no IP lookup.
 *   The PRIMARY signal is the device TIMEZONE (user's decision):
 *   instant, private, VPN-proof (a VPN does not change the OS
 *   timezone) — so an Indian user gets DMY even with an en-US
 *   browser. Browser locale (Intl formatToParts) is only the
 *   fallback when no timezone is available, then DMY, the
 *   worldwide majority. Timezone sets are complete for every
 *   MDY/YMD country, so any other valid zone is safely DMY.
 */
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const L = {
  en: {
    dateOfBirth: 'Date of birth',
    day: 'Day',
    month: 'Month',
    year: 'Year',
    asOf: 'As of date',
    calculate: 'Calculate age',
    years: 'Years',
    months: 'Months',
    days: 'Days',
    totalDays: 'Total days lived',
    totalWeeks: 'Total weeks lived',
    nextBirthday: 'Next birthday',
    inDays: 'in {n} days',
    today: "It's today! 🎂",
    errorFuture: 'Date of birth cannot be after the "as of" date.',
    errorEmpty: 'Please enter your date of birth.',
    errorInvalid: 'Enter a real date of birth.',
    errorAsOf: "Enter a real 'as of' date.",
    errorDayRange: 'Day must be between 1 and 31',
    errorMonthRange: 'Month must be between 1 and 12',
    errorYearDigits: 'Year must be 4 digits',
    note: 'Your dates never leave your device — the calculation happens entirely in your browser.',
    shareResult: 'Share Result',
    shareGenerating: 'Generating…',
    shareCopy: 'Copy image',
    shareCopied: 'Copied!',
    shareDownloaded: 'Image downloaded.',
    shareFailed: 'Could not create the image. Try again.',
    shareMyAgeIs: 'My Age is',
    shareTotalDays: 'Total Days',
    shareMessage: 'I just calculated my exact age, right down to the day! Find yours in seconds:',
    shareVia: 'Share via',
    shareAttachHint: 'Image downloaded — attach it to the chat.',
    shareInstagramDone: 'Image downloaded and message copied — paste it into your Instagram DM.',
  },
  hi: {
    dateOfBirth: 'जन्म तिथि',
    day: 'दिन',
    month: 'महीना',
    year: 'वर्ष',
    asOf: 'गणना की तिथि',
    calculate: 'उम्र निकालें',
    years: 'वर्ष',
    months: 'महीने',
    days: 'दिन',
    totalDays: 'कुल जीए गए दिन',
    totalWeeks: 'कुल सप्ताह',
    nextBirthday: 'अगला जन्मदिन',
    inDays: '{n} दिनों में',
    today: 'आज ही है! 🎂',
    errorFuture: 'जन्म तिथि गणना की तिथि से बाद की नहीं हो सकती।',
    errorEmpty: 'कृपया अपनी जन्म तिथि डालें।',
    errorInvalid: 'सही जन्म तिथि डालें।',
    errorAsOf: 'सही गणना तिथि डालें।',
    errorDayRange: 'दिन 1 से 31 के बीच होना चाहिए',
    errorMonthRange: 'महीना 1 से 12 के बीच होना चाहिए',
    errorYearDigits: 'वर्ष 4 अंकों का होना चाहिए',
    note: 'आपकी तारीखें आपके डिवाइस से बाहर कभी नहीं जातीं — सारी गणना पूरी तरह आपके ब्राउज़र में होती है।',
    shareResult: 'Parinaam share karein',
    shareGenerating: 'Ban raha hai…',
    shareCopy: 'Image copy karein',
    shareCopied: 'Copy ho gaya!',
    shareDownloaded: 'Image download ho gayi.',
    shareFailed: 'Image nahi ban payi. Dobara koshish karein.',
    shareMyAgeIs: 'Meri umar hai',
    shareTotalDays: 'Kul din',
    shareMessage: 'मैंने अभी अपनी सटीक उम्र निकाली है, दिन तक! आप भी कुछ सेकंड में निकालें:',
    shareVia: 'Share karein',
    shareAttachHint: 'Image download ho gayi — chat me attach kar do.',
    shareInstagramDone: 'Image download ho gayi aur message copy ho gaya — Instagram DM me paste karo.',
  },
} as const;
const t = L[lang];

// Field order follows the locale convention: en-US is month/day/year,
// hi-IN is day/month/year. Labels make the order unambiguous either way.
const dobFields =
  lang === 'hi'
    ? ([
        { key: 'day', label: t.day, auto: 'bday-day', width: 'w-20' },
        { key: 'month', label: t.month, auto: 'bday-month', width: 'w-20' },
        { key: 'year', label: t.year, auto: 'bday-year', width: 'w-28' },
      ] as const)
    : ([
        { key: 'month', label: t.month, auto: 'bday-month', width: 'w-20' },
        { key: 'day', label: t.day, auto: 'bday-day', width: 'w-20' },
        { key: 'year', label: t.year, auto: 'bday-year', width: 'w-28' },
      ] as const);

// Same locale field order as DOB, but no birthday autocomplete: this is
// a reference date, not a date of birth.
const asOfFields =
  lang === 'hi'
    ? ([
        { key: 'day', label: t.day, width: 'w-20' },
        { key: 'month', label: t.month, width: 'w-20' },
        { key: 'year', label: t.year, width: 'w-28' },
      ] as const)
    : ([
        { key: 'month', label: t.month, width: 'w-20' },
        { key: 'day', label: t.day, width: 'w-20' },
        { key: 'year', label: t.year, width: 'w-28' },
      ] as const);

const dobFieldCls =
  'mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-3 text-center text-base text-slate-800 focus:border-[#4d90fe] focus:outline-none dark:border-white/20 dark:bg-[#1e1e1e] dark:text-slate-100';
---

<div
  data-age
  data-locale={lang === 'hi' ? 'hi-IN' : 'en-US'}
  data-labels={JSON.stringify({ nextBirthday: t.nextBirthday, inDays: t.inDays, today: t.today, errorFuture: t.errorFuture, errorEmpty: t.errorEmpty, errorInvalid: t.errorInvalid, errorAsOf: t.errorAsOf, errorDayRange: t.errorDayRange, errorMonthRange: t.errorMonthRange, errorYearDigits: t.errorYearDigits, shareGenerating: t.shareGenerating, shareCopied: t.shareCopied, shareDownloaded: t.shareDownloaded, shareFailed: t.shareFailed, shareMyAgeIs: t.shareMyAgeIs, shareTotalDays: t.shareTotalDays, shareMessage: t.shareMessage, shareAttachHint: t.shareAttachHint, shareInstagramDone: t.shareInstagramDone })}
  class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-white/5 md:p-8"
>
  <div class="grid gap-5 sm:grid-cols-2">
    <fieldset data-age-dob-group>
      <legend class="text-sm font-medium text-slate-700 dark:text-slate-300">{t.dateOfBirth}</legend>
      <div class="flex items-start gap-2.5" data-fields-row>
        {
          dobFields.map((f) => (
            <div class={f.width} data-field={f.key}>
              <label class="mt-2 block text-xs font-medium text-slate-500 dark:text-slate-400" for={`age-dob-${f.key}`}>
                {f.label}
              </label>
              <input
                id={`age-dob-${f.key}`}
                data-dob={f.key}
                type="text"
                inputmode="numeric"
                pattern="[0-9]*"
                maxlength={f.key === 'year' ? 4 : 2}
                autocomplete={f.auto}
                placeholder={f.key === 'year' ? 'YYYY' : f.key === 'day' ? 'DD' : 'MM'}
                aria-label={f.label}
                class={dobFieldCls}
              />
            </div>
          ))
        }
      </div>
    </fieldset>
    <fieldset data-age-asof-group>
      <legend class="text-sm font-medium text-slate-700 dark:text-slate-300">{t.asOf}</legend>
      <div class="flex items-start gap-2.5" data-fields-row>
        {
          asOfFields.map((f) => (
            <div class={f.width} data-field={f.key}>
              <label class="mt-2 block text-xs font-medium text-slate-500 dark:text-slate-400" for={`age-asof-${f.key}`}>
                {f.label}
              </label>
              <input
                id={`age-asof-${f.key}`}
                data-asof={f.key}
                type="text"
                inputmode="numeric"
                pattern="[0-9]*"
                maxlength={f.key === 'year' ? 4 : 2}
                autocomplete="off"
                placeholder={f.key === 'year' ? 'YYYY' : f.key === 'day' ? 'DD' : 'MM'}
                aria-label={f.label}
                class={dobFieldCls}
              />
            </div>
          ))
        }
      </div>
    </fieldset>
  </div>

  <button
    type="button"
    data-age-calc
    class="mt-6 w-full rounded-2xl bg-[#4d90fe] px-8 py-3.5 text-base font-semibold text-white transition-colors hover:bg-[#3b7de0]"
  >
    {t.calculate}
  </button>

  <p data-age-error class="mt-4 hidden text-center text-sm font-medium text-red-500" role="alert"></p>

  <div class="mt-7 grid grid-cols-3 gap-3">
    <div class="rounded-2xl border border-slate-200 px-4 py-4 text-center dark:border-white/10">
      <p data-age-years class="text-3xl font-bold text-slate-900 dark:text-white md:text-4xl">0</p>
      <p class="mt-1 text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">{t.years}</p>
    </div>
    <div class="rounded-2xl border border-slate-200 px-4 py-4 text-center dark:border-white/10">
      <p data-age-months class="text-3xl font-bold text-slate-900 dark:text-white md:text-4xl">0</p>
      <p class="mt-1 text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">{t.months}</p>
    </div>
    <div class="rounded-2xl border border-slate-200 px-4 py-4 text-center dark:border-white/10">
      <p data-age-days class="text-3xl font-bold text-slate-900 dark:text-white md:text-4xl">0</p>
      <p class="mt-1 text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">{t.days}</p>
    </div>
  </div>

  <dl class="mt-6 space-y-2.5 rounded-2xl bg-slate-50 px-5 py-4 text-sm dark:bg-black/30">
    <div class="flex items-center justify-between gap-4">
      <dt class="text-slate-500 dark:text-slate-400">{t.totalDays}</dt>
      <dd data-age-totaldays class="font-semibold text-slate-900 dark:text-white">—</dd>
    </div>
    <div class="flex items-center justify-between gap-4">
      <dt class="text-slate-500 dark:text-slate-400">{t.totalWeeks}</dt>
      <dd data-age-totalweeks class="font-semibold text-slate-900 dark:text-white">—</dd>
    </div>
    <div class="flex items-center justify-between gap-4">
      <dt class="text-slate-500 dark:text-slate-400">{t.nextBirthday}</dt>
      <dd data-age-next class="text-right font-semibold text-slate-900 dark:text-white">—</dd>
    </div>
  </dl>

  <div class="mt-6 flex flex-col gap-3">
    <button
      type="button"
      data-age-share
      disabled
      class="w-full rounded-2xl border border-slate-300 px-8 py-3.5 text-base font-semibold text-slate-700 transition-colors hover:border-[#4d90fe] hover:text-[#4d90fe] disabled:cursor-not-allowed disabled:opacity-50 dark:border-white/20 dark:text-slate-200"
    >
      {t.shareResult}
    </button>
    <button
      type="button"
      data-age-copy
      class="hidden w-full rounded-2xl px-8 py-2 text-sm font-medium text-slate-500 transition-colors hover:text-[#4d90fe] dark:text-slate-400"
    >
      {t.shareCopy}
    </button>
    <div class="mt-1">
      <p class="mb-2 text-center text-xs font-medium text-slate-500 dark:text-slate-400">{t.shareVia}</p>
      <div class="grid grid-cols-4 gap-2">
        <button
          type="button"
          data-age-share-wa
          disabled
          class="rounded-xl bg-[#25d366] px-2 py-2.5 text-sm font-semibold text-white transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
        >
          WhatsApp
        </button>
        <button
          type="button"
          data-age-share-ig
          disabled
          class="rounded-xl bg-gradient-to-tr from-[#f58529] via-[#dd2a7b] to-[#8134af] px-2 py-2.5 text-sm font-semibold text-white transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
        >
          Instagram
        </button>
        <button
          type="button"
          data-age-share-tg
          disabled
          class="rounded-xl bg-[#229ed9] px-2 py-2.5 text-sm font-semibold text-white transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
        >
          Telegram
        </button>
        <button
          type="button"
          data-age-share-x
          disabled
          class="rounded-xl bg-slate-900 px-2 py-2.5 text-sm font-semibold text-white transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50 dark:bg-white dark:text-slate-900"
        >
          X
        </button>
      </div>
    </div>
    <p data-age-share-status class="hidden text-center text-sm text-slate-500 dark:text-slate-400" role="status"></p>
  </div>

  <p class="mt-4 text-center text-xs leading-relaxed text-slate-500 dark:text-slate-400">{t.note}</p>

  <!-- Share card: rendered off-screen at exactly 1200x1200 and captured
    client-side into the share PNG. Never display:none: a hidden node
    has no layout box to capture. The fixed wrapper only moves it out
    of the visible viewport; the captured node itself keeps real
    dimensions. All values are filled from the calculator result right
    before capture, so no sample numbers can ever leak into a share.
    Headline lines carry an explicit width + nowrap: a shrink-to-fit
    absolute <p> wrapped in the capture when the embedded font rendered
    a pixel wider (seen live 2026-10-31: 'Years' dropped onto the
    months line), so wrapping must be impossible by construction. -->
  <div
    data-age-share-wrap
    aria-hidden="true"
    style="position:fixed;top:0;left:-1300px;width:1200px;height:1200px;overflow:hidden;pointer-events:none;"
  >
    <div data-age-share-card style="position:relative;width:1200px;height:1200px;background:#ffffff;overflow:hidden;">
      <img
        data-age-share-bg
        src="/age-share/age-share-bg.png"
        alt=""
        width="1200"
        height="1200"
        style="position:absolute;inset:0;width:1200px;height:1200px;"
      />
      <p
        data-age-share-myage
        style="position:absolute;left:66px;top:262px;width:1068px;white-space:nowrap;font-family:'Sora',sans-serif;font-size:56px;font-weight:600;line-height:1;color:#616a87;"
      >
        {t.shareMyAgeIs}
      </p>
      <p
        style="position:absolute;left:66px;top:330px;width:1068px;white-space:nowrap;font-family:'Sora',sans-serif;font-size:154px;font-weight:800;line-height:1;letter-spacing:-0.02em;"
      >
        <span data-age-share-years style="color:#1272fa;">0</span> <span data-age-share-years-label style="color:#061536;">{t.years}</span>
      </p>
      <p
        style="position:absolute;left:66px;top:530px;width:1068px;white-space:nowrap;font-family:'Sora',sans-serif;font-size:56px;font-weight:700;line-height:1;color:#061437;"
      >
        <span data-age-share-months>0</span> <span data-age-share-months-label>{t.months}</span> <span data-age-share-days>0</span> <span data-age-share-days-label>{t.days}</span>
      </p>
      <div style="position:absolute;left:74px;top:647px;width:1052px;display:flex;gap:22px;">
        <div style="flex:1;height:290px;background:#ffffff;border:1px solid #dbe4f0;border-radius:24px;display:flex;flex-direction:column;align-items:center;padding-top:40px;">
          <div style="width:88px;height:88px;border-radius:9999px;background:#dbeafe;display:flex;align-items:center;justify-content:center;">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
          </div>
          <p data-age-share-card-years style="margin-top:16px;font-family:'Sora',sans-serif;font-size:64px;font-weight:800;line-height:1;color:#061536;">0</p>
          <p style="margin-top:10px;font-family:'Inter',sans-serif;font-size:24px;line-height:1;color:#616a87;">{t.years}</p>
        </div>
        <div style="flex:1;height:290px;background:#ffffff;border:1px solid #dbe4f0;border-radius:24px;display:flex;flex-direction:column;align-items:center;padding-top:40px;">
          <div style="width:88px;height:88px;border-radius:9999px;background:#dcfce7;display:flex;align-items:center;justify-content:center;">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
          </div>
          <p data-age-share-card-months style="margin-top:16px;font-family:'Sora',sans-serif;font-size:64px;font-weight:800;line-height:1;color:#061536;">0</p>
          <p style="margin-top:10px;font-family:'Inter',sans-serif;font-size:24px;line-height:1;color:#616a87;">{t.months}</p>
        </div>
        <div style="flex:1;height:290px;background:#ffffff;border:1px solid #dbe4f0;border-radius:24px;display:flex;flex-direction:column;align-items:center;padding-top:40px;">
          <div style="width:88px;height:88px;border-radius:9999px;background:#fef3c7;display:flex;align-items:center;justify-content:center;">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
          </div>
          <p data-age-share-card-days style="margin-top:16px;font-family:'Sora',sans-serif;font-size:64px;font-weight:800;line-height:1;color:#061536;">0</p>
          <p style="margin-top:10px;font-family:'Inter',sans-serif;font-size:24px;line-height:1;color:#616a87;">{t.days}</p>
        </div>
        <div style="flex:1;height:290px;background:#ffffff;border:1px solid #dbe4f0;border-radius:24px;display:flex;flex-direction:column;align-items:center;padding-top:40px;">
          <div style="width:88px;height:88px;border-radius:9999px;background:#ede9fe;display:flex;align-items:center;justify-content:center;">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
          </div>
          <p data-age-share-card-totaldays style="margin-top:16px;font-family:'Sora',sans-serif;font-size:64px;font-weight:800;line-height:1;color:#061536;">0</p>
          <p style="margin-top:10px;font-family:'Inter',sans-serif;font-size:24px;line-height:1;color:#616a87;">{t.shareTotalDays}</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { domToBlob } from 'modern-screenshot';

  const DAY_MS = 86400000;

  // Build a real calendar date from day/month/year parts. Returns null
  // for anything that is not a real date (e.g. 31 Feb, month 13, year
  // with fewer than 4 digits) — never silently "correct" the input.
  function parseDateParts(day: string, month: string, year: string): Date | null {
    if (!day || !month || !year) return null;
    const d = Number(day);
    const m = Number(month);
    const y = Number(year);
    if (!Number.isInteger(d) || !Number.isInteger(m) || !Number.isInteger(y)) return null;
    if (year.length !== 4 || m < 1 || m > 12 || d < 1 || d > 31) return null;
    const date = new Date(y, m - 1, d);
    if (date.getFullYear() !== y || date.getMonth() !== m - 1 || date.getDate() !== d) return null;
    return date;
  }

  // Per-field range check used only to highlight the offending field.
  function rangeBad(value: string, min: number, max: number, len?: number): boolean {
    if (value === '') return false;
    const n = Number(value);
    if (len !== undefined && value.length !== len) return true;
    return Number.isNaN(n) || n < min || n > max;
  }

  // Live field-level range check: a field is definitively invalid
  // ONLY when full (maxlength reached) and out of range — day 1-31,
  // month 1-12, year 4 digits and not 0000. Partial values can still
  // become valid, so they are never marked.
  function fieldRangeBad(input: HTMLInputElement): boolean {
    const v = input.value;
    if (v.length < input.maxLength) return false;
    const n = Number(v);
    const kind = input.dataset.dob || input.dataset.asof;
    if (kind === 'day') return n < 1 || n > 31;
    if (kind === 'month') return n < 1 || n > 12;
    return n === 0; // year: 0000 is not a real year
  }

  document.querySelectorAll<HTMLElement>('[data-age]').forEach((root) => {
    const labels = JSON.parse(root.dataset.labels || '{}');
    const locale = root.dataset.locale || 'en-US';
    const dobDay = root.querySelector<HTMLInputElement>('[data-dob="day"]')!;
    const dobMonth = root.querySelector<HTMLInputElement>('[data-dob="month"]')!;
    const dobYear = root.querySelector<HTMLInputElement>('[data-dob="year"]')!;
    const dobFields = [dobDay, dobMonth, dobYear];
    const asOfDay = root.querySelector<HTMLInputElement>('[data-asof="day"]')!;
    const asOfMonth = root.querySelector<HTMLInputElement>('[data-asof="month"]')!;
    const asOfYear = root.querySelector<HTMLInputElement>('[data-asof="year"]')!;
    const asOfFields = [asOfDay, asOfMonth, asOfYear];
    const errorEl = root.querySelector<HTMLElement>('[data-age-error]')!;
    const yearsEl = root.querySelector<HTMLElement>('[data-age-years]')!;
    const monthsEl = root.querySelector<HTMLElement>('[data-age-months]')!;
    const daysEl = root.querySelector<HTMLElement>('[data-age-days]')!;
    const totalDaysEl = root.querySelector<HTMLElement>('[data-age-totaldays]')!;
    const totalWeeksEl = root.querySelector<HTMLElement>('[data-age-totalweeks]')!;
    const nextEl = root.querySelector<HTMLElement>('[data-age-next]')!;
    const shareBtn = root.querySelector<HTMLButtonElement>('[data-age-share]')!;
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-age-copy]')!;
    const waBtn = root.querySelector<HTMLButtonElement>('[data-age-share-wa]')!;
    const igBtn = root.querySelector<HTMLButtonElement>('[data-age-share-ig]')!;
    const tgBtn = root.querySelector<HTMLButtonElement>('[data-age-share-tg]')!;
    const xBtn = root.querySelector<HTMLButtonElement>('[data-age-share-x]')!;
    const shareStatusEl = root.querySelector<HTMLElement>('[data-age-share-status]')!;
    const shareCard = root.querySelector<HTMLElement>('[data-age-share-card]')!;
    const shareBg = shareCard.querySelector<HTMLImageElement>('[data-age-share-bg]')!;

    // Last valid calculation, shared with the share card. Null whenever
    // the inputs change or the calculation fails, so Share can never
    // export a stale or placeholder result.
    let lastResult: { years: number; months: number; days: number; totalDays: number } | null = null;
    let lastShare: { key: string; blob: Blob } | null = null;

    // Copy-image is a secondary action, shown only where the browser
    // can actually write a PNG to the clipboard.
    if ('clipboard' in navigator && 'ClipboardItem' in window) {
      copyBtn.classList.remove('hidden');
    }

    // Default the "as of" date to today, pre-filled in its fields.
    const today = new Date();
    asOfDay.value = String(today.getDate());
    asOfMonth.value = String(today.getMonth() + 1);
    asOfYear.value = String(today.getFullYear());

    // AUTOMATIC date-format detection, no user action, no network,
    // no IP lookup. The PRIMARY signal is the device TIMEZONE
    // (user's decision): it reflects the device's configured
    // region, is instant and private, and VPNs cannot change it —
    // so an Indian user gets DMY even with an en-US browser.
    // Browser locale (Intl formatToParts) is only the fallback when
    // no timezone is available, then DMY, the worldwide majority.
    // The timezone sets are complete for every MDY/YMD country, so
    // any other valid zone is safely DMY.
    type DatePart = 'day' | 'month' | 'year';
    const orderFromLocale = (locale: string): DatePart[] | null => {
      try {
        const parts = new Intl.DateTimeFormat(locale, {
          day: 'numeric',
          month: 'numeric',
          year: 'numeric',
        }).formatToParts(new Date(2007, 2, 27));
        const order = parts
          .filter((p) => p.type === 'day' || p.type === 'month' || p.type === 'year')
          .map((p) => p.type as DatePart);
        return order.length === 3 ? order : null;
      } catch {
        return null;
      }
    };

    // Timezone -> format mapping. Complete for every MDY/YMD
    // country, so any other valid IANA zone is safely DMY (the
    // worldwide majority). MDY = US + Philippines + US-associated
    // Pacific territories; YMD = China, Japan, Korea, Taiwan,
    // Hong Kong, Mongolia, Hungary, Lithuania, Bhutan.
    const MDY_ZONES = new Set([
      // United States (all zones from the tz database)
      'America/Adak', 'America/Anchorage', 'America/Boise', 'America/Chicago',
      'America/Denver', 'America/Detroit', 'America/Indiana/Indianapolis', 'America/Indiana/Knox',
      'America/Indiana/Marengo', 'America/Indiana/Petersburg', 'America/Indiana/Tell_City',
      'America/Indiana/Vevay', 'America/Indiana/Vincennes', 'America/Indiana/Winamac',
      'America/Juneau', 'America/Kentucky/Louisville', 'America/Kentucky/Monticello',
      'America/Los_Angeles', 'America/Menominee', 'America/Metlakatla', 'America/New_York',
      'America/Nome', 'America/North_Dakota/Beulah', 'America/North_Dakota/Center',
      'America/North_Dakota/New_Salem', 'America/Phoenix', 'America/Sitka', 'America/Yakutat',
      'Pacific/Honolulu',
      // US territories + associated Pacific states
      'America/Puerto_Rico', 'America/St_Thomas', 'America/St_Croix',
      'Pacific/Guam', 'Pacific/Saipan', 'Pacific/Pago_Pago', 'Pacific/Wake', 'Pacific/Midway',
      'Pacific/Palau', 'Pacific/Majuro', 'Pacific/Kwajalein',
      'Pacific/Chuuk', 'Pacific/Pohnpei', 'Pacific/Kosrae', 'Pacific/Yap',
      // Philippines
      'Asia/Manila',
    ]);
    const YMD_ZONES = new Set([
      'Asia/Tokyo', 'Asia/Seoul', 'Asia/Pyongyang',
      'Asia/Shanghai', 'Asia/Chongqing', 'Asia/Chungking', 'Asia/Urumqi', 'Asia/Kashgar',
      'Asia/Taipei', 'Asia/Hong_Kong',
      'Asia/Ulaanbaatar', 'Asia/Ulan_Bator', 'Asia/Choibalsan',
      'Europe/Budapest', 'Europe/Vilnius', 'Asia/Thimphu', 'Asia/Thimbu',
    ]);
    const orderFromTimeZone = (tz: string): DatePart[] =>
      MDY_ZONES.has(tz) ? ['month', 'day', 'year'] : YMD_ZONES.has(tz) ? ['year', 'month', 'day'] : ['day', 'month', 'year'];

    const dobGroup = root.querySelector<HTMLElement>('[data-age-dob-group]')!;
    const asOfGroup = root.querySelector<HTMLElement>('[data-age-asof-group]')!;

    // Reorder the day/month/year fields in both fieldsets to the
    // detected order. Values travel with their fields, so nothing
    // already typed is lost.
    const applyFormat = (order: DatePart[]) => {
      [dobGroup, asOfGroup].forEach((group) => {
        const row = group.querySelector<HTMLElement>('[data-fields-row]')!;
        order.forEach((key) => {
          const field = row.querySelector<HTMLElement>(`[data-field="${key}"]`)!;
          row.appendChild(field);
        });
      });
    };

    // Detection chain (user's decision): TIMEZONE FIRST, then
    // browser locale, then DMY default. Timezone comes from the OS
    // (instant, local, no network, no IP lookup — and VPN-proof,
    // since a VPN does not change the OS timezone). This means an
    // Indian user gets DMY even with an en-US browser, because
    // their device timezone is Asia/Kolkata. Accepted trade-off:
    // a traveler gets the format of where their device is set, not
    // their browser language. Server-rendered order (EN: MDY, HI:
    // DMY) is corrected here on load when it differs.
    let detectedOrder: DatePart[] | null = null;
    try {
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
      if (tz) detectedOrder = orderFromTimeZone(tz);
    } catch {
      // no timezone available, fall through to locale below
    }
    if (!detectedOrder) {
      for (const l of navigator.languages || [navigator.language]) {
        detectedOrder = orderFromLocale(l || '');
        if (detectedOrder) break;
      }
    }
    applyFormat(detectedOrder ?? ['day', 'month', 'year']);

    const clearResults = () => {
      yearsEl.textContent = '0';
      monthsEl.textContent = '0';
      daysEl.textContent = '0';
      totalDaysEl.textContent = '—';
      totalWeeksEl.textContent = '—';
      nextEl.textContent = '—';
      lastResult = null;
      lastShare = null;
      shareBtn.disabled = true;
      waBtn.disabled = true;
      igBtn.disabled = true;
      tgBtn.disabled = true;
      xBtn.disabled = true;
      shareStatusEl.classList.add('hidden');
    };

    const markInvalid = (el: HTMLInputElement, bad: boolean) => {
      el.classList.toggle('border-red-500', bad);
      el.classList.toggle('dark:border-red-500', bad);
      // Focus state needs its own red rule: the base focus:border-[#4d90fe]
      // beats plain border-red-500 while the field is focused (a :focus
      // rule outranks a plain class), so without this the box would stay
      // blue until blur. The trailing ! (Tailwind v4 important) makes
      // the red win in both light and dark mode, immediately, while typing.
      el.classList.toggle('focus:border-red-500!', bad);
    };

    const showError = (msg: string) => {
      errorEl.textContent = msg;
      errorEl.classList.remove('hidden');
      clearResults();
    };

    const calculate = () => {
      const day = dobDay.value.trim();
      const month = dobMonth.value.trim();
      const year = dobYear.value.trim();
      const aDay = asOfDay.value.trim();
      const aMonth = asOfMonth.value.trim();
      const aYear = asOfYear.value.trim();

      // Per-field validity: empty vs out-of-range vs impossible date.
      const dobAny = day !== '' || month !== '' || year !== '';
      const dobAll = day !== '' && month !== '' && year !== '';
      const dob = dobAll ? parseDateParts(day, month, year) : null;
      const asOfAll = aDay !== '' && aMonth !== '' && aYear !== '';
      const asOf = asOfAll ? parseDateParts(aDay, aMonth, aYear) : null;

      dobFields.forEach((el) => markInvalid(el, false));
      asOfFields.forEach((el) => markInvalid(el, false));
      if (!dobAny) {
        showError(labels.errorEmpty);
        return;
      }
      if (!dobAll || !dob) {
        const dayBad = rangeBad(day, 1, 31);
        const monthBad = rangeBad(month, 1, 12);
        const yearBad = rangeBad(year, 0, 9999, 4);
        if (dayBad) markInvalid(dobDay, true);
        if (monthBad) markInvalid(dobMonth, true);
        if (yearBad) markInvalid(dobYear, true);
        if (dobAll && !dob) dobFields.forEach((el) => markInvalid(el, true));
        // Missing fields take priority (GOV.UK error priority); when
        // exactly one field is out of range, name it (ONS pattern),
        // otherwise the generic real-date message.
        const badCount = [dayBad, monthBad, yearBad].filter(Boolean).length;
        showError(
          !dobAll
            ? labels.errorEmpty
            : badCount === 1 && dayBad
              ? labels.errorDayRange
              : badCount === 1 && monthBad
                ? labels.errorMonthRange
                : badCount === 1 && yearBad
                  ? labels.errorYearDigits
                  : labels.errorInvalid,
        );
        return;
      }
      if (!asOfAll || !asOf) {
        const aDayBad = rangeBad(aDay, 1, 31);
        const aMonthBad = rangeBad(aMonth, 1, 12);
        const aYearBad = rangeBad(aYear, 0, 9999, 4);
        if (aDayBad) markInvalid(asOfDay, true);
        if (aMonthBad) markInvalid(asOfMonth, true);
        if (aYearBad) markInvalid(asOfYear, true);
        if (asOfAll && !asOf) asOfFields.forEach((el) => markInvalid(el, true));
        const aBadCount = [aDayBad, aMonthBad, aYearBad].filter(Boolean).length;
        showError(
          !asOfAll
            ? labels.errorAsOf
            : aBadCount === 1 && aDayBad
              ? labels.errorDayRange
              : aBadCount === 1 && aMonthBad
                ? labels.errorMonthRange
                : aBadCount === 1 && aYearBad
                  ? labels.errorYearDigits
                  : labels.errorAsOf,
        );
        return;
      }
      if (dob.getTime() > asOf.getTime()) {
        // The message names the date of birth, so its fields carry
        // the red border (GOV.UK: the field the error relates to).
        dobFields.forEach((el) => markInvalid(el, true));
        showError(labels.errorFuture);
        return;
      }
      errorEl.classList.add('hidden');

      // Exact age with borrowing: days first (borrow the days-in-month of
      // the month before the as-of month), then months, then years.
      let years = asOf.getFullYear() - dob.getFullYear();
      let months = asOf.getMonth() - dob.getMonth();
      let days = asOf.getDate() - dob.getDate();
      if (days < 0) {
        months -= 1;
        days += new Date(asOf.getFullYear(), asOf.getMonth(), 0).getDate();
      }
      if (months < 0) {
        years -= 1;
        months += 12;
      }
      yearsEl.textContent = years.toLocaleString(locale);
      monthsEl.textContent = months.toLocaleString(locale);
      daysEl.textContent = days.toLocaleString(locale);

      const totalDays = Math.round((asOf.getTime() - dob.getTime()) / DAY_MS);
      totalDaysEl.textContent = totalDays.toLocaleString(locale);
      totalWeeksEl.textContent = Math.floor(totalDays / 7).toLocaleString(locale);

      // Next birthday: this year's occurrence of the birth month/day
      // (a Feb 29 birthday rolls to Mar 1 in non-leap years), or next
      // year's if it has already passed.
      let next = new Date(asOf.getFullYear(), dob.getMonth(), dob.getDate());
      if (next.getTime() < asOf.getTime()) {
        next = new Date(asOf.getFullYear() + 1, dob.getMonth(), dob.getDate());
      }
      const until = Math.round((next.getTime() - asOf.getTime()) / DAY_MS);
      const dateStr = next.toLocaleDateString(locale, {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      });
      nextEl.textContent =
        until === 0
          ? `${dateStr} — ${labels.today}`
          : `${dateStr} (${labels.inDays.replace('{n}', String(until))})`;

      // Only now is there a valid result worth sharing.
      lastResult = { years, months, days, totalDays };
      lastShare = null;
      shareBtn.disabled = false;
      waBtn.disabled = false;
      igBtn.disabled = false;
      tgBtn.disabled = false;
      xBtn.disabled = false;
    };

    // Input behaviour (safe auto-advance, no live calculation):
    // - Digits only: pasted separators are dropped, never auto-formatted.
    // - NEVER calculate on input/change: typing must not show results
    //   or error messages (Baymard / Smashing Magazine / Adam Silver
    //   — live validation interrupts users mid-typing). Editing any
    //   field only clears the stale result and any old error message;
    //   calculation happens solely on the button click or Enter.
    // - Field-level range check, live but border-only: a field is
    //   marked red ONLY when full and out of range (day 32, month 13,
    //   year 0000) — values that can never become valid by typing
    //   more. Partial values are never marked. All fields are
    //   re-evaluated on every input, so a mark clears the moment its
    //   value becomes valid again and no stale mark survives.
    // - Auto-advance ONLY when the field is full AND valid, ONLY to
    //   the next field of the same date group, in current DOM order
    //   (applyFormat may have reordered the fields). A full but
    //   invalid value stays put with its red border — focus never
    //   leaves a value the user still needs to fix. Never across
    //   groups, never auto-calculating, never blocking Tab /
    //   Shift+Tab / click.
    // - Backspace in an empty field moves focus to the previous field
    //   of the same group, so mistakes stay correctable by keyboard.
    [...dobFields, ...asOfFields].forEach((el) => {
      const groupInputs = () => {
        const row = el.closest('[data-fields-row]')!;
        return [...row.querySelectorAll<HTMLInputElement>('input')];
      };
      el.addEventListener('input', () => {
        el.value = el.value.replace(/[^0-9]/g, '');
        clearResults();
        errorEl.classList.add('hidden');
        [...dobFields, ...asOfFields].forEach((f) => markInvalid(f, fieldRangeBad(f)));
        const inputs = groupInputs();
        const idx = inputs.indexOf(el);
        if (!fieldRangeBad(el) && el.value.length >= el.maxLength && idx >= 0 && idx < inputs.length - 1) {
          inputs[idx + 1].focus();
        }
      });
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && el.value === '') {
          const inputs = groupInputs();
          const idx = inputs.indexOf(el);
          if (idx > 0) inputs[idx - 1].focus();
        } else if (e.key === 'Enter') {
          calculate();
        }
      });
    });
    const showShareStatus = (msg: string, isError = false) => {
      shareStatusEl.textContent = msg;
      shareStatusEl.classList.toggle('text-red-500', isError);
      shareStatusEl.classList.remove('hidden');
    };
    const hideShareStatus = () => shareStatusEl.classList.add('hidden');

    // Fill the share card from the live result, formatted exactly like
    // the visible result (same locale grouping and digits).
    const updateShareCard = () => {
      if (!lastResult) return;
      const fmt = (n: number) => n.toLocaleString(locale);
      const set = (sel: string, value: string) => {
        shareCard.querySelector<HTMLElement>(sel)!.textContent = value;
      };
      set('[data-age-share-years]', fmt(lastResult.years));
      set('[data-age-share-months]', fmt(lastResult.months));
      set('[data-age-share-days]', fmt(lastResult.days));
      set('[data-age-share-card-years]', fmt(lastResult.years));
      set('[data-age-share-card-months]', fmt(lastResult.months));
      set('[data-age-share-card-days]', fmt(lastResult.days));
      set('[data-age-share-card-totaldays]', fmt(lastResult.totalDays));
    };

    const downloadBlob = (blob: Blob) => {
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'dusrel-age-result.png';
      document.body.appendChild(a);
      a.click();
      a.remove();
      window.setTimeout(() => URL.revokeObjectURL(url), 1000);
    };

    // Render the 1200x1200 share PNG entirely in the browser. The blob
    // is cached per result, so Share and Copy never regenerate the
    // same image twice.
    const getShareBlob = async (): Promise<Blob> => {
      if (!lastResult) throw new Error('No age result to share.');
      const key = JSON.stringify(lastResult);
      if (lastShare && lastShare.key === key) return lastShare.blob;
      updateShareCard();
      await document.fonts.ready;
      try {
        await document.fonts.load('800 154px Sora');
        await document.fonts.load('700 56px Sora');
      } catch {
        // A font that fails to load still leaves its fallback rendering;
        // never block sharing on it.
      }
      try {
        if (!shareBg.complete) await shareBg.decode();
      } catch {
        // decode() rejects for a broken image; capture then fails loudly below.
      }
      // iOS Safari sometimes returns an empty or tiny blob on the first
      // attempt (SVG image decode race); retry while the blob looks wrong.
      let blob: Blob | null = null;
      for (let attempt = 0; attempt < 3; attempt++) {
        const candidate = await domToBlob(shareCard, { width: 1200, height: 1200, scale: 1 });
        if (candidate && candidate.size > 100_000) {
          blob = candidate;
          break;
        }
      }
      if (!blob) throw new Error('Image generation returned no data.');
      lastShare = { key, blob };
      return blob;
    };

    // The page being shared: same origin, locale-correct, no query/hash.
    const pageUrl = () => window.location.origin + window.location.pathname;

    // Synchronous file-share check (used before opening any tab, so a
    // fallback link still opens inside the click's activation window).
    const fileShareSupported = () => {
      try {
        return (
          typeof navigator.canShare === 'function' &&
          navigator.canShare({ files: [new File([''], 'test.png', { type: 'image/png' })] })
        );
      } catch {
        return false;
      }
    };

    shareBtn.addEventListener('click', async () => {
      if (!lastResult || shareBtn.disabled) return;
      const resultAtClick = lastResult;
      const originalText = shareBtn.textContent;
      shareBtn.disabled = true;
      shareBtn.textContent = labels.shareGenerating;
      hideShareStatus();
      try {
        const blob = await getShareBlob();
        // The result changed mid-generation: don't share stale numbers.
        if (lastResult !== resultAtClick) return;
        const file = new File([blob], 'dusrel-age-result.png', { type: 'image/png' });
        if (navigator.canShare && navigator.canShare({ files: [file] })) {
          try {
            // Image + message + page URL together; on mobile the sheet
            // offers WhatsApp, Instagram, Telegram and the rest.
            await navigator.share({ files: [file], text: labels.shareMessage, url: pageUrl(), title: 'My Age — Dusrel' });
          } catch (err) {
            // User cancelled the share sheet: not an error, no fallback.
            if (err instanceof DOMException && err.name === 'AbortError') return;
            throw err;
          }
        } else {
          downloadBlob(blob);
          showShareStatus(labels.shareDownloaded);
        }
      } catch {
        // A failed share never touches the calculated result.
        showShareStatus(labels.shareFailed, true);
      } finally {
        shareBtn.textContent = originalText;
        shareBtn.disabled = !lastResult;
      }
    });

    copyBtn.addEventListener('click', async () => {
      if (!lastResult || copyBtn.disabled) return;
      copyBtn.disabled = true;
      hideShareStatus();
      try {
        const blob = await getShareBlob();
        await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
        showShareStatus(labels.shareCopied);
      } catch {
        showShareStatus(labels.shareFailed, true);
      } finally {
        copyBtn.disabled = !lastResult;
      }
    });

    // Platform buttons. No platform except the system share sheet takes
    // an image from the web, so every link-based button pairs its text
    // link with an image download for manual attach. Tabs open
    // synchronously (before any await) so popup blockers never eat them.
    waBtn.addEventListener('click', async () => {
      if (!lastResult || waBtn.disabled) return;
      const resultAtClick = lastResult;
      waBtn.disabled = true;
      hideShareStatus();
      try {
        if (fileShareSupported()) {
          // Sheet flow: the user picks WhatsApp and the image +
          // message go together.
          const blob = await getShareBlob();
          if (lastResult !== resultAtClick) return;
          const file = new File([blob], 'dusrel-age-result.png', { type: 'image/png' });
          try {
            await navigator.share({ files: [file], text: labels.shareMessage, url: pageUrl() });
          } catch (err) {
            if (err instanceof DOMException && err.name === 'AbortError') return;
            throw err;
          }
        } else {
          // wa.me carries text only, so the image downloads alongside.
          window.open(
            `https://wa.me/?text=${encodeURIComponent(`${labels.shareMessage} ${pageUrl()}`)}`,
            '_blank',
            'noopener',
          );
          const blob = await getShareBlob();
          downloadBlob(blob);
          showShareStatus(labels.shareAttachHint);
        }
      } catch {
        showShareStatus(labels.shareFailed, true);
      } finally {
        waBtn.disabled = !lastResult;
      }
    });

    igBtn.addEventListener('click', async () => {
      if (!lastResult || igBtn.disabled) return;
      igBtn.disabled = true;
      hideShareStatus();
      try {
        // Instagram offers no web share into DMs at all: download the
        // image and copy the message for a manual paste.
        const blob = await getShareBlob();
        downloadBlob(blob);
        let copied = false;
        try {
          await navigator.clipboard.writeText(`${labels.shareMessage} ${pageUrl()}`);
          copied = true;
        } catch {
          // Copy is best-effort; the download already happened.
        }
        showShareStatus(copied ? labels.shareInstagramDone : labels.shareDownloaded);
      } catch {
        showShareStatus(labels.shareFailed, true);
      } finally {
        igBtn.disabled = !lastResult;
      }
    });

    const openLinkShare = async (btn: HTMLButtonElement, url: string) => {
      if (!lastResult || btn.disabled) return;
      btn.disabled = true;
      hideShareStatus();
      window.open(url, '_blank', 'noopener');
      try {
        const blob = await getShareBlob();
        downloadBlob(blob);
        showShareStatus(labels.shareAttachHint);
      } catch {
        // The link already opened; a failed download must not look
        // like a failed share.
      } finally {
        btn.disabled = !lastResult;
      }
    };

    tgBtn.addEventListener('click', () =>
      openLinkShare(
        tgBtn,
        `https://t.me/share/url?url=${encodeURIComponent(pageUrl())}&text=${encodeURIComponent(labels.shareMessage)}`,
      ),
    );

    xBtn.addEventListener('click', () =>
      openLinkShare(
        xBtn,
        `https://x.com/intent/tweet?text=${encodeURIComponent(`${labels.shareMessage} ${pageUrl()}`)}`,
      ),
    );

    root.querySelector('[data-age-calc]')!.addEventListener('click', calculate);
  });
</script>
