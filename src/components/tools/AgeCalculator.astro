---
/**
 * Age Calculator tool island — 100% client-side.
 * Exact age in years/months/days (with proper month/day borrowing), total
 * days and weeks lived, and the next birthday countdown. Dates never
 * leave the device. Used on /pass and /pass/age-calculator (EN + HI).
 *
 * Date-entry UX (cross-verified via Exa against GOV.UK Design System,
 * USWDS memorable-date pattern, NN/g date-input guidelines and ONS):
 * - Date of birth is a memorable date from the distant past, so it uses
 *   three separate labelled text fields (day / month / year) instead of
 *   a calendar picker — navigating decades in a calendar is slow and
 *   painful, and dropdowns for day/year add needless clicks.
 * - Fields are type="text" with inputmode="numeric" (numeric keyboard on
 *   mobile, no number-input spinner/stepper problems), maxlength 2/2/4,
 *   and autocomplete bday-day / bday-month / bday-year (WCAG 2.1 AA).
 * - Calculation is NEVER live: typing never calculates and never
 *   shows errors (Baymard, Smashing Magazine, Adam Silver — live
 *   validation interrupts users before they finish typing). The age
 *   is calculated only on the explicit "Calculate age" button click
 *   (or Enter in a field). Editing any field after a calculation
 *   clears the stale result, so a wrong number is never shown as
 *   current.
 * - Focus IS auto-advanced, but only when the field is full AND
 *   valid (cross-verified via Exa: Kendo segmented date inputs
 *   advance "once a valid value is entered"; GOV.UK refuses values
 *   that "cannot be correct", e.g. month 13): a full but
 *   out-of-range value (day 32, month 13, year 0000) turns its box
 *   red and does NOT advance, so focus never leaves a value the
 *   user still needs to fix. Advance stays within its own date
 *   group, never across groups, never auto-calculating. Backspace
 *   in an empty field moves back, Tab / Shift+Tab / click always
 *   work normally. No advance warning is shown — the pattern is
 *   now a familiar convention (OTP/date segments) and the user
 *   explicitly asked to remove the hint.
 * - Field-level validity is shown live ONLY as a red border, and
 *   only for complete values that can never become valid; error
 *   messages still appear only on Calculate (GOV.UK: do not
 *   validate before the user has finished entering). A red border
 *   clears the moment the value becomes valid again.
 * - The hint example uses a day >= 13 and a month <= 9 so the field
 *   order is unambiguous, and leading zeros are never required.
 * - The "as of" date uses the same three-field pattern, pre-filled
 *   with today's date by default (it can still be changed to any date,
 *   e.g. to see your age on a past or future date).
 * - Date format is detected AUTOMATICALLY, no manual selection,
 *   users never pick a country, no network request, no IP lookup.
 *   The PRIMARY signal is the device TIMEZONE (user's decision):
 *   instant, private, VPN-proof (a VPN does not change the OS
 *   timezone) — so an Indian user gets DMY even with an en-US
 *   browser. Browser locale (Intl formatToParts) is only the
 *   fallback when no timezone is available, then DMY, the
 *   worldwide majority. Timezone sets are complete for every
 *   MDY/YMD country, so any other valid zone is safely DMY.
 */
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const L = {
  en: {
    dateOfBirth: 'Date of birth',
    examplePrefix: 'For example,',
    day: 'Day',
    month: 'Month',
    year: 'Year',
    asOf: 'As of date',
    asOfHint: 'Defaults to today',
    calculate: 'Calculate age',
    years: 'Years',
    months: 'Months',
    days: 'Days',
    totalDays: 'Total days lived',
    totalWeeks: 'Total weeks lived',
    nextBirthday: 'Next birthday',
    inDays: 'in {n} days',
    today: "It's today! 🎂",
    errorFuture: 'Date of birth cannot be after the "as of" date.',
    errorEmpty: 'Please enter your date of birth.',
    errorInvalid: 'Enter a real date of birth.',
    errorAsOf: "Enter a real 'as of' date.",
    errorDayRange: 'Day must be between 1 and 31',
    errorMonthRange: 'Month must be between 1 and 12',
    errorYearDigits: 'Year must be 4 digits',
    note: 'Your dates never leave your device — the calculation happens entirely in your browser.',
  },
  hi: {
    dateOfBirth: 'जन्म तिथि',
    examplePrefix: 'उदाहरण:',
    day: 'दिन',
    month: 'महीना',
    year: 'वर्ष',
    asOf: 'गणना की तिथि',
    asOfHint: 'डिफ़ॉल्ट रूप से आज की तिथि',
    calculate: 'उम्र निकालें',
    years: 'वर्ष',
    months: 'महीने',
    days: 'दिन',
    totalDays: 'कुल जीए गए दिन',
    totalWeeks: 'कुल सप्ताह',
    nextBirthday: 'अगला जन्मदिन',
    inDays: '{n} दिनों में',
    today: 'आज ही है! 🎂',
    errorFuture: 'जन्म तिथि गणना की तिथि से बाद की नहीं हो सकती।',
    errorEmpty: 'कृपया अपनी जन्म तिथि डालें।',
    errorInvalid: 'सही जन्म तिथि डालें।',
    errorAsOf: 'सही गणना तिथि डालें।',
    errorDayRange: 'दिन 1 से 31 के बीच होना चाहिए',
    errorMonthRange: 'महीना 1 से 12 के बीच होना चाहिए',
    errorYearDigits: 'वर्ष 4 अंकों का होना चाहिए',
    note: 'आपकी तारीखें आपके डिवाइस से बाहर कभी नहीं जातीं — सारी गणना पूरी तरह आपके ब्राउज़र में होती है।',
  },
} as const;
const t = L[lang];

// Field order follows the locale convention: en-US is month/day/year,
// hi-IN is day/month/year. Labels make the order unambiguous either way.
const dobFields =
  lang === 'hi'
    ? ([
        { key: 'day', label: t.day, auto: 'bday-day', width: 'w-20' },
        { key: 'month', label: t.month, auto: 'bday-month', width: 'w-20' },
        { key: 'year', label: t.year, auto: 'bday-year', width: 'w-28' },
      ] as const)
    : ([
        { key: 'month', label: t.month, auto: 'bday-month', width: 'w-20' },
        { key: 'day', label: t.day, auto: 'bday-day', width: 'w-20' },
        { key: 'year', label: t.year, auto: 'bday-year', width: 'w-28' },
      ] as const);

// Same locale field order as DOB, but no birthday autocomplete: this is
// a reference date, not a date of birth.
const asOfFields =
  lang === 'hi'
    ? ([
        { key: 'day', label: t.day, width: 'w-20' },
        { key: 'month', label: t.month, width: 'w-20' },
        { key: 'year', label: t.year, width: 'w-28' },
      ] as const)
    : ([
        { key: 'month', label: t.month, width: 'w-20' },
        { key: 'day', label: t.day, width: 'w-20' },
        { key: 'year', label: t.year, width: 'w-28' },
      ] as const);

// Hint example numbers per format (day 27, month 3: unambiguous order).
const hintExample = lang === 'hi' ? '27 3 2007' : '3 27 2007';
const initialDobHint = `${t.examplePrefix} ${hintExample}`;

const dobFieldCls =
  'mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-3 text-center text-base text-slate-800 focus:border-[#4d90fe] focus:outline-none dark:border-white/20 dark:bg-[#1e1e1e] dark:text-slate-100';
---

<div
  data-age
  data-locale={lang === 'hi' ? 'hi-IN' : 'en-US'}
  data-labels={JSON.stringify({ nextBirthday: t.nextBirthday, inDays: t.inDays, today: t.today, errorFuture: t.errorFuture, errorEmpty: t.errorEmpty, errorInvalid: t.errorInvalid, errorAsOf: t.errorAsOf, errorDayRange: t.errorDayRange, errorMonthRange: t.errorMonthRange, errorYearDigits: t.errorYearDigits, examplePrefix: t.examplePrefix })}
  class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-white/5 md:p-8"
>
  <div class="grid gap-5 sm:grid-cols-2">
    <fieldset data-age-dob-group>
      <legend class="text-sm font-medium text-slate-700 dark:text-slate-300">{t.dateOfBirth}</legend>
      <div class="flex items-start gap-2.5" data-fields-row>
        {
          dobFields.map((f) => (
            <div class={f.width} data-field={f.key}>
              <label class="mt-2 block text-xs font-medium text-slate-500 dark:text-slate-400" for={`age-dob-${f.key}`}>
                {f.label}
              </label>
              <input
                id={`age-dob-${f.key}`}
                data-dob={f.key}
                type="text"
                inputmode="numeric"
                pattern="[0-9]*"
                maxlength={f.key === 'year' ? 4 : 2}
                autocomplete={f.auto}
                placeholder={f.key === 'year' ? 'YYYY' : f.key === 'day' ? 'DD' : 'MM'}
                aria-label={f.label}
                class={dobFieldCls}
              />
            </div>
          ))
        }
      </div>
      <p class="mt-2 text-xs text-slate-500 dark:text-slate-400" data-dob-hint>{initialDobHint}</p>
    </fieldset>
    <fieldset data-age-asof-group>
      <legend class="text-sm font-medium text-slate-700 dark:text-slate-300">{t.asOf}</legend>
      <div class="flex items-start gap-2.5" data-fields-row>
        {
          asOfFields.map((f) => (
            <div class={f.width} data-field={f.key}>
              <label class="mt-2 block text-xs font-medium text-slate-500 dark:text-slate-400" for={`age-asof-${f.key}`}>
                {f.label}
              </label>
              <input
                id={`age-asof-${f.key}`}
                data-asof={f.key}
                type="text"
                inputmode="numeric"
                pattern="[0-9]*"
                maxlength={f.key === 'year' ? 4 : 2}
                autocomplete="off"
                placeholder={f.key === 'year' ? 'YYYY' : f.key === 'day' ? 'DD' : 'MM'}
                aria-label={f.label}
                class={dobFieldCls}
              />
            </div>
          ))
        }
      </div>
      <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">{t.asOfHint}</p>
    </fieldset>
  </div>

  <button
    type="button"
    data-age-calc
    class="mt-6 w-full rounded-2xl bg-[#4d90fe] px-8 py-3.5 text-base font-semibold text-white transition-colors hover:bg-[#3b7de0]"
  >
    {t.calculate}
  </button>

  <p data-age-error class="mt-4 hidden text-center text-sm font-medium text-red-500" role="alert"></p>

  <div class="mt-7 grid grid-cols-3 gap-3">
    <div class="rounded-2xl border border-slate-200 px-4 py-4 text-center dark:border-white/10">
      <p data-age-years class="text-3xl font-bold text-slate-900 dark:text-white md:text-4xl">0</p>
      <p class="mt-1 text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">{t.years}</p>
    </div>
    <div class="rounded-2xl border border-slate-200 px-4 py-4 text-center dark:border-white/10">
      <p data-age-months class="text-3xl font-bold text-slate-900 dark:text-white md:text-4xl">0</p>
      <p class="mt-1 text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">{t.months}</p>
    </div>
    <div class="rounded-2xl border border-slate-200 px-4 py-4 text-center dark:border-white/10">
      <p data-age-days class="text-3xl font-bold text-slate-900 dark:text-white md:text-4xl">0</p>
      <p class="mt-1 text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">{t.days}</p>
    </div>
  </div>

  <dl class="mt-6 space-y-2.5 rounded-2xl bg-slate-50 px-5 py-4 text-sm dark:bg-black/30">
    <div class="flex items-center justify-between gap-4">
      <dt class="text-slate-500 dark:text-slate-400">{t.totalDays}</dt>
      <dd data-age-totaldays class="font-semibold text-slate-900 dark:text-white">—</dd>
    </div>
    <div class="flex items-center justify-between gap-4">
      <dt class="text-slate-500 dark:text-slate-400">{t.totalWeeks}</dt>
      <dd data-age-totalweeks class="font-semibold text-slate-900 dark:text-white">—</dd>
    </div>
    <div class="flex items-center justify-between gap-4">
      <dt class="text-slate-500 dark:text-slate-400">{t.nextBirthday}</dt>
      <dd data-age-next class="text-right font-semibold text-slate-900 dark:text-white">—</dd>
    </div>
  </dl>

  <p class="mt-4 text-center text-xs leading-relaxed text-slate-500 dark:text-slate-400">{t.note}</p>
</div>

<script>
  const DAY_MS = 86400000;

  // Build a real calendar date from day/month/year parts. Returns null
  // for anything that is not a real date (e.g. 31 Feb, month 13, year
  // with fewer than 4 digits) — never silently "correct" the input.
  function parseDateParts(day: string, month: string, year: string): Date | null {
    if (!day || !month || !year) return null;
    const d = Number(day);
    const m = Number(month);
    const y = Number(year);
    if (!Number.isInteger(d) || !Number.isInteger(m) || !Number.isInteger(y)) return null;
    if (year.length !== 4 || m < 1 || m > 12 || d < 1 || d > 31) return null;
    const date = new Date(y, m - 1, d);
    if (date.getFullYear() !== y || date.getMonth() !== m - 1 || date.getDate() !== d) return null;
    return date;
  }

  // Per-field range check used only to highlight the offending field.
  function rangeBad(value: string, min: number, max: number, len?: number): boolean {
    if (value === '') return false;
    const n = Number(value);
    if (len !== undefined && value.length !== len) return true;
    return Number.isNaN(n) || n < min || n > max;
  }

  // Live field-level range check: a field is definitively invalid
  // ONLY when full (maxlength reached) and out of range — day 1-31,
  // month 1-12, year 4 digits and not 0000. Partial values can still
  // become valid, so they are never marked.
  function fieldRangeBad(input: HTMLInputElement): boolean {
    const v = input.value;
    if (v.length < input.maxLength) return false;
    const n = Number(v);
    const kind = input.dataset.dob || input.dataset.asof;
    if (kind === 'day') return n < 1 || n > 31;
    if (kind === 'month') return n < 1 || n > 12;
    return n === 0; // year: 0000 is not a real year
  }

  document.querySelectorAll<HTMLElement>('[data-age]').forEach((root) => {
    const labels = JSON.parse(root.dataset.labels || '{}');
    const locale = root.dataset.locale || 'en-US';
    const dobDay = root.querySelector<HTMLInputElement>('[data-dob="day"]')!;
    const dobMonth = root.querySelector<HTMLInputElement>('[data-dob="month"]')!;
    const dobYear = root.querySelector<HTMLInputElement>('[data-dob="year"]')!;
    const dobFields = [dobDay, dobMonth, dobYear];
    const asOfDay = root.querySelector<HTMLInputElement>('[data-asof="day"]')!;
    const asOfMonth = root.querySelector<HTMLInputElement>('[data-asof="month"]')!;
    const asOfYear = root.querySelector<HTMLInputElement>('[data-asof="year"]')!;
    const asOfFields = [asOfDay, asOfMonth, asOfYear];
    const errorEl = root.querySelector<HTMLElement>('[data-age-error]')!;
    const yearsEl = root.querySelector<HTMLElement>('[data-age-years]')!;
    const monthsEl = root.querySelector<HTMLElement>('[data-age-months]')!;
    const daysEl = root.querySelector<HTMLElement>('[data-age-days]')!;
    const totalDaysEl = root.querySelector<HTMLElement>('[data-age-totaldays]')!;
    const totalWeeksEl = root.querySelector<HTMLElement>('[data-age-totalweeks]')!;
    const nextEl = root.querySelector<HTMLElement>('[data-age-next]')!;

    // Default the "as of" date to today, pre-filled in its fields.
    const today = new Date();
    asOfDay.value = String(today.getDate());
    asOfMonth.value = String(today.getMonth() + 1);
    asOfYear.value = String(today.getFullYear());

    // AUTOMATIC date-format detection, no user action, no network,
    // no IP lookup. The PRIMARY signal is the device TIMEZONE
    // (user's decision): it reflects the device's configured
    // region, is instant and private, and VPNs cannot change it —
    // so an Indian user gets DMY even with an en-US browser.
    // Browser locale (Intl formatToParts) is only the fallback when
    // no timezone is available, then DMY, the worldwide majority.
    // The timezone sets are complete for every MDY/YMD country, so
    // any other valid zone is safely DMY.
    type DatePart = 'day' | 'month' | 'year';
    const orderFromLocale = (locale: string): DatePart[] | null => {
      try {
        const parts = new Intl.DateTimeFormat(locale, {
          day: 'numeric',
          month: 'numeric',
          year: 'numeric',
        }).formatToParts(new Date(2007, 2, 27));
        const order = parts
          .filter((p) => p.type === 'day' || p.type === 'month' || p.type === 'year')
          .map((p) => p.type as DatePart);
        return order.length === 3 ? order : null;
      } catch {
        return null;
      }
    };

    // Timezone -> format mapping. Complete for every MDY/YMD
    // country, so any other valid IANA zone is safely DMY (the
    // worldwide majority). MDY = US + Philippines + US-associated
    // Pacific territories; YMD = China, Japan, Korea, Taiwan,
    // Hong Kong, Mongolia, Hungary, Lithuania, Bhutan.
    const MDY_ZONES = new Set([
      // United States (all zones from the tz database)
      'America/Adak', 'America/Anchorage', 'America/Boise', 'America/Chicago',
      'America/Denver', 'America/Detroit', 'America/Indiana/Indianapolis', 'America/Indiana/Knox',
      'America/Indiana/Marengo', 'America/Indiana/Petersburg', 'America/Indiana/Tell_City',
      'America/Indiana/Vevay', 'America/Indiana/Vincennes', 'America/Indiana/Winamac',
      'America/Juneau', 'America/Kentucky/Louisville', 'America/Kentucky/Monticello',
      'America/Los_Angeles', 'America/Menominee', 'America/Metlakatla', 'America/New_York',
      'America/Nome', 'America/North_Dakota/Beulah', 'America/North_Dakota/Center',
      'America/North_Dakota/New_Salem', 'America/Phoenix', 'America/Sitka', 'America/Yakutat',
      'Pacific/Honolulu',
      // US territories + associated Pacific states
      'America/Puerto_Rico', 'America/St_Thomas', 'America/St_Croix',
      'Pacific/Guam', 'Pacific/Saipan', 'Pacific/Pago_Pago', 'Pacific/Wake', 'Pacific/Midway',
      'Pacific/Palau', 'Pacific/Majuro', 'Pacific/Kwajalein',
      'Pacific/Chuuk', 'Pacific/Pohnpei', 'Pacific/Kosrae', 'Pacific/Yap',
      // Philippines
      'Asia/Manila',
    ]);
    const YMD_ZONES = new Set([
      'Asia/Tokyo', 'Asia/Seoul', 'Asia/Pyongyang',
      'Asia/Shanghai', 'Asia/Chongqing', 'Asia/Chungking', 'Asia/Urumqi', 'Asia/Kashgar',
      'Asia/Taipei', 'Asia/Hong_Kong',
      'Asia/Ulaanbaatar', 'Asia/Ulan_Bator', 'Asia/Choibalsan',
      'Europe/Budapest', 'Europe/Vilnius', 'Asia/Thimphu', 'Asia/Thimbu',
    ]);
    const orderFromTimeZone = (tz: string): DatePart[] =>
      MDY_ZONES.has(tz) ? ['month', 'day', 'year'] : YMD_ZONES.has(tz) ? ['year', 'month', 'day'] : ['day', 'month', 'year'];

    const dobGroup = root.querySelector<HTMLElement>('[data-age-dob-group]')!;
    const asOfGroup = root.querySelector<HTMLElement>('[data-age-asof-group]')!;
    const dobHintEl = root.querySelector<HTMLElement>('[data-dob-hint]')!;

    // Reorder the day/month/year fields in both fieldsets to the
    // detected order and update the DOB hint example. Values travel
    // with their fields, so nothing already typed is lost.
    const applyFormat = (order: DatePart[]) => {
      [dobGroup, asOfGroup].forEach((group) => {
        const row = group.querySelector<HTMLElement>('[data-fields-row]')!;
        order.forEach((key) => {
          const field = row.querySelector<HTMLElement>(`[data-field="${key}"]`)!;
          row.appendChild(field);
        });
      });
      const example: Record<DatePart, string> = { day: '27', month: '3', year: '2007' };
      dobHintEl.textContent = `${labels.examplePrefix} ${order.map((k) => example[k]).join(' ')}`;
    };

    // Detection chain (user's decision): TIMEZONE FIRST, then
    // browser locale, then DMY default. Timezone comes from the OS
    // (instant, local, no network, no IP lookup — and VPN-proof,
    // since a VPN does not change the OS timezone). This means an
    // Indian user gets DMY even with an en-US browser, because
    // their device timezone is Asia/Kolkata. Accepted trade-off:
    // a traveler gets the format of where their device is set, not
    // their browser language. Server-rendered order (EN: MDY, HI:
    // DMY) is corrected here on load when it differs.
    let detectedOrder: DatePart[] | null = null;
    try {
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
      if (tz) detectedOrder = orderFromTimeZone(tz);
    } catch {
      // no timezone available, fall through to locale below
    }
    if (!detectedOrder) {
      for (const l of navigator.languages || [navigator.language]) {
        detectedOrder = orderFromLocale(l || '');
        if (detectedOrder) break;
      }
    }
    applyFormat(detectedOrder ?? ['day', 'month', 'year']);

    const clearResults = () => {
      yearsEl.textContent = '0';
      monthsEl.textContent = '0';
      daysEl.textContent = '0';
      totalDaysEl.textContent = '—';
      totalWeeksEl.textContent = '—';
      nextEl.textContent = '—';
    };

    const markInvalid = (el: HTMLInputElement, bad: boolean) => {
      el.classList.toggle('border-red-500', bad);
      el.classList.toggle('dark:border-red-500', bad);
    };

    const showError = (msg: string) => {
      errorEl.textContent = msg;
      errorEl.classList.remove('hidden');
      clearResults();
    };

    const calculate = () => {
      const day = dobDay.value.trim();
      const month = dobMonth.value.trim();
      const year = dobYear.value.trim();
      const aDay = asOfDay.value.trim();
      const aMonth = asOfMonth.value.trim();
      const aYear = asOfYear.value.trim();

      // Per-field validity: empty vs out-of-range vs impossible date.
      const dobAny = day !== '' || month !== '' || year !== '';
      const dobAll = day !== '' && month !== '' && year !== '';
      const dob = dobAll ? parseDateParts(day, month, year) : null;
      const asOfAll = aDay !== '' && aMonth !== '' && aYear !== '';
      const asOf = asOfAll ? parseDateParts(aDay, aMonth, aYear) : null;

      dobFields.forEach((el) => markInvalid(el, false));
      asOfFields.forEach((el) => markInvalid(el, false));
      if (!dobAny) {
        showError(labels.errorEmpty);
        return;
      }
      if (!dobAll || !dob) {
        const dayBad = rangeBad(day, 1, 31);
        const monthBad = rangeBad(month, 1, 12);
        const yearBad = rangeBad(year, 0, 9999, 4);
        if (dayBad) markInvalid(dobDay, true);
        if (monthBad) markInvalid(dobMonth, true);
        if (yearBad) markInvalid(dobYear, true);
        if (dobAll && !dob) dobFields.forEach((el) => markInvalid(el, true));
        // Missing fields take priority (GOV.UK error priority); when
        // exactly one field is out of range, name it (ONS pattern),
        // otherwise the generic real-date message.
        const badCount = [dayBad, monthBad, yearBad].filter(Boolean).length;
        showError(
          !dobAll
            ? labels.errorEmpty
            : badCount === 1 && dayBad
              ? labels.errorDayRange
              : badCount === 1 && monthBad
                ? labels.errorMonthRange
                : badCount === 1 && yearBad
                  ? labels.errorYearDigits
                  : labels.errorInvalid,
        );
        return;
      }
      if (!asOfAll || !asOf) {
        const aDayBad = rangeBad(aDay, 1, 31);
        const aMonthBad = rangeBad(aMonth, 1, 12);
        const aYearBad = rangeBad(aYear, 0, 9999, 4);
        if (aDayBad) markInvalid(asOfDay, true);
        if (aMonthBad) markInvalid(asOfMonth, true);
        if (aYearBad) markInvalid(asOfYear, true);
        if (asOfAll && !asOf) asOfFields.forEach((el) => markInvalid(el, true));
        const aBadCount = [aDayBad, aMonthBad, aYearBad].filter(Boolean).length;
        showError(
          !asOfAll
            ? labels.errorAsOf
            : aBadCount === 1 && aDayBad
              ? labels.errorDayRange
              : aBadCount === 1 && aMonthBad
                ? labels.errorMonthRange
                : aBadCount === 1 && aYearBad
                  ? labels.errorYearDigits
                  : labels.errorAsOf,
        );
        return;
      }
      if (dob.getTime() > asOf.getTime()) {
        // The message names the date of birth, so its fields carry
        // the red border (GOV.UK: the field the error relates to).
        dobFields.forEach((el) => markInvalid(el, true));
        showError(labels.errorFuture);
        return;
      }
      errorEl.classList.add('hidden');

      // Exact age with borrowing: days first (borrow the days-in-month of
      // the month before the as-of month), then months, then years.
      let years = asOf.getFullYear() - dob.getFullYear();
      let months = asOf.getMonth() - dob.getMonth();
      let days = asOf.getDate() - dob.getDate();
      if (days < 0) {
        months -= 1;
        days += new Date(asOf.getFullYear(), asOf.getMonth(), 0).getDate();
      }
      if (months < 0) {
        years -= 1;
        months += 12;
      }
      yearsEl.textContent = years.toLocaleString(locale);
      monthsEl.textContent = months.toLocaleString(locale);
      daysEl.textContent = days.toLocaleString(locale);

      const totalDays = Math.round((asOf.getTime() - dob.getTime()) / DAY_MS);
      totalDaysEl.textContent = totalDays.toLocaleString(locale);
      totalWeeksEl.textContent = Math.floor(totalDays / 7).toLocaleString(locale);

      // Next birthday: this year's occurrence of the birth month/day
      // (a Feb 29 birthday rolls to Mar 1 in non-leap years), or next
      // year's if it has already passed.
      let next = new Date(asOf.getFullYear(), dob.getMonth(), dob.getDate());
      if (next.getTime() < asOf.getTime()) {
        next = new Date(asOf.getFullYear() + 1, dob.getMonth(), dob.getDate());
      }
      const until = Math.round((next.getTime() - asOf.getTime()) / DAY_MS);
      const dateStr = next.toLocaleDateString(locale, {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      });
      nextEl.textContent =
        until === 0
          ? `${dateStr} — ${labels.today}`
          : `${dateStr} (${labels.inDays.replace('{n}', String(until))})`;
    };

    // Input behaviour (safe auto-advance, no live calculation):
    // - Digits only: pasted separators are dropped, never auto-formatted.
    // - NEVER calculate on input/change: typing must not show results
    //   or error messages (Baymard / Smashing Magazine / Adam Silver
    //   — live validation interrupts users mid-typing). Editing any
    //   field only clears the stale result and any old error message;
    //   calculation happens solely on the button click or Enter.
    // - Field-level range check, live but border-only: a field is
    //   marked red ONLY when full and out of range (day 32, month 13,
    //   year 0000) — values that can never become valid by typing
    //   more. Partial values are never marked. All fields are
    //   re-evaluated on every input, so a mark clears the moment its
    //   value becomes valid again and no stale mark survives.
    // - Auto-advance ONLY when the field is full AND valid, ONLY to
    //   the next field of the same date group, in current DOM order
    //   (applyFormat may have reordered the fields). A full but
    //   invalid value stays put with its red border — focus never
    //   leaves a value the user still needs to fix. Never across
    //   groups, never auto-calculating, never blocking Tab /
    //   Shift+Tab / click.
    // - Backspace in an empty field moves focus to the previous field
    //   of the same group, so mistakes stay correctable by keyboard.
    [...dobFields, ...asOfFields].forEach((el) => {
      const groupInputs = () => {
        const row = el.closest('[data-fields-row]')!;
        return [...row.querySelectorAll<HTMLInputElement>('input')];
      };
      el.addEventListener('input', () => {
        el.value = el.value.replace(/[^0-9]/g, '');
        clearResults();
        errorEl.classList.add('hidden');
        [...dobFields, ...asOfFields].forEach((f) => markInvalid(f, fieldRangeBad(f)));
        const inputs = groupInputs();
        const idx = inputs.indexOf(el);
        if (!fieldRangeBad(el) && el.value.length >= el.maxLength && idx >= 0 && idx < inputs.length - 1) {
          inputs[idx + 1].focus();
        }
      });
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && el.value === '') {
          const inputs = groupInputs();
          const idx = inputs.indexOf(el);
          if (idx > 0) inputs[idx - 1].focus();
        } else if (e.key === 'Enter') {
          calculate();
        }
      });
    });
    root.querySelector('[data-age-calc]')!.addEventListener('click', calculate);
  });
</script>
