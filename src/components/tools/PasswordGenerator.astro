---
/**
 * Password Generator tool island — 100% client-side.
 * Uses crypto.getRandomValues (CSPRNG) with rejection sampling (no modulo
 * bias). Nothing is sent to a server. Used on /pass and
 * /pass/password-generator (EN + HI via the `lang` prop).
 */
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const L = {
  en: {
    length: 'Password length',
    characters: 'characters',
    uppercase: 'Uppercase (ABC)',
    lowercase: 'Lowercase (abc)',
    numbers: 'Numbers (123)',
    symbols: 'Symbols (#$&)',
    excludeAmbiguous: 'Exclude look-alikes (0, O, 1, l, I)',
    generate: 'Generate new password',
    copy: 'Copy',
    copied: 'Copied!',
    strength: 'Strength',
    bits: 'bits of entropy',
    weak: 'Weak',
    fair: 'Fair',
    strong: 'Strong',
    excellent: 'Excellent',
    note: 'Generated locally in your browser with cryptographic randomness (Web Crypto API). Nothing is sent to a server — Dusrel never sees your passwords.',
  },
  hi: {
    length: 'पासवर्ड की लंबाई',
    characters: 'अक्षर',
    uppercase: 'बड़े अक्षर (ABC)',
    lowercase: 'छोटे अक्षर (abc)',
    numbers: 'अंक (123)',
    symbols: 'चिह्न (#$&)',
    excludeAmbiguous: 'मिलते-जुलते अक्षर हटाएं (0, O, 1, l, I)',
    generate: 'नया पासवर्ड बनाएं',
    copy: 'कॉपी करें',
    copied: 'कॉपी हो गया!',
    strength: 'मज़बूती',
    bits: 'बिट्स एंट्रॉपी',
    weak: 'कमज़ोर',
    fair: 'ठीक-ठाक',
    strong: 'मज़बूत',
    excellent: 'बेहतरीन',
    note: 'आपके ब्राउज़र में ही क्रिप्टोग्राफ़िक रैंडमनेस (Web Crypto API) से बनता है। कुछ भी किसी सर्वर पर नहीं जाता — Dusrel आपके पासवर्ड कभी नहीं देखता।',
  },
} as const;
const t = L[lang];
---

<div
  data-pwgen
  data-labels={JSON.stringify({ weak: t.weak, fair: t.fair, strong: t.strong, excellent: t.excellent, bits: t.bits, copied: t.copied, copy: t.copy })}
  class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-white/5 md:p-8"
>
  <div class="flex items-stretch gap-3">
    <div
      data-pw-output
      class="min-w-0 flex-1 select-all break-all rounded-2xl bg-slate-100 px-5 py-4 font-mono text-lg leading-relaxed text-slate-900 dark:bg-black/40 dark:text-white md:text-xl"
      aria-live="polite"
    >
      …
    </div>
    <div class="flex flex-col gap-2">
      <button
        type="button"
        data-pw-copy
        class="flex-1 rounded-xl bg-[#4d90fe] px-4 text-sm font-semibold text-white transition-colors hover:bg-[#3b7de0]"
      >
        {t.copy}
      </button>
      <button
        type="button"
        data-pw-regen
        aria-label={t.generate}
        class="flex-1 rounded-xl border border-slate-300 px-4 text-base text-slate-700 transition hover:border-[#4d90fe] hover:text-[#4d90fe] dark:border-white/20 dark:text-slate-200"
      >
        ↻
      </button>
    </div>
  </div>

  <div class="mt-5">
    <div class="flex items-center justify-between text-sm">
      <span class="font-medium text-slate-700 dark:text-slate-300">{t.strength}</span>
      <span class="text-slate-500 dark:text-slate-400"><span data-pw-strength class="font-semibold text-slate-900 dark:text-white"></span> · <span data-pw-bits></span></span>
    </div>
    <div class="mt-2 h-2.5 overflow-hidden rounded-full bg-slate-200 dark:bg-white/10">
      <div data-pw-bar class="h-full rounded-full transition-all duration-300" style="width: 0%; background: #ef4444"></div>
    </div>
  </div>

  <div class="mt-7">
    <label class="flex items-center justify-between text-sm font-medium text-slate-700 dark:text-slate-300" for="pw-length">
      <span>{t.length}</span>
      <span><span data-pw-lenval>16</span> {t.characters}</span>
    </label>
    <input
      id="pw-length"
      data-pw-length
      type="range"
      min="8"
      max="64"
      value="16"
      class="mt-3 w-full accent-[#4d90fe]"
    />
  </div>

  <div class="mt-6 grid gap-3 sm:grid-cols-2">
    <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 px-4 py-3 text-sm dark:border-white/10">
      <input type="checkbox" data-pw-opt="upper" checked class="h-4 w-4 accent-[#4d90fe]" /> {t.uppercase}
    </label>
    <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 px-4 py-3 text-sm dark:border-white/10">
      <input type="checkbox" data-pw-opt="lower" checked class="h-4 w-4 accent-[#4d90fe]" /> {t.lowercase}
    </label>
    <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 px-4 py-3 text-sm dark:border-white/10">
      <input type="checkbox" data-pw-opt="digits" checked class="h-4 w-4 accent-[#4d90fe]" /> {t.numbers}
    </label>
    <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 px-4 py-3 text-sm dark:border-white/10">
      <input type="checkbox" data-pw-opt="symbols" checked class="h-4 w-4 accent-[#4d90fe]" /> {t.symbols}
    </label>
    <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 px-4 py-3 text-sm dark:border-white/10 sm:col-span-2">
      <input type="checkbox" data-pw-ambiguous class="h-4 w-4 accent-[#4d90fe]" /> {t.excludeAmbiguous}
    </label>
  </div>

  <button
    type="button"
    data-pw-regen
    class="mt-7 w-full rounded-2xl bg-[#4d90fe] px-8 py-3.5 text-base font-semibold text-white transition-colors hover:bg-[#3b7de0]"
  >
    {t.generate}
  </button>

  <p class="mt-4 text-center text-xs leading-relaxed text-slate-500 dark:text-slate-400">{t.note}</p>
</div>

<script>
  const POOLS: Record<string, string> = {
    lower: 'abcdefghijklmnopqrstuvwxyz',
    upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
    digits: '0123456789',
    symbols: '!@#$%^&*()_+-=[]{};:,.<>?',
  };
  const AMBIGUOUS = /[Il1O0]/g;

  // Cryptographically secure random integer in [0, max) — rejection
  // sampling, so there is no modulo bias.
  function secureInt(max: number): number {
    const limit = Math.floor(0x100000000 / max) * max;
    const buf = new Uint32Array(1);
    let x = 0;
    do {
      crypto.getRandomValues(buf);
      x = buf[0];
    } while (x >= limit);
    return x % max;
  }

  document.querySelectorAll<HTMLElement>('[data-pwgen]').forEach((root) => {
    const labels = JSON.parse(root.dataset.labels || '{}');
    const out = root.querySelector<HTMLElement>('[data-pw-output]')!;
    const bar = root.querySelector<HTMLElement>('[data-pw-bar]')!;
    const strengthEl = root.querySelector<HTMLElement>('[data-pw-strength]')!;
    const bitsEl = root.querySelector<HTMLElement>('[data-pw-bits]')!;
    const lenInput = root.querySelector<HTMLInputElement>('[data-pw-length]')!;
    const lenVal = root.querySelector<HTMLElement>('[data-pw-lenval]')!;
    const ambInput = root.querySelector<HTMLInputElement>('[data-pw-ambiguous]')!;
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-pw-copy]')!;

    const selectedPools = (): string[] => {
      const pools: string[] = [];
      root.querySelectorAll<HTMLInputElement>('[data-pw-opt]').forEach((cb) => {
        if (cb.checked) {
          let pool = POOLS[cb.dataset.pwOpt!];
          if (ambInput.checked) pool = pool.replace(AMBIGUOUS, '');
          if (pool) pools.push(pool);
        }
      });
      if (pools.length === 0) {
        const lower = root.querySelector<HTMLInputElement>('[data-pw-opt="lower"]')!;
        lower.checked = true;
        pools.push(POOLS.lower);
      }
      return pools;
    };

    const generate = () => {
      const length = parseInt(lenInput.value, 10);
      lenVal.textContent = String(length);
      const pools = selectedPools();
      const all = pools.join('');
      const chars: string[] = [];
      // Guarantee at least one character from every selected pool.
      for (const pool of pools) chars.push(pool[secureInt(pool.length)]);
      while (chars.length < length) chars.push(all[secureInt(all.length)]);
      // Fisher–Yates shuffle with secure randomness.
      for (let i = chars.length - 1; i > 0; i--) {
        const j = secureInt(i + 1);
        [chars[i], chars[j]] = [chars[j], chars[i]];
      }
      const password = chars.slice(0, length).join('');
      out.textContent = password;

      const bits = Math.round(length * Math.log2(all.length));
      bitsEl.textContent = `${bits} ${labels.bits}`;
      let label = labels.weak;
      let color = '#ef4444';
      let pct = Math.min(100, (bits / 128) * 100);
      if (bits >= 80) { label = labels.excellent; color = '#4d90fe'; }
      else if (bits >= 60) { label = labels.strong; color = '#22c55e'; }
      else if (bits >= 40) { label = labels.fair; color = '#f59e0b'; }
      strengthEl.textContent = label;
      bar.style.width = `${Math.max(8, pct)}%`;
      bar.style.background = color;
    };

    let timer: ReturnType<typeof setTimeout> | undefined;
    const debounced = () => {
      clearTimeout(timer);
      timer = setTimeout(generate, 120);
    };

    lenInput.addEventListener('input', debounced);
    ambInput.addEventListener('change', generate);
    root.querySelectorAll<HTMLInputElement>('[data-pw-opt]').forEach((cb) =>
      cb.addEventListener('change', generate),
    );
    root.querySelectorAll('[data-pw-regen]').forEach((b) =>
      b.addEventListener('click', generate),
    );
    copyBtn.addEventListener('click', async () => {
      const text = out.textContent || '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const range = document.createRange();
        range.selectNodeContents(out);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        document.execCommand('copy');
        sel?.removeAllRanges();
      }
      const original = copyBtn.textContent;
      copyBtn.textContent = labels.copied;
      setTimeout(() => (copyBtn.textContent = original), 1600);
    });

    generate();
  });
</script>
