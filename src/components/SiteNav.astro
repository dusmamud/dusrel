---
import { dict, type Lang } from '../i18n';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Lang;
  /** Full path of this page in the *other* language, e.g. "/hi/about" on the EN page */
  altHref: string;
}

const { lang, altHref } = Astro.props;
const t = dict[lang];
const home = lang === 'en' ? '/' : '/hi/';
const lp = (enPath: string) => (lang === 'en' ? enPath : `/hi${enPath}`);

const links = [
  { href: lp('/apps'), label: t.nav.apps },
  { href: lp('/about'), label: t.nav.about },
  { href: lp('/open-source'), label: t.nav.openSource },
  { href: lp('/contact'), label: t.nav.contact },
];
---

<header class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/85 backdrop-blur-md dark:border-white/10 dark:bg-[#121212]/85">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6" aria-label="Main">
    <a href={home} class="flex items-center gap-2.5" aria-label="Dusrel home">
      <img src="/logo.svg" alt="" class="h-7 w-7" width="28" height="28" aria-hidden="true" />
      <span class="font-display text-xl font-bold text-slate-900 dark:text-white">Dusrel</span>
    </a>

    <div class="hidden items-center gap-7 md:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="text-sm font-medium text-slate-600 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"
          >
            {l.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2">
      <div class="flex items-center gap-1 text-sm">
        {
          lang === 'en' ? (
            <span class="font-semibold text-slate-900 dark:text-white">EN</span>
          ) : (
            <a href={altHref} class="text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">
              EN
            </a>
          )
        }
        <span aria-hidden="true" class="text-slate-300 dark:text-slate-700">|</span>
        {
          lang === 'hi' ? (
            <span class="font-semibold text-slate-900 dark:text-white">HI</span>
          ) : (
            <a href={altHref} class="text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">
              HI
            </a>
          )
        }
      </div>

      <ThemeToggle />

      <a
        href={lp('/apps')}
        class="ml-1 hidden rounded-xl bg-[#4d90fe] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[#3b7de0] sm:inline-block"
      >
        {t.nav.cta}
      </a>
    </div>
  </nav>
</header>
