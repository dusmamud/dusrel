---
import { dict, type Lang } from '../i18n';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Lang;
  /** Full path of this page in the *other* language, e.g. "/hi/about" on the EN page */
  altHref: string;
}

const { lang, altHref } = Astro.props;
const t = dict[lang];
const home = lang === 'en' ? '/' : '/hi/';
const lp = (enPath: string) => (lang === 'en' ? enPath : `/hi${enPath}`);

const links = [
  { href: lp('/apps'), label: t.nav.apps },
  { href: lp('/about'), label: t.nav.about },
  { href: lp('/open-source'), label: t.nav.openSource },
  { href: lp('/contact'), label: t.nav.contact },
];
---

<header class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/85 backdrop-blur-md dark:border-white/10 dark:bg-[#121212]/85">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6" aria-label="Main">
    <a href={home} class="flex items-center gap-2.5" aria-label="Dusrel home">
      <img src="/logo.svg" alt="" class="h-7 w-7" width="28" height="28" aria-hidden="true" />
      <span class="font-display text-xl font-bold text-slate-900 dark:text-white">Dusrel</span>
    </a>

    <div class="hidden items-center gap-7 md:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="text-sm font-medium text-slate-600 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"
          >
            {l.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2">
      <div class="flex items-center gap-1 text-sm">
        {
          lang === 'en' ? (
            <span class="font-semibold text-slate-900 dark:text-white">EN</span>
          ) : (
            <a href={altHref} class="text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">
              EN
            </a>
          )
        }
        <span aria-hidden="true" class="text-slate-300 dark:text-slate-700">|</span>
        {
          lang === 'hi' ? (
            <span class="font-semibold text-slate-900 dark:text-white">HI</span>
          ) : (
            <a href={altHref} class="text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white">
              HI
            </a>
          )
        }
      </div>

      <ThemeToggle />

      <a
        href={lp('/apps')}
        class="ml-1 hidden rounded-xl bg-[#4d90fe] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[#3b7de0] sm:inline-block"
      >
        {t.nav.cta}
      </a>

      <button
        id="sitenav-menu-btn"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        class="ml-1 flex h-9 w-9 items-center justify-center rounded-xl border border-slate-200 text-slate-600 md:hidden dark:border-white/10 dark:text-slate-300"
      >
        <svg id="sitenav-icon-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="sitenav-icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden h-5 w-5">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu : actual pages, not anchors -->
  <div id="sitenav-mobile-menu" class="hidden md:hidden">
    <nav class="flex flex-col gap-1 border-t border-slate-200/70 px-4 py-4 dark:border-white/10" aria-label="Mobile">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="sitenav-mobile-link rounded-xl px-3 py-2.5 text-[15px] font-medium text-slate-700 transition-colors hover:bg-slate-100 hover:text-[#4d90fe] dark:text-slate-200 dark:hover:bg-white/5"
          >
            {l.label}
          </a>
        ))
      }
      <a
        href={lp('/apps')}
        class="sitenav-mobile-link mt-2 rounded-xl bg-[#4d90fe] px-3 py-2.5 text-center text-[15px] font-semibold text-white"
      >
        {t.nav.cta}
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('sitenav-menu-btn');
    var menu = document.getElementById('sitenav-mobile-menu');
    if (!btn || !menu) return;
    var iconOpen = document.getElementById('sitenav-icon-open');
    var iconClose = document.getElementById('sitenav-icon-close');
    function setOpen(open) {
      menu.classList.toggle('hidden', !open);
      if (iconOpen) iconOpen.classList.toggle('hidden', open);
      if (iconClose) iconClose.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      // Lock background scroll while the menu is open (UX).
      document.body.style.overflow = open ? 'hidden' : '';
    }
    btn.addEventListener('click', function () {
      setOpen(menu.classList.contains('hidden'));
    });
    menu.querySelectorAll('.sitenav-mobile-link').forEach(function (a) {
      a.addEventListener('click', function () {
        setOpen(false);
      });
    });
  })();
</script>
