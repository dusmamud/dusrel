---
import { dict, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const t = dict[lang];

const check = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>`;
---

<section id="pricing" class="py-20 md:py-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto">
      <p>
        <span class="inline-block rounded-full border border-[#4d90fe]/40 bg-[#4d90fe]/5 px-4 py-1.5 text-[11px] font-semibold tracking-[0.18em] text-[#4d90fe]">
          {t.pricing.eyebrow}
        </span>
      </p>
      <h2 class="font-display mt-5 text-3xl md:text-4xl font-bold text-slate-900 dark:text-[#e8eaed]">
        {t.pricing.title}
      </h2>
      <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">{t.pricing.sub}</p>
    </div>

    <div class="mt-12 mx-auto max-w-lg rounded-3xl border border-slate-200 bg-white p-8 md:p-10 text-center shadow-sm dark:border-white/10 dark:bg-[#1e1e1e]">
      <p class="font-display text-5xl font-bold text-slate-900 dark:text-[#e8eaed]">
        {t.pricing.price}
      </p>
      <p class="mt-3 text-slate-600 dark:text-slate-400">{t.pricing.tagline}</p>
      <ul class="mt-8 space-y-3 text-left">
        {
          t.pricing.features.map((f) => (
            <li class="flex items-start gap-3 text-sm text-slate-700 dark:text-slate-300">
              <span class="mt-0.5 text-[#4d90fe]" set:html={check} />
              {f}
            </li>
          ))
        }
      </ul>
      <a
        href="#apps"
        class="mt-8 block w-full rounded-2xl bg-[#4d90fe] px-8 py-3.5 text-base font-semibold text-white transition-all hover:bg-[#3b7de0] hover:shadow-md"
      >
        {t.pricing.cta}
      </a>
      <p class="mt-6 text-xs leading-relaxed text-slate-500 dark:text-slate-500">{t.pricing.note}</p>
    </div>
  </div>
</section>
