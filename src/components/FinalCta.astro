---
import { dict, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const t = dict[lang];
---

<section class="mx-auto max-w-6xl px-6 py-20 md:py-24">
  <div class="relative overflow-hidden rounded-[20px]">
    <img
      src="/images/cta-banner.jpg"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-white/80 dark:bg-[#121212]/85"
    />
    <div class="relative px-6 py-16 text-center md:py-24">
      <h2 class="font-display mx-auto max-w-2xl text-3xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-[#e8eaed]">
        {t.cta.title}
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base md:text-lg text-slate-600 dark:text-slate-300">
        {t.cta.sub}
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
        <a
          href="#apps"
          class="w-full rounded-[10px] bg-[#4d90fe] px-8 py-3.5 text-base font-semibold text-white shadow-sm transition-colors hover:bg-[#3b7de0] sm:w-auto"
        >
          {t.cta.ctaApps}
        </a>
        <a
          href="#contact"
          class="w-full rounded-[10px] border border-slate-300 bg-white/80 px-8 py-3.5 text-base font-semibold text-slate-900 transition-colors hover:border-[#4d90fe] hover:text-[#4d90fe] sm:w-auto dark:border-white/20 dark:bg-white/10 dark:text-[#e8eaed]"
        >
          {t.cta.ctaContact}
        </a>
      </div>
    </div>
  </div>
</section>
