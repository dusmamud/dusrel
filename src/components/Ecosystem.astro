---
import { dict, type Lang } from '../i18n';
import { liveApps, soonApps, appIcon, appDetailHref, appContentFor } from '../data/apps';
const { lang } = Astro.props as { lang: Lang };
const t = dict[lang];

// Localized content by slug — no index matching, no duplicated arrays.
const content = (slug: string) => appContentFor(t.appContent, slug);
---

<section id="apps" class="mx-auto max-w-6xl px-6 py-20">
  <h2 class="font-display text-3xl md:text-4xl font-bold text-slate-900 dark:text-[#e8eaed]">
    {t.ecosystem.title}
  </h2>
  <p class="mt-3 text-slate-600 dark:text-slate-400">{t.ecosystem.sub}</p>

  <!-- Live now -->
  <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
    {
      liveApps.map((app) => (
        <article class="relative rounded-2xl border border-slate-200 bg-white p-6 transition hover:-translate-y-1 dark:border-white/10 dark:bg-[#1e1e1e]">
          <span class="absolute right-5 top-5 rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800 dark:bg-green-900/30 dark:text-green-300">
            {t.ecosystem.liveLabel}
          </span>
          <img
            src={appIcon(app.slug)}
            alt=""
            width="44"
            height="44"
            class="h-11 w-11"
            aria-hidden="true"
          />
          <h3 class="mt-4 font-semibold text-slate-900 dark:text-[#e8eaed]">{content(app.slug).name}</h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{content(app.slug).desc}</p>
          <a
            href={app.url}
            target="_blank"
            rel="noopener"
            class="mt-4 inline-block text-sm font-medium text-[#4d90fe] hover:underline"
          >
            {t.ecosystem.visit} &rarr;
          </a>
          <a
            href={appDetailHref(app.slug, lang)}
            class="mt-1.5 block text-sm text-slate-500 hover:text-[#4d90fe] dark:text-slate-400 dark:hover:text-[#4d90fe]"
          >
            {t.ecosystem.learnMore} &rarr;
          </a>
        </article>
      ))
    }
  </div>

  <!-- Coming soon -->
  <div class="mt-16">
    <p class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
      {t.ecosystem.soonLabel}
    </p>
    <div class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-4">
      {
        soonApps.map((app) => (
          <div class="flex items-center gap-3 rounded-2xl border border-dashed border-slate-300 p-4 opacity-80 dark:border-white/10">
            <span class="h-2 w-2 shrink-0 rounded-full bg-slate-400 dark:bg-slate-500" />
            <span class="text-sm font-medium text-slate-700 dark:text-slate-300">{content(app.slug).name}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
