---
import { dict, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const t = dict[lang];

const icons = [
  // Image Quill — image
  '<rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>',
  // Ricsline — music note
  '<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>',
  // ResumeForge — document
  '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>',
  // PDF Tools — file-text
  '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>',
];

const iconSvg = (inner: string) =>
  `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${inner}</svg>`;

// App detail page slugs, same order as t.ecosystem.apps
const slugs = ['image-quill', 'ricsline', 'resumeforge', 'pdf-tools'];
const appHref = (slug: string) => `${lang === 'hi' ? '/hi' : ''}/apps/${slug}`;
---

<section id="apps" class="mx-auto max-w-6xl px-6 py-20">
  <h2 class="font-display text-3xl md:text-4xl font-bold text-slate-900 dark:text-[#e8eaed]">
    {t.ecosystem.title}
  </h2>
  <p class="mt-3 text-slate-600 dark:text-slate-400">{t.ecosystem.sub}</p>

  <!-- Live now -->
  <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
    {
      t.ecosystem.apps.map((app, i) => (
        <article class="relative rounded-2xl border border-slate-200 bg-white p-6 transition hover:-translate-y-1 dark:border-white/10 dark:bg-[#1e1e1e]">
          <span class="absolute right-5 top-5 rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800 dark:bg-green-900/30 dark:text-green-300">
            {t.ecosystem.liveLabel}
          </span>
          <span
            class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#4d90fe]/10 text-[#4d90fe]"
            set:html={iconSvg(icons[i])}
          />
          <h3 class="mt-4 font-semibold text-slate-900 dark:text-[#e8eaed]">{app.name}</h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{app.desc}</p>
          <a
            href={app.url}
            target="_blank"
            rel="noopener"
            class="mt-4 inline-block text-sm font-medium text-[#4d90fe] hover:underline"
          >
            {t.ecosystem.visit} &rarr;
          </a>
          <a
            href={appHref(slugs[i])}
            class="mt-1.5 block text-sm text-slate-500 hover:text-[#4d90fe] dark:text-slate-400 dark:hover:text-[#4d90fe]"
          >
            {t.ecosystem.learnMore} &rarr;
          </a>
        </article>
      ))
    }
  </div>

  <!-- Coming soon -->
  <div class="mt-16">
    <p class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
      {t.ecosystem.soonLabel}
    </p>
    <div class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-4">
      {
        t.ecosystem.soon.map((name) => (
          <div class="flex items-center gap-3 rounded-2xl border border-dashed border-slate-300 p-4 opacity-80 dark:border-white/10">
            <span class="h-2 w-2 shrink-0 rounded-full bg-slate-400 dark:bg-slate-500" />
            <span class="text-sm font-medium text-slate-700 dark:text-slate-300">{name}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
