---
import { dict, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const t = dict[lang];

const icons = [
  // Web — globe
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.5 2.6 3.8 5.7 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z"/></svg>`,
  // Android — phone with bottom button
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M10.5 5h3"/><circle cx="12" cy="18.5" r="1" fill="currentColor" stroke="none"/></svg>`,
  // iOS — phone with notch
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M10 5.5h4"/></svg>`,
  // Browser extensions — puzzle piece (Tabler)
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><path d="M4 7h3a1 1 0 0 0 1-1V5a2 2 0 0 1 4 0v1a1 1 0 0 0 1 1h3a1 1 0 0 1 1 1v3a1 1 0 0 0-1 1h-1a2 2 0 0 1 0 4h1a1 1 0 0 0 1 1v3a1 1 0 0 1-1 1h-3a1 1 0 0 1-1-1v-1a2 2 0 0 1-4 0v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a2 2 0 0 1 0-4H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1z"/></svg>`,
];

const liveChip =
  'inline-flex items-center rounded-full bg-green-500/10 px-3 py-1 text-xs font-semibold text-green-700 dark:text-green-400';
const soonChip =
  'inline-flex items-center rounded-full bg-slate-500/10 px-3 py-1 text-xs font-semibold text-slate-500 dark:text-slate-400';
---

<section id="devices" class="py-20 md:py-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto">
      <p class="text-sm font-semibold tracking-widest uppercase text-[#4d90fe]">
        {t.devices.eyebrow}
      </p>
      <h2 class="font-display mt-3 text-3xl md:text-4xl font-bold text-slate-900 dark:text-[#e8eaed]">
        {t.devices.title}
      </h2>
      <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">{t.devices.sub}</p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 md:grid-cols-4">
      {
        t.devices.items.map((item, i) => (
          <div class="rounded-2xl border border-slate-200 dark:border-white/10 bg-white dark:bg-[#1e1e1e] p-6">
            <div class="w-11 h-11 rounded-xl bg-[#4d90fe]/10 text-[#4d90fe] flex items-center justify-center">
              <span set:html={icons[i % icons.length]} />
            </div>
            <h3 class="mt-4 font-semibold text-slate-900 dark:text-[#e8eaed]">{item.title}</h3>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{item.desc}</p>
            <div class="mt-4">
              <span class={i === 0 ? liveChip : soonChip}>
                {i === 0 ? t.devices.liveLabel : t.devices.soonLabel}
              </span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
