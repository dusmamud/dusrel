---
import { dict, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const t = dict[lang];

const icons = [
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>`,
];
---

<section id="how" class="py-20 md:py-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto">
      <p class="text-sm font-semibold tracking-widest uppercase text-[#4d90fe]">
        {t.how.eyebrow}
      </p>
      <h2 class="font-display mt-3 text-3xl md:text-4xl font-bold text-slate-900 dark:text-[#e8eaed]">
        {t.how.title}
      </h2>
      <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">{t.how.sub}</p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        t.how.steps.map((step, i) => (
          <div class="rounded-2xl border border-slate-200 dark:border-white/10 bg-white dark:bg-[#1e1e1e] p-6">
            <div class="flex items-center justify-between">
              <span class="font-display flex w-11 h-11 items-center justify-center rounded-full bg-[#4d90fe] text-lg font-bold text-white">
                {i + 1}
              </span>
              <span class="w-11 h-11 rounded-xl bg-[#4d90fe]/10 text-[#4d90fe] flex items-center justify-center">
                <span set:html={icons[i % icons.length]} />
              </span>
            </div>
            <h3 class="mt-5 font-semibold text-slate-900 dark:text-[#e8eaed]">{step.title}</h3>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{step.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
