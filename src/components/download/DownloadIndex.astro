---
/**
 * Shared template for /apps/<slug>/download (and /hi/apps/<slug>/download).
 * Pages are generated from src/data/downloads.ts via getStaticPaths —
 * add an entry there, no .astro file needed.
 */
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import Footer from '../../components/Footer.astro';
import {
  downloads,
  downloadsFor,
  platformMeta,
  pick,
  type Lang,
} from '../../data/downloads';
import { liveApps, appIcon, appContentFor } from '../../data/apps';
import { dict } from '../../i18n';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const dl = downloadsFor(slug);
if (!dl) return Astro.redirect('/404');
const app = liveApps.find((a) => a.slug === slug);
const t = dict[lang];
const appName = app ? appContentFor(t.appContent, slug).name : slug;
const lp = (p: string) => `${lang === 'hi' ? '/hi' : ''}${p}/`;

const title =
  lang === 'hi'
    ? `${appName} डाउनलोड करें | Dusrel`
    : `Download ${appName} | Dusrel`;
const description = pick(dl.tagline, lang);
const canonical = `https://dusrel.com${lp(`/apps/${slug}/download`)}`;
const abs = (p: string) => `https://dusrel.com${lp(p)}`;
// BreadcrumbList comes from Base.astro (derived from the canonical path).
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: title,
  itemListElement: dl.platforms.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${appName} for ${pick(platformMeta[p.platform].label, 'en')}`,
    url: abs(`/apps/${slug}/download/${p.platform}`),
  })),
};
const otherApps = downloads.filter((d) => d.slug !== slug);
const allFaqs = dl.platforms.flatMap((p) => p.faqs);
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allFaqs.map((f) => ({
    '@type': 'Question',
    name: pick(f.q, lang),
    acceptedAnswer: { '@type': 'Answer', text: pick(f.a, lang) },
  })),
};
---

<Base lang={lang} title={title} description={description} canonical={canonical} image={`/og-${slug}.png`}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>
  <SiteNav lang={lang} />
  <main class="mx-auto max-w-4xl px-4 pb-20 pt-10">
    <nav class="text-sm text-slate-500 dark:text-slate-400" aria-label="Breadcrumb">
      <a href={lp('/apps')} class="hover:text-[#4d90fe]">{lang === 'hi' ? 'ऐप्स' : 'Apps'}</a>
      <span class="mx-2">/</span>
      <a href={lp(`/apps/${slug}`)} class="hover:text-[#4d90fe]">{appName}</a>
      <span class="mx-2">/</span>
      <span class="text-slate-900 dark:text-white">{lang === 'hi' ? 'डाउनलोड' : 'Download'}</span>
    </nav>

    <div class="mt-8 text-center">
      {app && (
        <img src={appIcon(slug)} alt={`${appName} logo`} class="mx-auto h-20 w-20" />
      )}
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-900 dark:text-white md:text-5xl">
        {lang === 'hi' ? `${appName} डाउनलोड करें` : `Download ${appName}`}
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-400">
        {description}
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-2xl space-y-4 text-left leading-relaxed text-slate-600 dark:text-slate-300">
      {dl.intro.map((para) => <p>{pick(para, lang)}</p>)}
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2">
      {dl.platforms.map((p) => {
        const meta = platformMeta[p.platform];
        return (
          <a
            href={lp(`/apps/${slug}/download/${p.platform}`)}
            class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-[#4d90fe] hover:shadow-md dark:border-white/10 dark:bg-white/5"
          >
            <div class="flex items-center gap-4">
              <span class="text-[#4d90fe]" set:html={meta.glyph} />
              <div>
                <p class="text-lg font-semibold text-slate-900 dark:text-white">
                  {pick(meta.label, lang)}
                </p>
                <p class="text-sm text-slate-500 dark:text-slate-400">
                  v{p.version} · {p.fileSize} · {p.updated}
                </p>
              </div>
            </div>
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-400">{pick(p.os, lang)}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-[#4d90fe]">
              {lang === 'hi' ? 'डाउनलोड पेज खोलें' : 'Open download page'}
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
            </span>
          </a>
        );
      })}
    </div>

    <p class="mt-10 text-center text-sm text-slate-500 dark:text-slate-400">
      {lang === 'hi'
        ? 'सभी डाउनलोड मुफ्त हैं। कोई अकाउंट नहीं, कोई ट्रैकिंग नहीं।'
        : 'All downloads are free. No accounts, no tracking.'}
    </p>

    {allFaqs.length > 0 && (
      <section class="mx-auto mt-16 max-w-3xl">
        <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
          {lang === 'hi' ? 'अक्सर पूछे जाने वाले सवाल' : 'Frequently asked questions'}
        </h2>
        <div class="mt-6 space-y-3 text-left">
          {allFaqs.map((f) => (
            <details class="group rounded-2xl border border-slate-200 bg-white px-5 py-4 dark:border-white/10 dark:bg-white/5">
              <summary class="cursor-pointer list-none font-semibold text-slate-900 marker:hidden dark:text-white [&::-webkit-details-marker]:hidden">
                <span class="flex items-center justify-between gap-4">
                  {pick(f.q, lang)}
                  <span aria-hidden="true" class="text-[#4d90fe] transition-transform group-open:rotate-45">+</span>
                </span>
              </summary>
              <p class="mt-3 leading-relaxed text-slate-600 dark:text-slate-300">{pick(f.a, lang)}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    {otherApps.length > 0 && (
      <section class="mt-16">
        <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
          {lang === 'hi' ? 'Dusrel के और डाउनलोड' : 'More downloads from Dusrel'}
        </h2>
        <div class="mt-6 grid gap-5 sm:grid-cols-2">
          {otherApps.map((o) => {
            const oName = appContentFor(t.appContent, o.slug).name;
            return (
              <a
                href={lp(`/apps/${o.slug}/download`)}
                class="group flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-[#4d90fe] hover:shadow-md dark:border-white/10 dark:bg-white/5"
              >
                <img src={appIcon(o.slug)} alt={`${oName} logo`} class="h-12 w-12" />
                <div>
                  <p class="font-semibold text-slate-900 dark:text-white">
                    {lang === 'hi' ? `${oName} डाउनलोड करें` : `Download ${oName}`}
                  </p>
                  <p class="text-sm text-slate-500 dark:text-slate-400">{pick(o.tagline, lang)}</p>
                </div>
                <span aria-hidden="true" class="ml-auto text-[#4d90fe] transition-transform group-hover:translate-x-0.5">→</span>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </main>
  <Footer lang={lang} />
</Base>
