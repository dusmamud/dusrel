---
import { dict, type Lang } from '../i18n';
import { liveApps, appDetailHref, appContentFor } from '../data/apps';
import { downloads, platformMeta, pick } from '../data/downloads';
import { socials, socialSvg } from '../data/social';
const { lang } = Astro.props as { lang: Lang };
const t = dict[lang];

const root = lang === 'en' ? '' : '/hi';
const page = (path: string) => `${root}${path}`;
const anchor = (hash: string) => `${root === '' ? '/' : root}${hash}`;

const companyLinks = [
  { label: t.nav.about, href: page('/about') },
  { label: t.nav.openSource, href: page('/open-source') },
  { label: t.footNav.changelog, href: page('/changelog') },
  { label: t.footNav.brand, href: page('/brand') },
  { label: t.nav.contact, href: page('/contact') },
];

const legalLinks = [
  { label: t.footNav.privacyPolicy, href: page('/privacy-policy') },
  { label: t.footNav.terms, href: page('/terms') },
  { label: t.footNav.security, href: page('/security') },
];

const appLinks = liveApps.map((app) => ({
  label: appContentFor(t.appContent, app.slug).name,
  href: appDetailHref(app.slug, lang),
}));

// Downloads column — derived from src/data/downloads.ts, so a new download
// page appears in the footer automatically.
const downloadLinks = downloads.flatMap((d) => {
  const name = appContentFor(t.appContent, d.slug).name;
  return [
    {
      label: lang === 'hi' ? `${name} डाउनलोड करें` : `Download ${name}`,
      href: `${root}/apps/${d.slug}/download/`,
    },
    ...d.platforms.map((p) => ({
      label: `${name} — ${pick(platformMeta[p.platform].label, lang)}`,
      href: `${root}/apps/${d.slug}/download/${p.platform}/`,
    })),
  ];
});

const anchorLinks = [
  { label: t.nav.apps, href: anchor('#apps') },
  { label: t.nav.why, href: anchor('#why') },
  { label: t.nav.privacy, href: anchor('#privacy') },
  { label: t.nav.faq, href: anchor('#faq') },
];

const linkCls = 'hover:text-slate-900 dark:hover:text-white';
---

<footer
  id="contact"
  class="border-t border-slate-200 bg-slate-50 py-12 text-slate-600 dark:border-white/10 dark:bg-black/40 dark:text-slate-400"
>
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid grid-cols-2 gap-10 lg:grid-cols-[1.5fr_1fr_1fr_1fr_1fr]">
      <div class="col-span-2 lg:col-span-1">
        <p class="flex items-center gap-2.5">
          <img src="/logo.svg" alt="Dusrel logo" class="h-7 w-7" width="28" height="28" />
          <span class="font-display text-2xl font-bold text-slate-900 dark:text-white">Dusrel</span>
        </p>
        <p class="mt-2 text-sm">{t.footer.tagline}</p>
        <a
          href="mailto:hello@dusrel.com"
          class="mt-4 inline-block text-sm font-medium text-[#4d90fe] hover:underline"
        >
          hello@dusrel.com
        </a>
        <div class="mt-4 flex items-center gap-2 text-sm">
          {
            lang === 'en' ? (
              <span class="font-semibold text-slate-900 dark:text-white">EN</span>
            ) : (
              <a href="/" class={linkCls}>
                EN
              </a>
            )
          }
          <span aria-hidden="true" class="text-slate-300 dark:text-slate-700">
            |
          </span>
          {
            lang === 'hi' ? (
              <span class="font-semibold text-slate-900 dark:text-white">HI</span>
            ) : (
              <a href="/hi/" class={linkCls}>
                HI
              </a>
            )
          }
        </div>
      </div>

      <nav aria-label={t.footNav.company}>
        <h3 class="text-sm font-semibold text-slate-900 dark:text-white">{t.footNav.company}</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            companyLinks.map((l) => (
              <li>
                <a href={l.href} class={linkCls}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label={t.footNav.legal}>
        <h3 class="text-sm font-semibold text-slate-900 dark:text-white">{t.footNav.legal}</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            legalLinks.map((l) => (
              <li>
                <a href={l.href} class={linkCls}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label={t.footNav.apps}>
        <h3 class="text-sm font-semibold text-slate-900 dark:text-white">
          <a href={page('/apps')} class={linkCls}>{t.footNav.apps}</a>
        </h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            appLinks.map((l) => (
              <li>
                <a href={l.href} class={linkCls}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {downloadLinks.length > 0 && (
        <nav aria-label={t.footNav.downloads}>
          <h3 class="text-sm font-semibold text-slate-900 dark:text-white">{t.footNav.downloads}</h3>
          <ul class="mt-4 space-y-2.5 text-sm">
            {
              downloadLinks.map((l) => (
                <li>
                  <a href={l.href} class={linkCls}>
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      )}
    </div>

    <nav
      aria-label={t.nav.apps}
      class="mt-10 flex flex-wrap gap-x-6 gap-y-2 border-t border-slate-200 pt-6 text-sm dark:border-white/10"
    >
      {
        anchorLinks.map((l) => (
          <a href={l.href} class={linkCls}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="mt-6 border-t border-slate-200 pt-6 dark:border-white/10">
      <p class="text-sm font-semibold text-slate-900 dark:text-white">{t.footer.follow}</p>
      <div class="mt-3 flex flex-wrap gap-2.5">
        {
          socials.map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener"
              aria-label={s.name}
              title={s.name}
              class="flex h-9 w-9 items-center justify-center rounded-xl border border-slate-200 text-slate-500 transition hover:-translate-y-0.5 hover:border-[#4d90fe]/50 hover:text-[#4d90fe] dark:border-white/10 dark:text-slate-400 dark:hover:text-[#4d90fe]"
              set:html={socialSvg(s.icon)}
            >
            </a>
          ))
        }
      </div>
    </div>

    <div class="mt-6 flex flex-col gap-2 border-t border-slate-200 pt-6 text-xs sm:flex-row sm:items-center sm:justify-between dark:border-white/10">
      <p>{t.footer.rights}</p>
      <p class="tracking-widest text-slate-400 dark:text-slate-600">YOUR PRIVACY MATTERS</p>
    </div>
  </div>
</footer>
