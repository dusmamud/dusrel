---
import { dict, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const t = dict[lang];
---

<footer
  id="contact"
  class="border-t border-slate-200 bg-slate-50 py-12 text-slate-600 dark:border-white/10 dark:bg-black/40 dark:text-slate-400"
>
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex flex-col gap-8">
      <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
        <div>
          <p class="flex items-center gap-2.5">
            <img src="/logo.svg" alt="Dusrel logo" class="h-7 w-7" width="28" height="28" />
            <span class="font-display text-2xl font-bold text-slate-900 dark:text-white">Dusrel</span>
          </p>
          <p class="mt-2 text-sm">{t.footer.tagline}</p>
        </div>

        <div class="flex flex-col gap-5 md:items-end">
          <a
            href="mailto:hello@dusrel.com"
            class="text-sm font-medium text-[#4d90fe] hover:underline"
          >
            hello@dusrel.com
          </a>

          <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm md:justify-end">
            <a href="#apps" class="hover:text-slate-900 dark:hover:text-white">{t.nav.apps}</a>
            <a href="#why" class="hover:text-slate-900 dark:hover:text-white">{t.nav.why}</a>
            <a href="#privacy" class="hover:text-slate-900 dark:hover:text-white">{t.nav.privacy}</a>
          </nav>

          <div class="flex items-center gap-2 text-sm">
            {
              lang === 'en' ? (
                <span class="font-semibold text-slate-900 dark:text-white">EN</span>
              ) : (
                <a href="/" class="hover:text-slate-900 dark:hover:text-white">
                  EN
                </a>
              )
            }
            <span aria-hidden="true" class="text-slate-300 dark:text-slate-700">
              |
            </span>
            {
              lang === 'hi' ? (
                <span class="font-semibold text-slate-900 dark:text-white">HI</span>
              ) : (
                <a href="/hi/" class="hover:text-slate-900 dark:hover:text-white">
                  HI
                </a>
              )
            }
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-2 border-t border-slate-200 pt-6 text-xs sm:flex-row sm:items-center sm:justify-between dark:border-white/10">
        <p>{t.footer.rights}</p>
        <p class="tracking-widest text-slate-400 dark:text-slate-600">YOUR PRIVACY MATTERS</p>
      </div>
    </div>
  </div>
</footer>
