---
import '../styles/global.css';
import { dict, type Lang } from '../i18n';
import { socials } from '../data/social';
import { liveApps, appContentFor } from '../data/apps';
import { platformMeta } from '../data/downloads';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  canonical?: string;
  /** OG/Twitter share image path, e.g. '/og-shrinkit.png'. Defaults to the site card. */
  image?: string;
  noindex?: boolean;
}

const { lang, title: titleOverride, description: descriptionOverride, canonical: canonicalOverride, image: imagePath, noindex = false } = Astro.props;
const t = dict[lang];
const title = titleOverride ?? t.meta.title;
const description = descriptionOverride ?? t.meta.description;
const canonicalRaw = canonicalOverride ?? (lang === 'en' ? 'https://dusrel.com/' : `https://dusrel.com/${lang}/`);
// Cloudflare Pages 308-redirects no-slash URLs to the trailing-slash form and
// the sitemap lists trailing-slash URLs — so canonical/og/hreflang must ALL use
// the trailing-slash form, otherwise Google sees a canonical loop and treats
// pages as "alternate" instead of indexing them.
const withSlash = (u: string) => (u.endsWith('/') ? u : `${u}/`);
const canonical = withSlash(canonicalRaw);
const ogImage = `https://dusrel.com${imagePath ?? '/og-default.png'}`;
const altLang = lang === 'en' ? 'hi' : 'en';
// Derive the alternate-locale URL from the canonical: insert or strip the /hi/ prefix.
const altHref =
  lang === 'en'
    ? canonical.replace('https://dusrel.com/', 'https://dusrel.com/hi/')
    : canonical.replace('https://dusrel.com/hi/', 'https://dusrel.com/');
// x-default always points at the English version of THIS page.
const xDefault = lang === 'en' ? canonical : altHref;

// ---- Structured data, generated centrally so EVERY page carries it ----
// Organization (with sameAs from src/data/social.ts), WebSite on the
// homepage, and a BreadcrumbList derived from the canonical path —
// no per-page wiring needed anywhere.
const homeUrl = lang === 'en' ? 'https://dusrel.com/' : 'https://dusrel.com/hi/';
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Dusrel',
  url: 'https://dusrel.com/',
  logo: 'https://dusrel.com/logo.png',
  slogan: 'YOUR PRIVACY MATTERS',
  description: 'Dusrel crafts free apps that truly respect your privacy.',
  sameAs: socials.map((s) => s.url),
};
const pathSegments = canonical
  .replace('https://dusrel.com/', '')
  .replace(/\/$/, '')
  .split('/')
  .filter(Boolean)
  .filter((seg, i) => !(i === 0 && seg === 'hi'));
const staticLabels: Record<string, { en: string; hi: string }> = {
  apps: { en: 'Apps', hi: 'ऐप्स' },
  about: { en: 'About', hi: 'हमारे बारे में' },
  brand: { en: 'Brand', hi: 'ब्रांड' },
  changelog: { en: 'Changelog', hi: 'बदलाव' },
  contact: { en: 'Contact', hi: 'संपर्क करें' },
  'open-source': { en: 'Open Source', hi: 'ओपन सोर्स' },
  'privacy-policy': { en: 'Privacy Policy', hi: 'गोपनीयता नीति' },
  security: { en: 'Security', hi: 'सुरक्षा' },
  terms: { en: 'Terms', hi: 'शर्तें' },
  download: { en: 'Download', hi: 'डाउनलोड' },
  pass: { en: 'Tools', hi: 'टूल्स' },
  'password-generator': { en: 'Password Generator', hi: 'पासवर्ड जेनरेटर' },
  'username-generator': { en: 'Username Generator', hi: 'यूज़रनेम जेनरेटर' },
  'word-counter': { en: 'Word Counter', hi: 'वर्ड काउंटर' },
  'qr-code-generator': { en: 'QR Code Generator', hi: 'QR कोड जेनरेटर' },
  'age-calculator': { en: 'Age Calculator', hi: 'आयु कैलकुलेटर' },
  'password-strength-checker': { en: 'Password Strength Checker', hi: 'पासवर्ड स्ट्रेंथ चेकर' },
};
const segName = (seg: string): string => {
  if (liveApps.some((a) => a.slug === seg))
    return appContentFor(t.appContent, seg).name;
  const pm = (platformMeta as Record<string, { label: { en: string; hi: string } }>)[seg];
  if (pm) return pm.label[lang];
  const st = staticLabels[seg];
  if (st) return st[lang];
  return seg;
};
const breadcrumbLd =
  !noindex && pathSegments.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: lang === 'hi' ? 'होम' : 'Home', item: homeUrl },
          ...pathSegments.map((seg, i) => ({
            '@type': 'ListItem',
            position: i + 2,
            name: segName(seg),
            item: `${homeUrl}${pathSegments.slice(0, i + 1).join('/')}/`,
          })),
        ],
      }
    : null;
const websiteLd =
  !noindex && pathSegments.length === 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'Dusrel',
        url: homeUrl,
        inLanguage: lang === 'hi' ? 'hi-IN' : 'en-US',
        publisher: { '@type': 'Organization', name: 'Dusrel', url: 'https://dusrel.com/' },
        potentialAction: {
          '@type': 'SearchAction',
          target: {
            '@type': 'EntryPoint',
            urlTemplate: 'https://dusrel.com/search/?q={search_term_string}',
          },
          'query-input': 'required name=search_term_string',
        },
      }
    : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#4d90fe" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="search" type="application/opensearchdescription+xml" title="Dusrel Search" href="/opensearch.xml" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" data-theme-color />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121212" data-theme-color />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('dusrel-theme') || 'system';
          var dark =
            t === 'dark' ||
            (t === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          var resolved = dark ? 'dark' : 'light';
          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.style.colorScheme = resolved;
          var color = dark ? '#121212' : '#ffffff';
          document.querySelectorAll('meta[data-theme-color]').forEach(function (meta) {
            meta.setAttribute('content', color);
          });
        } catch (e) {}
      })();
    </script>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={altLang} href={altHref} />
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dusrel" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'hi_IN'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'hi_IN' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    {websiteLd && <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />}
    {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
    <slot name="head" />
  </head>
  <body class="bg-white text-slate-900 dark:bg-[#121212] dark:text-[#e8eaed]">
    <slot />
    <script is:inline>
      // Scroll ownership: stop the browser from ever auto-restoring a
      // mid-page scroll position (Chrome session restore / reload / back).
      // Fresh loads always start at the top; deep-link hashes (/#faq shared
      // or typed) keep working natively.
      (function () {
        if ('scrollRestoration' in history) {
          history.scrollRestoration = 'manual';
        }
        var hash = window.location.hash;
        if (!hash || hash.length < 2 || !document.getElementById(hash.slice(1))) {
          window.scrollTo(0, 0);
        }
      })();

      // Scoped smooth scrolling for in-page anchor links only.
      // Wheel, trackpad and keyboard scrolling stay native 1:1 (instant);
      // only anchor jumps animate — and instantly when the user prefers
      // reduced motion.
      (function () {
        var reduceMotion =
          window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.addEventListener('click', function (e) {
          var el = e.target && e.target.closest ? e.target.closest('a[href]') : null;
          if (!el) return;
          var hash = el.hash;
          if (!hash || hash.length < 2) return;
          var url;
          try {
            url = new URL(el.href, window.location.href);
          } catch (err) {
            return;
          }
          if (url.pathname !== window.location.pathname) return;
          var target = document.getElementById(hash.slice(1));
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({
            behavior: reduceMotion ? 'auto' : 'smooth',
            block: 'start',
          });
          // NOTE: no history.replaceState here on purpose — writing the hash
          // into the URL makes Chrome reopen the page mid-scroll on session
          // restore. Shared/typed deep links (/#faq) still work natively.
        });
      })();
    </script>
  </body>
</html>
